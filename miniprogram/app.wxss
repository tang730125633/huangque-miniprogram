/* 黄雀设计系统 · 暖纸创作室 */
page {
  --bg: #f2e8d7;
  --surface: rgba(255,253,247,.72);
  --surface-muted: #ebe1cf;
  --text: #29271f;
  --text-muted: #756b58;
  --line: #d5c7ad;
  --primary: #876b3f;          /* 主色·暖棕 */
  --primary-soft: #e9ddc5;
  --primary-ink: #72572e;
  --secondary: #876b3f;        /* 点数·暖橙 */
  --accent: #536f65;
  --success: #416b50;
  --warning: #90662e;
  --error: #a34235;
  --grad: #30352b;
  --grad-blue: #536f65;

  /* TDesign 主题 token → 对齐暖纸主题 */
  --td-brand-color: var(--primary);
  --td-brand-color-light: var(--primary);
  --td-brand-color-active: var(--primary);
  --td-brand-color-focus: var(--primary);
  --td-error-color: var(--error);
  --td-success-color: var(--success);
  --td-bg-color-page: var(--bg);
  --td-text-color-primary: var(--text);
  --td-text-color-secondary: var(--text-muted);
  --td-text-color-placeholder: var(--text-muted);
  --td-radius-default: 12rpx;

  background-color: var(--bg);
  background-image: url("data:image/svg+xml;base64,"), radial-gradient(ellipse at 12% 12%, #faf4e7, transparent 70%);
  background-size: 180px 180px, 100% 100%;
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.container { padding: 32rpx; }
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.label { font-size: 27rpx; font-weight: 600; margin-bottom: 18rpx; color: var(--text); }
.muted { color: var(--text-muted); }
.small { font-size: 22rpx; }

.btn-primary {
  background: var(--grad);
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  padding: 26rpx;
  font-weight: 600;
  font-size: 30rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.btn-primary.disabled { opacity: 0.55; }

/* 图标通用尺寸 */
.ic { width: 34rpx; height: 34rpx; vertical-align: middle; flex: none; }
.ic-btn { width: 36rpx; height: 36rpx; }
.ic-coin { width: 36rpx; height: 36rpx; margin-right: 10rpx; }

.chip {
  padding: 20rpx 8rpx;
  text-align: center;
  border-radius: 14rpx;
  color: var(--text-muted);
  background: var(--surface-muted);
  border: 1rpx solid var(--line);
  font-size: 25rpx;
}
.chip.active {
  color: var(--primary-ink);
  background: var(--primary-soft);
  border-color: var(--primary);
}

/* Warm paper is the main application theme, including shared forms and dialogs. */
.container .btn-primary { width:100%; box-sizing:border-box; background:var(--grad); color:#fff8e8; }
.page-heading { margin:12rpx 0 32rpx; }
.page-eyebrow { color:var(--primary); font-size:20rpx; letter-spacing:3rpx; }
.page-heading-title { margin-top:12rpx; color:var(--text); font-family:"Songti SC","STSong",serif; font-size:44rpx; line-height:1.3; }
.page-heading-copy { margin-top:12rpx; color:var(--text-muted); font-size:24rpx; line-height:1.7; }
