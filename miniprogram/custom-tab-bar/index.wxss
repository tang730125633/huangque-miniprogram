.tab-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 104rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #252030;
  background: #100c18;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #948da8;
  font-size: 20rpx;
}

.tab-item.active { color: #e24ba0; }
.tab-icon-symbol { height: 42rpx; margin-bottom: 4rpx; font-size: 34rpx; line-height: 42rpx; }
.tab-label { line-height: 28rpx; }
