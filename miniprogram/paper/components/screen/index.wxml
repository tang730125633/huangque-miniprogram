<image class="hq-image paper-texture" src="/paper/assets/paper.png" mode="aspectFill" aria-hidden="true" />
<view class="hq-view app-shell">
  <view class="hq-view nav" style="padding-top:{{statusTop}}px;"><view class="hq-view nav-inner" style="height:{{navHeight}}px;padding-right:{{safeRight}}px;">
    <block wx:if="{{pageId==='home'||pageId==='works'||pageId==='profile'}}"><view class="hq-view brand-seal">雀</view><text class="hq-text brand-name">黄雀</text><text class="hq-text nav-caption">{{title}}</text></block>
    <block wx:else><button class="hq-button back" bindtap="back" aria-label="返回上一页">‹</button><text class="hq-text nav-title">{{title}}</text></block>
  </view></view>
  <view class="hq-view content {{pageId==='home'||pageId==='works'||pageId==='profile'?'has-tabs':''}}">
    <view wx:if="{{error}}" class="hq-view error-banner" role="alert"><text class="hq-text">{{error}}</text><button class="hq-button text-button" bindtap="load">重新加载</button></view>
    <view wx:if="{{loading}}" class="hq-view loading-note">正在读取你的创作空间…</view>
    <view wx:if="{{!user&&pageId!=='login'}}" class="hq-view guest-strip"><text class="hq-text">登录后查看你的作品与积分</text><button class="hq-button text-button" data-route="login" bindtap="go">登录 ›</button></view>

    <block wx:if="{{pageId==='home'}}">
      <view class="hq-view eyebrow">让想法，在这里生长</view><view class="hq-view greeting">你好，{{user.display_name||'创作者'}}</view><view class="hq-view hero-title">今天想做点什么？</view>
      <view class="hq-view composer"><view class="hq-view filter-row"><button wx:for="{{formats}}" wx:key="id" class="hq-button filter {{kind===item.id?'active':''}}" data-kind="{{item.id}}" bindtap="chooseKind">{{item.name}}</button></view><textarea class="hq-textarea" value="{{promptInput}}" placeholder="告诉黄雀，你想做的内容…" maxlength="1000" data-field="promptInput" bindinput="field" aria-label="创作需求"/><view class="hq-view composer-foot"><text class="hq-text muted small">从一个想法开始</text><button class="hq-button send" bindtap="startChat" aria-label="整理创作需求">↗</button></view></view>
      <view class="hq-view section-head"><view class="hq-view section-title">最近创作</view><button class="hq-button text-button" data-route="works" bindtap="go">查看全部 ›</button></view>
      <button wx:for="{{works}}" wx:key="id" wx:if="{{index<3}}" class="hq-button recent" data-id="{{item.id}}" bindtap="openWork"><image class="hq-image" wx:if="{{item.kind==='image'&&item.url}}" src="{{item.displayUrl||item.url}}" mode="aspectFill"/><view wx:else class="hq-view text-thumb">{{item.kind==='audio'?'声':item.kind==='video'?'影':'文'}}</view><view class="hq-view recent-info"><view class="hq-view truncate">{{item.title}}</view><text class="hq-text muted small">{{item.label}}</text></view><text class="hq-text">›</text></button>
      <view wx:if="{{!works.length&&!loading}}" class="hq-view empty-state"><view class="hq-view empty-symbol">✦</view><view class="hq-view">第一件作品，从这里开始。</view><text class="hq-text muted small">描述想法，确认后再创作。</text></view>
      <view wx:if="{{attempt.status==='unknown'||attempt.status==='submitting'}}" class="hq-view card"><view class="hq-view">上次提交的结果待确认</view><button class="hq-button secondary" bindtap="recover" loading="{{busy}}" disabled="{{busy}}">恢复上次提交</button></view><button class="hq-button secondary" data-legacy="home" bindtap="openLegacy">更多创作工具</button><view class="hq-view bottom-quote">灵感不必完整，我们一起把它做好。</view>
    </block>

    <block wx:elif="{{pageId==='login'}}">
      <view class="hq-view login-mark">雀</view><view class="hq-view eyebrow center">WELCOME TO HUANGQUE</view><view class="hq-view hero-title">让每一个想法<view class="hq-view"/>都有落下的地方。</view><view class="hq-view intro muted">使用已有黄雀账号，继续你的创作。</view>
      <label class="field"><text class="hq-text">账号</text><input class="hq-input" value="{{username}}" data-field="username" bindinput="field" maxlength="128" placeholder="请输入黄雀账号" aria-label="账号"/></label>
      <label class="field"><text class="hq-text">密码</text><input class="hq-input" password value="{{password}}" data-field="password" bindinput="field" maxlength="256" placeholder="请输入密码" aria-label="密码"/></label>
      <checkbox-group bindchange="consentChange"><label class="consent"><checkbox class="hq-checkbox" value="agree" checked="{{consent}}" color="#92703a"/><text class="hq-text">我同意在此设备保存登录凭证</text></label></checkbox-group><button class="hq-button text-button" data-info="login" bindtap="info">查看登录与隐私说明</button>
      <button class="hq-button primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">登录黄雀</button><button class="hq-button secondary" data-route="home" bindtap="go">先看看首页</button><view class="hq-view note">使用黄雀账号密码登录；微信一键登录尚未接入此版本。</view>
    </block>

    <block wx:elif="{{pageId==='chat'}}">
      <view class="hq-view agent-status"><view class="hq-view status-dot"/><text class="hq-text">黄雀 Agent 在线</text><text class="hq-text agent-mode">创作规划</text></view>
      <view class="hq-view agent-thread">
        <view class="hq-view agent-message">
          <view class="hq-view agent-avatar">雀</view>
          <view class="hq-view message-stack"><view class="hq-view message-meta">黄雀 Agent</view><view class="hq-view agent-bubble">把你想做的内容告诉我。我会先理解目标、补齐关键细节，再给你一份可确认的创作方案。</view></view>
        </view>
        <view wx:if="{{promptInput}}" class="hq-view user-message"><view class="hq-view message-meta user-meta">你</view><view class="hq-view user-bubble preserve">{{promptInput}}</view></view>
        <view class="hq-view agent-message plan-message">
          <view class="hq-view agent-avatar small-avatar">✦</view>
          <view class="hq-view message-stack">
            <view class="hq-view message-meta">当前上下文</view>
            <view class="hq-view agent-plan-card">
              <view class="hq-view plan-card-head"><view class="hq-view plan-kind">{{kindName}}</view><text class="hq-text plan-ready">已识别</text></view>
              <view class="hq-view plan-detail">{{formatDetail}}</view>
              <view wx:if="{{kind==='audio'}}" class="hq-view plan-note">输入内容将直接作为配音文稿。</view>
              <view class="hq-view plan-safe">下一步先查看实时报价，你确认前不会创建付费任务。</view>
            </view>
          </view>
        </view>
      </view>

      <view class="hq-view agent-composer">
        <view class="hq-view agent-format-row"><text class="hq-text composer-label">我想做</text><view class="hq-view filter-row"><button wx:for="{{formats}}" wx:key="id" class="hq-button filter {{kind===item.id?'active':''}}" data-kind="{{item.id}}" bindtap="chooseKind">{{item.name}}</button></view></view>
        <textarea class="hq-textarea" value="{{promptInput}}" placeholder="继续补充用途、主体、风格或需要调整的地方…" maxlength="1000" data-field="promptInput" bindinput="field" aria-label="向黄雀 Agent 发送创作需求"/>
        <view class="hq-view composer-foot"><button class="hq-button attachment-button" bindtap="chooseReference">＋ 参考图</button><text class="hq-text muted small">{{promptInput.length}} / 1000</text></view>
      </view>
      <view wx:if="{{referencePath}}" class="hq-view reference-card agent-reference"><image class="hq-image" src="{{referencePath}}" mode="aspectFill"/><view class="hq-view flex-grow"><view class="hq-view">已加入参考图</view><text class="hq-text muted small">Agent 将结合这张图理解需求</text></view><button class="hq-button text-button" bindtap="removeReference">移除</button></view>
      <picker wx:if="{{kind==='audio'}}" range="{{voices}}" range-key="name" bindchange="chooseVoice"><view class="hq-view field picker-field">音色：{{voiceName||'请选择音色'}}　⌄</view></picker>
      <button class="hq-button primary agent-primary" bindtap="confirmPlan" disabled="{{busy}}">让 Agent 整理方案 →</button><button class="hq-button agent-save" bindtap="sendPrompt">保存这次对话草稿</button>
    </block>

    <block wx:elif="{{pageId==='confirm'}}">
      <view class="hq-view eyebrow">BEFORE WE BEGIN</view><view class="hq-view hero-title">开始之前<view class="hq-view"/>把细节确认好。</view><view class="hq-view card"><view class="hq-view section-title">{{kindName}}创作</view><view class="hq-view body-copy preserve">{{promptInput}}</view></view>
      <view class="hq-view metadata"><view class="hq-view"><text class="hq-text muted">交付内容</text><text class="hq-text">{{formatDetail}}</text></view><view class="hq-view"><text class="hq-text muted">可用积分</text><text class="hq-text">{{quote?quote.balance:'读取中'}}</text></view><view class="hq-view"><text class="hq-text muted">预计使用</text><text class="hq-text gold">{{quote?quote.cost:'—'}} 积分</text></view></view>
      <view class="hq-view note">点击确认将向服务器提交真实任务并使用积分。失败后的退回状态以任务和账单为准。</view>
      <block wx:if="{{attempt.status==='unknown'||attempt.status==='submitting'}}"><view class="hq-view error-banner">上次提交结果尚未确认，请先恢复。</view><button class="hq-button primary" bindtap="recover" loading="{{busy}}" disabled="{{busy}}">恢复上次提交</button></block>
      <button wx:else class="hq-button primary" bindtap="startGeneration" loading="{{busy}}" disabled="{{busy||!quote||quote.balance<quote.cost}}">{{quote&&quote.balance<quote.cost?'积分不足':'确认方案，开始创作'}}</button>
      <button class="hq-button secondary" data-route="chat" bindtap="go" disabled="{{busy}}">返回调整需求</button>
    </block>

    <block wx:elif="{{pageId==='processing'||pageId==='failed'}}">
      <view class="hq-view eyebrow">YOUR CREATION</view><view class="hq-view hero-title">{{job.failed?'这次，稍作停顿。':job.done?'你的作品，做好了。':'灵感，正在成形。'}}</view><view class="hq-view process-orbit"><view class="hq-view">{{job.failed?'!':job.done?'✓':'雀'}}</view></view>
      <view class="hq-view center section-title">{{job.label||'正在查询任务'}}</view><view class="hq-view body-copy center">{{job.error}}</view><view class="hq-view metadata"><view class="hq-view"><text class="hq-text">任务编号</text><text class="hq-text">{{job.id||'—'}}</text></view><view class="hq-view"><text class="hq-text">使用积分</text><text class="hq-text">{{job.cost===undefined?'—':job.cost}}</text></view><view class="hq-view" wx:if="{{job.failed}}"><text class="hq-text">退回状态</text><text class="hq-text">{{job.refunded?'已退回':'尚未确认退回'}}</text></view></view>
      <button wx:if="{{job.done}}" class="hq-button primary" bindtap="viewResult">查看作品</button><button wx:elif="{{job.failed}}" class="hq-button primary" bindtap="retry">重新确认方案</button><button class="hq-button secondary" bindtap="refreshTask" disabled="{{busy}}">刷新任务状态</button><button class="hq-button text-button" data-route="works" bindtap="go">返回作品列表</button><view class="hq-view note">离开页面不会取消服务器任务；这里不会自动发起新的生成。</view>
    </block>

    <block wx:elif="{{pageId==='works'||pageId==='card-works'}}">
      <view class="hq-view eyebrow">YOUR CREATIVE COLLECTION</view><view class="hq-view hero-title">{{pageId==='works'?'灵感，已有形状。':'让作品，介绍你。'}}</view>
      <input class="hq-input search-input" value="{{search}}" data-field="search" bindinput="field" placeholder="搜索作品描述" aria-label="搜索作品"/>
      <scroll-view scroll-x class="filter-scroll"><view class="hq-view filter-row"><button wx:for="{{filters}}" wx:key="id" class="hq-button filter {{filter===item.id?'active':''}}" data-filter="{{item.id}}" bindtap="selectFilter">{{item.name}}</button></view></scroll-view>
      <block wx:if="{{pageId==='card-works'}}"><view class="hq-view note">图片与视频各可精选 3 件。点击下方作品加入名片；已发布的名片会同步更新。</view><view wx:for="{{card.works}}" wx:key="key" class="hq-view menu-row"><text class="hq-text truncate">{{item.title}}</text><button class="hq-button text-button" data-key="{{item.key}}" bindtap="removeFeatured" disabled="{{busy}}">移除</button></view></block>
      <view class="hq-view works-grid"><button wx:for="{{visibleWorks}}" wx:key="id" class="hq-button work" disabled="{{busy}}" data-id="{{item.id}}" bindtap="{{pageId==='card-works'?'toggleFeatured':'openWork'}}"><image wx:if="{{item.kind==='image'&&item.url}}" class="hq-image work-image" src="{{item.displayUrl||item.url}}" mode="aspectFill"/><view wx:else class="hq-view work-placeholder">{{item.kind==='audio'?'声':item.kind==='video'?'影':'文'}}</view><view class="hq-view work-meta"><text class="hq-text tag">{{item.label}}</text><text class="hq-text small muted">#{{item.id}}</text></view><view class="hq-view work-title">{{item.title}}</view></button></view>
      <view wx:if="{{!visibleWorks.length&&!loading}}" class="hq-view empty-state"><view class="hq-view empty-symbol">✦</view><view class="hq-view">{{search?'没有找到这件作品':'第一件作品，还在等你。'}}</view><button wx:if="{{search}}" class="hq-button secondary" bindtap="clearSearch">清除搜索与筛选</button><button wx:else class="hq-button primary" data-route="home" bindtap="go">开始创作</button></view><view wx:if="{{hasMore}}" class="hq-view note">当前展示各类型最近 30 条记录。</view>
    </block>

    <block wx:elif="{{pageId==='image-detail'||pageId==='video-detail'||pageId==='audio-detail'||pageId==='text-detail'}}">
      <view class="hq-view eyebrow">YOUR WORK / {{job.id}}</view><view class="hq-view hero-title compact">{{job.title||'作品详情'}}</view>
      <view wx:if="{{job&&!job.done}}" class="hq-view note">{{job.label}}。完成后作品会出现在这里。</view>
      <block wx:if="{{job.done}}">
        <image wx:if="{{pageId==='image-detail'&&job.url}}" class="hq-image detail-image" src="{{job.displayUrl}}" mode="widthFix" bindtap="preview" binderror="mediaError"/>
        <video wx:if="{{pageId==='video-detail'&&job.url}}" class="real-video" src="{{job.displayUrl}}" controls show-fullscreen-btn binderror="mediaError"/>
        <view wx:if="{{pageId==='audio-detail'}}" class="hq-view audio-cover"><view class="hq-view audio-orbit"><text class="hq-text">声</text></view><view class="hq-view audio-time"><text class="hq-text">{{audioTime||0}} 秒</text><text class="hq-text">{{audioDuration||0}} 秒</text></view><button class="hq-button audio-play" bindtap="playAudio">{{playing?'暂停':'播放声音'}}</button></view>
        <view wx:if="{{job.text}}" class="hq-view letter"><text class="hq-text letter-body" user-select>{{job.text}}</text></view>
        <button wx:if="{{pageId==='image-detail'&&job.url}}" class="hq-button primary" bindtap="saveImage" disabled="{{busy}}">保存图片到相册</button><button wx:if="{{job.text}}" class="hq-button primary" bindtap="copyText">复制文稿</button>
        <button class="hq-button secondary" data-route="card-works" bindtap="go">整理到我的名片</button>
      </block><button class="hq-button secondary" bindtap="refreshTask" disabled="{{busy}}">刷新作品</button><button class="hq-button text-button" data-route="chat" bindtap="go">继续创作</button>
    </block>

    <block wx:elif="{{pageId==='profile'}}">
      <view class="hq-view profile-head"><view class="hq-view avatar">雀</view><view class="hq-view"><view class="hq-view profile-name">{{user.display_name||'你好，创作者'}}</view><text class="hq-text muted">{{user.username||'让想法成为你的作品'}}</text></view></view>
      <button class="hq-button member-band" data-route="membership" bindtap="go"><view class="hq-view section-head"><text class="hq-text serif">给灵感，更多可能</text><text class="hq-text">↗</text></view><view class="hq-view member-bottom"><text class="hq-text">{{user.membership_tier||'账号权益'}}</text><view class="hq-view"><text class="hq-text balance">{{user?user.points:'—'}}</text><text class="hq-text"> 积分</text></view></view></button>
      <button class="hq-button menu-row" data-route="card" bindtap="go">我的创作者名片 <text class="hq-text">›</text></button><button class="hq-button menu-row" data-legacy="invite" bindtap="openLegacy">邀请与人脉 ›</button><button class="hq-button menu-row" data-legacy="card" bindtap="openLegacy">名片分享 ›</button><button class="hq-button menu-row" data-route="invite" bindtap="go">邀请朋友 <text class="hq-text">›</text></button><button class="hq-button menu-row" data-route="messages" bindtap="go">创作消息 <text class="hq-text">›</text></button><button class="hq-button menu-row" data-route="points" bindtap="go">积分明细 <text class="hq-text">›</text></button><button class="hq-button menu-row" data-route="help" bindtap="go">帮助与反馈 <text class="hq-text">›</text></button><button class="hq-button menu-row" data-route="security" bindtap="go">账号与安全 <text class="hq-text">›</text></button>
    </block>
    <block wx:elif="{{pageId==='membership'||pageId==='benefits'}}">
      <view class="hq-view eyebrow">FOR YOUR IDEAS</view><view class="hq-view hero-title">好想法<view class="hq-view"/>值得更多可能。</view><view class="hq-view member-band"><view class="hq-view serif">{{user.membership_tier||'黄雀创作者'}}</view><view class="hq-view balance">{{user?user.points:'—'}} <text class="hq-text small">积分</text></view></view><view wx:for="{{prices}}" wx:key="key" class="hq-view menu-row"><text class="hq-text">{{item.name}} · {{item.variant}}</text><text class="hq-text">{{item.points}} {{item.unit}}</text></view><view class="hq-view note">权益与余额以账号服务返回为准。会员购买在黄雀现有充值页完成。</view><button class="hq-button primary" data-legacy="recharge" bindtap="openLegacy">查看会员与充值</button><button class="hq-button secondary" data-route="points" bindtap="go">查看积分明细</button><button wx:if="{{pageId==='membership'}}" class="hq-button text-button" data-route="benefits" bindtap="go">查看会员权益</button>
    </block>
    <block wx:elif="{{pageId==='points'}}">
      <view class="hq-view eyebrow">YOUR POINTS</view><view class="hq-view hero-title">每一分，都有来处。</view><view class="hq-view balance">{{user?user.points:'—'}} <text class="hq-text small">可用积分</text></view><view wx:for="{{points}}" wx:key="task_id" class="hq-view ledger-row"><view class="hq-view"><view class="hq-view">{{item.func}}</view><text class="hq-text small muted">{{item.date}} · {{item.status_label}}</text></view><view class="hq-view"><view class="hq-view">−{{item.cost}}</view><text class="hq-text small gold">{{item.refunded?'已退回 '+item.cost:''}}</text></view></view><view wx:if="{{!points.length&&!loading}}" class="hq-view empty-state">暂无近 30 天的生成账单</view><view class="hq-view note">当前显示近 30 天、最近 50 条生成记录。</view>
    </block>
    <block wx:elif="{{pageId==='invite'}}">
      <view class="hq-view eyebrow">GOOD IDEAS FIND EACH OTHER</view><view class="hq-view hero-title">把创作的快乐<view class="hq-view"/>分享给朋友。</view><view class="hq-view ticket"><view class="hq-view section-title">与你一起创作的人</view><view class="hq-view balance">{{invite.valid_invites===undefined?'—':invite.valid_invites}}</view><text class="hq-text muted">有效邀请 · 今日新增 {{invite.today_new||0}}</text></view><button class="hq-button primary" data-route="card" bindtap="go">完善并发布我的名片</button><view class="hq-view note">邀请统计来自你的账号，奖励以正式活动规则为准。</view>
    </block>
    <block wx:elif="{{pageId==='card'||pageId==='card-public'}}">
      <view class="hq-view eyebrow">YOUR CREATOR CARD</view><view class="hq-view hero-title">让别人，从作品认识你。</view>
      <view wx:if="{{pageId==='card'}}" class="hq-view business-card"><view class="hq-view profile-name">{{card.name||user.display_name||'你的名字'}}</view><view class="hq-view gold">{{card.headline}}</view><view class="hq-view">{{card.company}}</view><view class="hq-view body-copy">{{card.bio||'写下一句话，介绍你自己。'}}</view><view class="hq-view small muted">{{card.published?'已公开发布':'草稿 · 尚未公开'}}</view></view>
      <view wx:elif="{{publicCard}}" class="hq-view business-card"><view class="hq-view profile-name">{{publicCard.name}}</view><view class="hq-view gold">{{publicCard.headline}}</view><view class="hq-view body-copy">{{publicCard.bio}}</view><view class="hq-view" wx:if="{{publicCard.address}}">{{publicCard.address}}</view><button wx:if="{{publicCard.email}}" class="hq-button text-button" bindtap="contact">联系创作者</button><view wx:for="{{publicCard.works}}" wx:key="title" class="hq-view"><image wx:if="{{item.type==='image'&&item.url}}" class="hq-image work-image" src="{{item.url}}" mode="widthFix" binderror="mediaError"/><video wx:if="{{item.type==='video'&&item.url}}" class="card-video" src="{{item.url}}" controls binderror="mediaError"/><view class="hq-view menu-row">{{item.title}}</view></view></view><view wx:else class="hq-view empty-state">名片尚未公开。发布后可查看访客视角。</view>
      <block wx:if="{{pageId==='card'}}"><button class="hq-button primary" data-route="card-edit" bindtap="go">编辑我的名片</button><button class="hq-button menu-row" data-route="privacy" bindtap="go">联系方式与隐私 ›</button><button class="hq-button menu-row" data-route="card-works" bindtap="go">精选作品管理 ›</button><button class="hq-button menu-row" data-route="card-public" bindtap="go">查看公开预览 ›</button><button class="hq-button secondary" bindtap="publishCard" disabled="{{busy}}">{{card.published?'收起公开名片':'发布名片'}}</button></block>
    </block>
    <block wx:elif="{{pageId==='card-edit'}}">
      <view class="hq-view eyebrow">A NOTE ABOUT YOU</view><view class="hq-view hero-title">写下你的独特之处。</view><label class="field"><text class="hq-text">展示名称</text><input class="hq-input" value="{{card.name}}" maxlength="40" data-field="name" bindinput="cardField"/></label><label class="field"><text class="hq-text">身份介绍</text><input class="hq-input" value="{{card.headline}}" maxlength="80" data-field="headline" bindinput="cardField"/></label><label class="field"><text class="hq-text">公司或工作室</text><input class="hq-input" value="{{card.company}}" maxlength="80" data-field="company" bindinput="cardField"/></label><label class="field"><text class="hq-text">一句话简介</text><textarea class="hq-textarea" value="{{card.bio}}" maxlength="1000" data-field="bio" bindinput="cardField"/></label><label class="field"><text class="hq-text">联系邮箱</text><input class="hq-input" value="{{card.email}}" maxlength="160" data-field="email" bindinput="cardField"/></label><label class="field"><text class="hq-text">所在城市</text><input class="hq-input" value="{{card.address}}" maxlength="160" data-field="address" bindinput="cardField"/></label><button class="hq-button primary" bindtap="saveCard" loading="{{busy}}" disabled="{{busy}}">保存名片</button>
    </block>
    <block wx:elif="{{pageId==='privacy'}}">
      <view class="hq-view eyebrow">PRIVATE, BY DESIGN</view><view class="hq-view hero-title">被看见的范围<view class="hq-view"/>由你决定。</view><view class="hq-view toggle-row"><view class="hq-view"><view class="hq-view">公开联系邮箱</view><text class="hq-text small muted">允许访客看到你填写的邮箱</text></view><switch class="hq-switch" checked="{{card.email_public}}" color="#92703a" data-key="email_public" bindchange="privacyToggle" disabled="{{busy}}"/></view><view class="hq-view toggle-row"><view class="hq-view"><view class="hq-view">展示所在城市</view><text class="hq-text small muted">公开预览中展示地址字段</text></view><switch class="hq-switch" checked="{{card.address_public}}" color="#92703a" data-key="address_public" bindchange="privacyToggle" disabled="{{busy}}"/></view><view class="hq-view note">设置保存至服务端。登录凭证、积分与私人创作记录不会写入名片。</view><button class="hq-button secondary" data-route="card-public" bindtap="go">查看公开预览</button>
    </block>
    <block wx:elif="{{pageId==='messages'}}">
      <view class="hq-view eyebrow">UPDATES FOR YOU</view><view class="hq-view hero-title">创作的每一步<view class="hq-view"/>都有回音。</view><button wx:for="{{works}}" wx:key="id" class="hq-button menu-row" data-id="{{item.id}}" bindtap="openWork"><view class="hq-view"><view class="hq-view">{{item.label}}</view><text class="hq-text small muted truncate">{{item.title}}</text></view><text class="hq-text">›</text></button><view wx:if="{{!works.length&&!loading}}" class="hq-view empty-state">现在，没有新的创作消息。</view><view class="hq-view note">这里按任务展示最新状态，尚未接入微信推送。</view><button class="hq-button secondary" data-route="notifications" bindtap="go">通知偏好</button>
    </block>
    <block wx:elif="{{pageId==='notifications'}}">
      <view class="hq-view eyebrow">A GENTLE REMINDER</view><view class="hq-view hero-title">只在需要时<view class="hq-view"/>轻轻提醒你。</view><view wx:for="{{notificationItems}}" wx:key="key" class="hq-view toggle-row"><text class="hq-text">{{item.title}}</text><switch class="hq-switch" checked="{{notifications[item.key]}}" color="#92703a" data-key="{{item.key}}" bindchange="notifyToggle"/></view><view class="hq-view note">仅保存在此设备。开关不代表已获得微信订阅授权。</view><button class="hq-button secondary" data-info="notice" bindtap="info">了解订阅提醒</button>
    </block>
    <block wx:elif="{{pageId==='help'}}">
      <view class="hq-view eyebrow">HERE FOR YOU</view><view class="hq-view hero-title">有疑问，慢慢说。</view><view wx:for="{{helpItems}}" wx:key="q" class="hq-view faq"><button class="hq-button menu-row" data-index="{{index}}" bindtap="faq">{{item.q}} <text class="hq-text">{{openFaq===index?'−':'＋'}}</text></button><view wx:if="{{openFaq===index}}" class="hq-view body-copy">{{item.a}}</view></view><button class="hq-button primary" data-route="feedback" bindtap="go">写下问题或建议</button>
    </block>
    <block wx:elif="{{pageId==='feedback'}}">
      <block wx:if="{{feedbackSent}}"><view class="hq-view empty-symbol">✓</view><view class="hq-view hero-title">谢谢你，认真告诉我们。</view><view class="hq-view note">反馈已保存到此设备，尚未发送给客服。</view><button class="hq-button primary" bindtap="newFeedback">再写一条</button><button class="hq-button secondary" data-route="help" bindtap="go">返回帮助中心</button></block>
      <block wx:else><view class="hq-view eyebrow">A NOTE TO US</view><view class="hq-view hero-title">你的建议<view class="hq-view"/>会让黄雀更好。</view><view class="hq-view filter-row"><button class="hq-button filter {{feedbackType==='体验建议'?'active':''}}" data-type="体验建议" bindtap="feedbackType">体验建议</button><button class="hq-button filter {{feedbackType==='功能问题'?'active':''}}" data-type="功能问题" bindtap="feedbackType">功能问题</button></view><label class="field"><text class="hq-text">发生了什么？</text><textarea class="hq-textarea" value="{{feedbackInput}}" data-field="feedbackInput" bindinput="field" maxlength="1000" placeholder="请至少填写五个字…"/></label><button class="hq-button primary" bindtap="submitFeedback" disabled="{{busy}}">保存反馈到本机</button><view class="hq-view note">客服提交接口尚未接入，当前不会发送反馈。</view></block>
    </block>
    <block wx:elif="{{pageId==='security'}}">
      <view class="hq-view eyebrow">ACCOUNT &amp; SECURITY</view><view class="hq-view hero-title">安心，是创作的底色。</view><view class="hq-view card"><view class="hq-view section-title">{{user.display_name||'尚未登录'}}</view><text class="hq-text muted">{{user.username}}</text></view><button class="hq-button menu-row" data-route="privacy" bindtap="go">名片隐私设置 ›</button><button class="hq-button menu-row" data-route="notifications" bindtap="go">通知偏好 ›</button><button class="hq-button menu-row" data-info="data" bindtap="info">我的数据保存在哪里 ›</button><button wx:if="{{user}}" class="hq-button secondary" bindtap="logout">退出登录</button><button wx:else class="hq-button primary" data-route="login" bindtap="go">登录黄雀</button>
    </block>
  </view>
  <view wx:if="{{pageId==='home'||pageId==='works'||pageId==='profile'}}" class="hq-view tabbar"><button class="hq-button tab {{pageId==='home'?'selected':''}}" data-route="home" bindtap="go"><view class="hq-view tab-glyph chat-glyph">···</view><text class="hq-text">对话</text><view class="hq-view tab-line"/></button><button class="hq-button tab {{pageId==='works'?'selected':''}}" data-route="works" bindtap="go"><view class="hq-view tab-glyph works-glyph"/><text class="hq-text">作品</text><view class="hq-view tab-line"/></button><button class="hq-button tab {{pageId==='profile'?'selected':''}}" data-route="profile" bindtap="go"><view class="hq-view tab-glyph person-glyph"><view class="hq-view person-head"/><view class="hq-view person-shoulders"/></view><text class="hq-text">我的</text><view class="hq-view tab-line"/></button></view>
</view>
