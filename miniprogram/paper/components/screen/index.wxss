.tabbar { position: fixed; bottom: 0; left: 0; width: 100%; display: flex; border-top: 1rpx solid #c7b99f; background: rgba(243, 234, 216, .96); padding: 16rpx 20rpx calc(8rpx + env(safe-area-inset-bottom)); z-index: 5; }
.tab { width: 33.333%; color: #8d8069; font-size: 26rpx; text-align: center; display: flex; align-items: center; flex-direction: column; min-height: 104rpx; }
