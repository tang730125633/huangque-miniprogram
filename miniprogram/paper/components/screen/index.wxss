.share-media-button { display:flex; width:100%; min-height:64rpx; align-items:center; justify-content:center; margin-top:9rpx; border:1rpx solid #d8d0c3; border-radius:14rpx; color:#5f4a27; background:#fffaf0; font-size:22rpx; text-align:center; }
.agent-task-card { margin:0 0 24rpx 84rpx; padding:24rpx; border:1rpx solid #d6d2c8; border-radius:20rpx; background:#fff; color:#3c423a; font-size:28rpx; line-height:1.7; }
.task-title { margin-bottom:10rpx; font-size:29rpx; font-weight:700; }
.task-cost { margin-top:12rpx; color:#75501b; font-size:25rpx; }
.task-actions { display:flex; gap:14rpx; margin-top:20rpx; }
.task-cancel,.task-confirm { display:flex; align-items:center; justify-content:center; flex:1; min-height:88rpx; padding:14rpx; border-radius:16rpx; text-align:center; font-size:26rpx; }
.task-cancel { border:1rpx solid #d6d2c8; background:#faf9f6; }
.task-confirm { color:#fffdf8; background:#202620; }
.agent-widget-card { margin:0 0 24rpx 62rpx; overflow:hidden; border:1rpx solid #d8d1c5; border-radius:22rpx; background:#fffdf9; box-shadow:0 10rpx 28rpx rgba(46,39,27,.06); }
.agent-widget-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:22rpx 22rpx 16rpx; }
.agent-widget-title { min-width:0; flex:1; color:#2c312c; font-size:28rpx; font-weight:700; line-height:1.4; }
.agent-widget-badge { flex:none; padding:6rpx 12rpx; border-radius:999rpx; color:#7b5a25; background:#f3e7cf; font-size:18rpx; }
.agent-widget-hint { display:block; padding:0 22rpx 18rpx; color:#777168; font-size:23rpx; line-height:1.55; }
.agent-widget-options { display:flex; flex-direction:column; gap:10rpx; padding:0 12rpx 14rpx; }
.agent-widget-option { display:flex; width:100%; min-height:96rpx; align-items:center; gap:14rpx; padding:14rpx; border:1rpx solid #e1dbd2; border-radius:16rpx; color:#30352f; background:#fff; text-align:left; }
.agent-widget-option.selected { border-color:#a97a2e; background:#fbf3e3; }
.agent-widget-thumb { width:88rpx; height:88rpx; flex:none; border-radius:12rpx; background:#eee8dc; }
.agent-widget-copy { min-width:0; flex:1; }
.agent-widget-name,.agent-widget-summary,.agent-widget-body { display:block; }
.agent-widget-name { font-size:26rpx; font-weight:650; line-height:1.4; }
.agent-widget-summary { margin-top:4rpx; color:#777168; font-size:21rpx; line-height:1.45; }
.agent-widget-body { display:-webkit-box; margin-top:6rpx; overflow:hidden; color:#5e625d; font-size:21rpx; line-height:1.5; -webkit-box-orient:vertical; -webkit-line-clamp:3; }
.agent-widget-action { flex:none; min-width:72rpx; color:#8a6223; font-size:22rpx; font-weight:650; text-align:center; }

/* Agent v2: aligned controls, horizontal tools, and a long-prompt composer. */
.attachment-scroll { width:100%; margin-bottom:18rpx; white-space:nowrap; }
.agent-chat-content .attachment-tools { display:flex; width:956rpx; gap:10rpx; margin:0; }
.agent-chat-content .attach-button { display:flex; align-items:center; justify-content:center; gap:10rpx; width:164rpx; min-height:84rpx; flex:none; padding:10rpx 14rpx; line-height:1.2; }
.agent-chat-content .attach-icon { width:38rpx; height:38rpx; flex:none; }
.agent-chat-content .attach-copy { min-width:0; text-align:left; }
.agent-chat-content .attach-subtitle { display:block; margin-top:4rpx; color:#91887a; font-size:17rpx; line-height:1.2; }
.agent-chat-content .ip-tool { width:260rpx; border-color:#c9a66a; background:#fbf4e7; }
.agent-chat-content .agent-composer .agent-input { box-sizing:border-box; width:100%; height:auto; min-height:104rpx; max-height:420rpx; overflow-y:auto; padding:12rpx 4rpx 18rpx; color:#20231e; font-size:31rpx; line-height:1.7; text-align:left; }
.agent-chat-content .composer-action-row { min-height:104rpx; align-items:center; }
.agent-chat-content .composer-action-row .input-help { display:flex; min-height:72rpx; align-items:center; }
.agent-chat-content .composer-action-row .send-text { display:flex; height:88rpx; min-height:88rpx; align-items:center; justify-content:center; padding:0; line-height:1; }
.home-composer .hq-textarea { max-height:360rpx; overflow-y:auto; }
.ip-drawer-mask { position:fixed; inset:0; z-index:100; background:rgba(32,30,26,.16); }
.ip-drawer { position:absolute; top:0; right:0; box-sizing:border-box; width:82%; height:100%; padding:calc(38rpx + env(safe-area-inset-top)) 28rpx calc(32rpx + env(safe-area-inset-bottom)); border-left:1rpx solid #ded5c7; background:#fffdf9; box-shadow:-24rpx 0 64rpx rgba(48,38,24,.18); animation:ip-drawer-in .2s ease-out; }
.ip-drawer-head { display:flex; min-height:82rpx; align-items:center; justify-content:space-between; border-bottom:1rpx solid #e6dfd4; }
.ip-drawer-title { color:#252a24; font-size:38rpx; font-weight:700; line-height:1.2; }
.ip-drawer-close { display:flex; width:76rpx; height:76rpx; min-height:76rpx; align-items:center; justify-content:center; padding:0; border:0; border-radius:50%; color:#544f47; background:#f2ece2; font-size:42rpx; line-height:1; }
.ip-drawer-note { display:block; margin:24rpx 0; color:#777166; font-size:24rpx; line-height:1.6; }
.ip-drawer-item { display:flex; width:100%; min-height:128rpx; align-items:center; gap:18rpx; margin-bottom:18rpx; padding:20rpx; border:1rpx solid #ddd4c7; border-radius:24rpx; color:#292e28; background:#fff; text-align:left; }
.ip-drawer-icon { width:54rpx; height:54rpx; flex:none; }
.ip-drawer-copy { min-width:0; flex:1; }
.ip-drawer-name,.ip-drawer-desc { display:block; }
.ip-drawer-name { font-size:29rpx; font-weight:700; line-height:1.35; }
.ip-drawer-desc { margin-top:7rpx; color:#81796d; font-size:22rpx; line-height:1.45; }
.ip-drawer-next { flex:none; color:#a7792c; font-size:38rpx; }
.ip-drawer-confirm { display:flex; width:100%; min-height:76rpx; align-items:center; justify-content:center; margin:-6rpx 0 18rpx; border-radius:18rpx; color:#fffdf8; background:#273029; font-size:25rpx; font-weight:650; }
@keyframes ip-drawer-in { from { transform:translateX(100%); } to { transform:translateX(0); } }
@media (prefers-reduced-motion:reduce) { .ip-drawer { animation:none; } }

/* Compact WeChat-style Agent composer. */
.agent-chat-content .compact-composer { flex:none; margin:0 -24rpx; padding:10rpx 12rpx calc(8rpx + env(safe-area-inset-bottom)); border:0; border-top:1rpx solid #e2dcd2; border-radius:0; background:#fffdf9; box-shadow:0 -6rpx 18rpx rgba(55,45,31,.045); }
.compact-composer-row { display:flex; min-width:0; align-items:center; gap:4rpx; }
.composer-icon-button { position:relative; display:flex; width:72rpx; height:72rpx; min-height:72rpx; flex:0 0 72rpx; align-items:center; justify-content:center; padding:0; border:0; border-radius:50%; color:#323832; background:transparent; text-align:center; }
.composer-icon-image { width:42rpx; height:42rpx; }
.voice-unavailable { width:82rpx; flex-basis:82rpx; flex-direction:column; gap:2rpx; color:#87827a; }
.voice-unavailable .composer-icon-image { width:28rpx; height:28rpx; margin:0; opacity:.62; }
.voice-unavailable-label { display:block; color:#77736d; font-size:17rpx; line-height:20rpx; white-space:nowrap; }
.composer-input-shell { min-width:0; flex:1; padding:2rpx; border:1rpx solid #ddd7ce; border-radius:16rpx; background:#fff; }
.agent-chat-content .compact-composer .agent-input { box-sizing:border-box; width:100%; height:auto; min-height:66rpx; max-height:300rpx; overflow-y:auto; padding:10rpx 14rpx; color:#252a25; font-size:26rpx; line-height:1.45; text-align:left; }
.composer-plus { font-size:44rpx; font-weight:300; line-height:1; }
.agent-chat-content .compact-send { display:flex; width:92rpx; height:72rpx; min-height:72rpx; flex:0 0 92rpx; align-items:center; justify-content:center; padding:0; border-radius:14rpx; color:#fffdf8; background:#202620; font-size:24rpx; font-weight:650; line-height:1; text-align:center; }
.agent-sheet-mask { position:fixed; inset:0; z-index:110; background:rgba(31,29,25,.28); }
.agent-sheet { position:absolute; right:0; bottom:0; left:0; box-sizing:border-box; max-height:72%; overflow-y:auto; padding:24rpx 26rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:34rpx 34rpx 0 0; background:#fffdf9; box-shadow:0 -24rpx 70rpx rgba(46,37,24,.18); animation:agent-sheet-in .2s ease-out; }
.agent-sheet-head { display:flex; min-height:76rpx; align-items:center; justify-content:space-between; border-bottom:1rpx solid #e8e1d7; }
.agent-sheet-title { color:#252a25; font-size:34rpx; font-weight:700; }
.agent-sheet-close { display:flex; width:70rpx; height:70rpx; min-height:70rpx; align-items:center; justify-content:center; padding:0; border-radius:50%; color:#5f5a52; background:#f1ece4; font-size:38rpx; line-height:1; }
.agent-sheet-note { display:block; margin:20rpx 0; color:#736e65; font-size:24rpx; line-height:1.55; }
.phrase-list { display:flex; flex-direction:column; gap:14rpx; }
.phrase-item { width:100%; min-height:88rpx; padding:18rpx 22rpx; border:1rpx solid #ded7cd; border-radius:18rpx; color:#303530; background:#fff; font-size:27rpx; line-height:1.45; text-align:left; }
.phrase-add { display:flex; width:100%; min-height:92rpx; align-items:center; justify-content:center; margin-top:18rpx; border-radius:18rpx; color:#fffdf8; background:#273029; font-size:27rpx; font-weight:650; text-align:center; }
.tool-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; padding-top:24rpx; }
.tool-item { display:flex; min-height:164rpx; align-items:center; justify-content:center; flex-direction:column; gap:12rpx; padding:16rpx 8rpx; border:1rpx solid #ded7cd; border-radius:22rpx; color:#343a34; background:#fff; font-size:24rpx; text-align:center; }
.tool-item .tool-icon { width:54rpx; height:54rpx; font-size:initial; }
.agent-sheet .asset-grid { margin-top:24rpx; }
@keyframes agent-sheet-in { from { transform:translateY(100%); } to { transform:translateY(0); } }
@media (prefers-reduced-motion:reduce) { .agent-sheet { animation:none; } }
