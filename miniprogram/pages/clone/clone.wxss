.clone-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.ph { color: #6f6980; }

.page-head {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx;
  padding: 8rpx 2rpx 28rpx;
}
.page-title { font-size: 40rpx; line-height: 1.25; font-weight: 700; color: var(--text); }
.page-sub { max-width: 540rpx; margin-top: 10rpx; color: var(--text-muted); font-size: 23rpx; line-height: 1.6; }
.head-icon {
  width: 54rpx; height: 54rpx; padding: 17rpx; flex: none;
  border-radius: 18rpx; background: var(--primary-soft); border: 1rpx solid rgba(226,75,160,.28);
}

.voice-library {
  margin: 0 -24rpx 24rpx; padding: 26rpx 24rpx;
  border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line);
  background: rgba(255,255,255,.018);
}

.voice-consent-panel {
  margin-bottom: 20rpx; padding: 24rpx;
  border: 1rpx solid rgba(226,75,160,.34); border-radius: 16rpx;
  background: rgba(226,75,160,.06);
}
.consent-title { color: var(--text); font-size: 27rpx; font-weight: 700; }
.consent-copy { margin-top: 10rpx; color: var(--text-muted); font-size: 21rpx; line-height: 1.65; }
.consent-action {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx;
  margin-top: 18rpx; font-size: 22rpx;
}
.consent-check { display: flex; align-items: center; color: #d8d1e4; }
.consent-check checkbox { transform: scale(.78); transform-origin: left center; margin-right: -8rpx; }
.consent-link { color: var(--primary-ink); text-decoration: underline; }
.library-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.library-title { color: var(--text); font-size: 30rpx; font-weight: 700; }
.library-count { margin-top: 5rpx; color: var(--text-muted); font-size: 21rpx; }
.points-balance {
  display: flex; align-items: baseline; gap: 5rpx; color: var(--text-muted); font-size: 20rpx;
}
.points-number { color: var(--secondary); font-size: 32rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.slot-scroll { width: 100%; margin-top: 22rpx; white-space: nowrap; }
.slot-list { display: inline-flex; gap: 14rpx; padding-right: 24rpx; }
.voice-slot {
  width: 204rpx; height: 154rpx; box-sizing: border-box; padding: 18rpx;
  display: inline-flex; flex-direction: column; justify-content: space-between;
  border-radius: 16rpx; background: var(--surface); border: 1rpx solid var(--line);
}
.voice-slot.selected {
  border-color: rgba(226,75,160,.7); background: rgba(226,75,160,.08);
  box-shadow: inset 0 0 0 1rpx rgba(226,75,160,.2);
}
.slot-wave { height: 32rpx; display: flex; align-items: center; gap: 5rpx; }
.slot-wave view { width: 5rpx; border-radius: 4rpx; background: var(--primary); }
.slot-wave view:nth-child(1) { height: 13rpx; }
.slot-wave view:nth-child(2) { height: 27rpx; }
.slot-wave view:nth-child(3) { height: 19rpx; }
.slot-wave view:nth-child(4) { height: 31rpx; }
.slot-name {
  width: 100%; overflow: hidden; text-overflow: ellipsis;
  color: var(--text); font-size: 23rpx; font-weight: 600; white-space: nowrap;
}
.slot-status { font-size: 19rpx; }
.slot-status.ready { color: var(--success); }
.slot-status.training { color: var(--warning); }
.slot-status.failed { color: #ff8da9; }
.slot-status.idle { color: var(--text-muted); }
.empty-library {
  min-height: 126rpx; margin-top: 22rpx; padding: 0 20rpx;
  display: flex; align-items: center; gap: 20rpx;
  border: 1rpx dashed var(--line); border-radius: 16rpx;
}
.empty-library image { width: 56rpx; height: 56rpx; opacity: .8; }
.empty-title { color: var(--text); font-size: 24rpx; font-weight: 600; }
.empty-copy { margin-top: 4rpx; color: var(--text-muted); font-size: 20rpx; }
.slot-purchase {
  min-height: 100rpx; margin-top: 20rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
}
.purchase-title { color: var(--text); font-size: 24rpx; font-weight: 600; }
.purchase-copy { margin-top: 5rpx; color: var(--text-muted); font-size: 20rpx; }
.buy-slot-btn {
  min-width: 176rpx; height: 70rpx; padding: 0 18rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  border-radius: 12rpx; color: #fff; background: var(--primary);
  font-size: 23rpx; font-weight: 600;
}
.buy-slot-btn.disabled { opacity: .45; }

.steps {
  display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: start;
  padding: 22rpx 20rpx; margin-bottom: 24rpx;
  border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line);
}
.step { display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: #6f6980; font-size: 20rpx; }
.step-dot {
  width: 42rpx; height: 42rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--surface-muted); border: 1rpx solid var(--line); font-size: 20rpx; font-weight: 700;
}
.step.active { color: var(--primary-ink); }
.step.active .step-dot { color: #fff; background: var(--primary); border-color: var(--primary); }
.step.done { color: var(--success); }
.step.done .step-dot { color: #07150d; background: var(--success); border-color: var(--success); }
.step-line { height: 2rpx; margin: 21rpx 14rpx 0; background: var(--line); }
.step-line.done { background: rgba(43,213,118,.55); }

.section {
  padding: 26rpx; margin-bottom: 20rpx; border-radius: 20rpx;
  background: var(--surface); border: 1rpx solid var(--line);
}
.section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.section-title { color: var(--text); font-size: 28rpx; font-weight: 650; }
.section-sub { margin-top: 6rpx; color: var(--text-muted); font-size: 21rpx; }
.duration {
  min-width: 118rpx; padding: 8rpx 12rpx; text-align: center; border-radius: 8rpx;
  background: var(--surface-muted); color: var(--text-muted); font-size: 21rpx; font-variant-numeric: tabular-nums;
}
.duration.live { color: #ff9abf; background: rgba(255,92,138,.12); }

.recorder {
  display: flex; align-items: center; gap: 20rpx; min-height: 142rpx;
  margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx;
  background: #100d17; border: 1rpx solid var(--line);
}
.recorder.recording { border-color: rgba(255,92,138,.46); background: rgba(255,92,138,.05); }
.recorder.ready { border-color: rgba(43,213,118,.32); }
.rec-btn {
  width: 88rpx; height: 88rpx; border-radius: 50%; flex: none;
  background: #ff5c8a; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 0 12rpx rgba(255,92,138,.1);
}
.recording .rec-btn { animation: recordPulse 1.4s ease-in-out infinite; }
.rec-ico-img { width: 38rpx; height: 38rpx; }
.rec-main { min-width: 0; flex: 1; }
.rec-state { color: var(--text); font-size: 27rpx; font-weight: 600; }
.rec-hint { margin-top: 6rpx; color: var(--text-muted); font-size: 20rpx; line-height: 1.45; }
.progress { height: 6rpx; margin-top: 16rpx; overflow: hidden; border-radius: 6rpx; background: var(--surface-muted); }
.progress-fill { height: 100%; min-width: 0; border-radius: inherit; background: #ff5c8a; transition: width .25s linear; }
.icon-action {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--primary-soft); border: 1rpx solid rgba(226,75,160,.3);
}
.icon-action image { width: 26rpx; height: 26rpx; }

.script-box { margin-top: 22rpx; padding: 22rpx; border-left: 4rpx solid var(--primary); background: var(--surface-muted); }
.script-label { margin-bottom: 8rpx; color: var(--primary-ink); font-size: 20rpx; font-weight: 600; }
.script-text { color: #d8d1e4; font-size: 24rpx; line-height: 1.75; }
.quality-row { display: flex; justify-content: space-between; gap: 10rpx; margin-top: 20rpx; }
.quality-item { display: flex; align-items: center; gap: 8rpx; color: var(--text-muted); font-size: 20rpx; white-space: nowrap; }
.quality-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--success); }

.name-section { position: relative; }
.input {
  width: 100%; height: 88rpx; box-sizing: border-box; margin-top: 16rpx; padding: 0 92rpx 0 20rpx;
  color: var(--text); font-size: 27rpx; border-radius: 14rpx;
  background: #100d17; border: 1rpx solid var(--line);
}
.field-count { position: absolute; right: 44rpx; bottom: 57rpx; color: #6f6980; font-size: 19rpx; }

.access-panel { padding: 34rpx 28rpx; text-align: center; border-bottom: 1rpx solid var(--line); }
.empty-access { padding-top: 52rpx; border-bottom: 0; }
.access-icon {
  width: 112rpx; height: 112rpx; margin: 0 auto 24rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--primary-soft); border: 1rpx solid rgba(226,75,160,.28);
}
.access-icon image { width: 62rpx; height: 62rpx; }
.access-title { color: var(--text); font-size: 34rpx; font-weight: 700; }
.access-copy { margin: 14rpx auto 0; max-width: 580rpx; color: var(--text-muted); font-size: 23rpx; line-height: 1.7; }
.benefits { display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; margin-top: 30rpx; }
.benefit {
  min-height: 74rpx; padding: 12rpx 6rpx; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  background: var(--surface); color: #cfc7dc; font-size: 20rpx; border: 1rpx solid var(--line);
}
.benefit-mark { color: var(--success); font-weight: 700; }
.price-band { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 6rpx; }
.price-label { color: var(--text); font-size: 25rpx; font-weight: 600; }
.price-balance { margin-top: 5rpx; color: var(--text-muted); font-size: 21rpx; }
.price-value { color: var(--secondary); font-size: 48rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.price-value text { font-size: 22rpx; font-weight: 500; }

.action-dock { padding-top: 4rpx; }
.action-note { margin-top: 12rpx; text-align: center; color: var(--text-muted); font-size: 20rpx; }
.btn-primary { min-height: 88rpx; padding: 0 24rpx; }
.btn-primary.disabled { opacity: .45; }
.ghost-btn {
  min-height: 84rpx; margin-top: 14rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-muted); font-size: 26rpx; border: 1rpx solid var(--line); background: var(--surface);
}
.err-box {
  margin: 16rpx 0; padding: 18rpx 20rpx; border-radius: 12rpx;
  color: #ffb7c8; font-size: 23rpx; line-height: 1.55;
  background: rgba(255,92,138,.1); border: 1rpx solid rgba(255,92,138,.25);
}

.state-panel { padding: 70rpx 26rpx 36rpx; text-align: center; }
.state-title { margin-top: 24rpx; color: var(--text); font-size: 34rpx; font-weight: 700; }
.state-copy { max-width: 560rpx; margin: 12rpx auto 0; color: var(--text-muted); font-size: 23rpx; line-height: 1.65; }
.state-icon {
  width: 112rpx; height: 112rpx; margin: 0 auto; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.state-icon image { width: 58rpx; height: 58rpx; }
.state-icon.success { background: rgba(43,213,118,.12); border: 1rpx solid rgba(43,213,118,.3); }
.state-icon.failed { background: rgba(255,92,138,.1); border: 1rpx solid rgba(255,92,138,.25); }
.preview-btn {
  width: 320rpx; min-height: 78rpx; margin: 30rpx auto 0; border-radius: 40rpx;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  color: var(--primary-ink); background: var(--primary-soft); border: 1rpx solid rgba(226,75,160,.3);
}
.preview-btn image { width: 28rpx; height: 28rpx; }
.state-actions { margin-top: 38rpx; }
.failure-tips { margin: 28rpx 0; padding: 20rpx 24rpx; text-align: left; border-radius: 14rpx; background: var(--surface); border: 1rpx solid var(--line); }
.failure-tips view { position: relative; padding-left: 24rpx; color: var(--text-muted); font-size: 22rpx; line-height: 1.8; }
.failure-tips view:before { content: ""; position: absolute; left: 2rpx; top: 14rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: var(--warning); }

.training-visual {
  height: 112rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx;
}
.wave { width: 10rpx; border-radius: 8rpx; background: var(--primary); animation: wave 1s ease-in-out infinite; }
.wave-a,.wave-e { height: 34rpx; }
.wave-b,.wave-d { height: 62rpx; animation-delay: .12s; }
.wave-c { height: 96rpx; animation-delay: .24s; }
.elapsed { margin-top: 28rpx; color: var(--primary-ink); font-size: 27rpx; font-variant-numeric: tabular-nums; }
.training-track { width: 320rpx; height: 6rpx; margin: 18rpx auto 0; overflow: hidden; border-radius: 6rpx; background: var(--surface-muted); }
.training-fill { width: 42%; height: 100%; background: var(--primary); animation: training 1.8s ease-in-out infinite; }
.loading-ring {
  width: 64rpx; height: 64rpx; margin: 0 auto; border-radius: 50%;
  border: 5rpx solid var(--surface-muted); border-top-color: var(--primary); animation: spin .8s linear infinite;
}

@keyframes recordPulse {
  0%,100% { box-shadow: 0 0 0 10rpx rgba(255,92,138,.08); }
  50% { box-shadow: 0 0 0 20rpx rgba(255,92,138,.16); }
}
@keyframes wave { 0%,100% { transform: scaleY(.55); opacity: .65; } 50% { transform: scaleY(1); opacity: 1; } }
@keyframes training { 0% { transform: translateX(-110%); } 100% { transform: translateX(340%); } }
@keyframes spin { to { transform: rotate(360deg); } }
