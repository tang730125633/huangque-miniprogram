.small { font-size: 22rpx; }
.ph { color: #6f6980; }
.center { text-align: center; }
.tip { margin: 14rpx 0; line-height: 1.5; }

.input {
  background: var(--surface); border: 1rpx solid var(--line);
  border-radius: 14rpx; padding: 24rpx; color: var(--text); font-size: 28rpx; margin-top: 12rpx;
}
.err { color: var(--error); font-size: 24rpx; margin: 16rpx 0; }

.rec-box { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 0; }
.rec-btn {
  width: 110rpx; height: 110rpx; border-radius: 50%; flex: none;
  background: rgba(194,65,58,0.1); border: 2rpx solid rgba(194,65,58,0.5);
  display: flex; align-items: center; justify-content: center;
}
.rec-btn.on { background: rgba(194,65,58,0.18); animation: pulse 1.2s infinite; }
.rec-ico-img { width: 48rpx; height: 48rpx; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
.rec-info { flex: 1; }
.rec-state { font-size: 27rpx; color: var(--text); }
.rec-play {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex: none;
  background: var(--primary-soft); color: var(--primary);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}

.state-ico { width: 96rpx; height: 96rpx; margin: 20rpx 0; }
.spin-pulse { animation: pulse 1.2s infinite; }
.train-title { font-size: 32rpx; font-weight: 600; margin: 12rpx 0; color: var(--text); }

.play-big {
  display: inline-flex; align-items: center; gap: 10rpx;
  margin: 20rpx auto; padding: 20rpx 44rpx; border-radius: 40rpx;
  background: var(--primary-soft); color: var(--primary); font-size: 28rpx;
}
.ic-pp-s { width: 28rpx; height: 28rpx; }

.btn-primary.disabled { opacity: 0.5; }
.ghost-btn {
  text-align: center; padding: 22rpx; border-radius: 14rpx; margin-top: 16rpx;
  border: 1rpx solid var(--line); color: var(--text-muted); font-size: 27rpx;
}
