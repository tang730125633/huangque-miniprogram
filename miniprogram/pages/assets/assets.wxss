.container { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.tabs {
  display: flex; gap: 8rpx; padding: 8rpx; margin-bottom: 24rpx;
  background: var(--surface); border: 1rpx solid var(--line); border-radius: 16rpx;
}
.tab { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; color: var(--text-muted); font-size: 27rpx; }
.tab.on { color: #fff; background: var(--primary); font-weight: 600; }

.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.cell-image-wrap {
  position: relative; width: 100%; overflow: hidden;
  border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--surface);
}
.cell-img { width: 100%; height: 224rpx; border-radius: 12rpx; background: var(--surface-muted); }

.grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.cell-video { border: 1rpx solid var(--line); border-radius: 14rpx; overflow: hidden; background: var(--surface); }
.cell-video-stage { position: relative; background: #000; }
.cell-video-cover, .cell-video-ph { width: 100%; height: 320rpx; display: block; }
.cell-video-ph { background: linear-gradient(135deg, #2b332f, #101512); }
.cell-video-play {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,0.85);
  color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.cell-video-text {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 12rpx 16rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.6)); color: #fff; font-size: 22rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.download-btn {
  position: absolute; top: 12rpx; right: 12rpx; z-index: 2;
  width: 58rpx; height: 58rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(8, 7, 13, 0.78); border: 1rpx solid rgba(255,255,255,0.2);
}
.download-ic { width: 28rpx; height: 28rpx; }

.prompt-meta {
  min-height: 52rpx; padding: 8rpx 10rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between; gap: 4rpx;
  background: var(--surface);
}
.prompt-state { color: var(--text-muted); font-size: 18rpx; white-space: nowrap; }
.prompt-state.has { color: var(--primary); }
.prompt-link { color: var(--primary); font-size: 18rpx; font-weight: 600; white-space: nowrap; }

.prompt-mask {
  position: fixed; z-index: 30; top: 0; right: 0; bottom: 0; left: 0; padding: 32rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(8, 7, 13, 0.58);
}
.prompt-dialog {
  width: 100%; max-height: 72vh; padding: 30rpx; box-sizing: border-box;
  border-radius: 24rpx; background: var(--surface);
}
.prompt-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.prompt-title { color: var(--text); font-size: 30rpx; font-weight: 600; }
.prompt-close {
  width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center;
  color: var(--text-muted); font-size: 40rpx; line-height: 1;
}
.prompt-scroll {
  height: 48vh; padding: 20rpx; box-sizing: border-box;
  border-radius: 14rpx; background: var(--surface-muted);
}
.prompt-full { color: var(--text); font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.prompt-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.prompt-action {
  flex: 1; padding: 20rpx 0; border-radius: 12rpx;
  text-align: center; font-size: 26rpx; font-weight: 600;
}
.prompt-action.secondary { color: var(--text); background: var(--surface-muted); }
.prompt-action.primary { color: #fff; background: var(--primary); }

.audio-row {
  display: flex; align-items: center; gap: 20rpx; padding: 24rpx;
  background: var(--surface); border: 1rpx solid var(--line); border-radius: 16rpx; margin-bottom: 14rpx;
}
.audio-play {
  width: 72rpx; height: 72rpx; flex: none; border-radius: 50%;
  background: var(--primary-soft); color: var(--primary);
  display: flex; align-items: center; justify-content: center; font-size: 30rpx;
}
.audio-text { flex: 1; font-size: 26rpx; color: var(--text); line-height: 1.5; }

.empty-state { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 80rpx 0; }
.empty-ic { width: 120rpx; height: 120rpx; opacity: 0.6; margin-bottom: 24rpx; }
.empty-title { font-size: 28rpx; color: var(--text); margin-bottom: 10rpx; }
.empty-sub { font-size: 23rpx; color: var(--text-muted); }
.ic-pp { width: 30rpx; height: 30rpx; }
