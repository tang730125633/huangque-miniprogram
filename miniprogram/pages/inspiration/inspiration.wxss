page { background: #050509; }
.page { min-height: 100vh; background: #050509; }

/* ===== 沉浸式头图 ===== */
.header { position: relative; min-height: 330rpx; overflow: hidden; }
.header-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.header-fade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 160rpx;
  background: linear-gradient(transparent, #050509);
}
.header-inner { position: relative; padding: 40rpx 28rpx 20rpx; }
.h-title { font-size: 48rpx; font-weight: 700; color: #fff; }
.h-sub { font-size: 25rpx; color: rgba(255,255,255,0.72); margin-top: 12rpx; }

.cat-bar { white-space: nowrap; margin-top: 30rpx; }
.cat { display: inline-block; margin-right: 36rpx; text-align: center; }
.cat text { font-size: 28rpx; color: rgba(255,255,255,0.55); }
.cat.on text { color: #fff; font-weight: 600; font-size: 30rpx; }
.cat-line { width: 40rpx; height: 4rpx; border-radius: 2rpx; background: #f229a6; margin: 10rpx auto 0; }

/* ===== 瀑布流 ===== */
.masonry { display: flex; padding: 24rpx 24rpx 0; gap: 16rpx; }
.masonry-col { flex: 1; width: 0; }

.card {
  background: #111018; border-radius: 22rpx; overflow: hidden; margin-bottom: 16rpx;
}
.card-media { position: relative; width: 100%; }
.card-img { width: 100%; height: 100%; display: block; }
.card-fail { background: linear-gradient(135deg, #3a1c52, #14101f); }
.card-grad { position: absolute; left: 0; right: 0; bottom: 0; height: 90rpx; background: linear-gradient(transparent, rgba(0,0,0,0.35)); }
.card-follow {
  position: absolute; right: 14rpx; top: 14rpx; z-index: 2;
  padding: 8rpx 20rpx; border-radius: 30rpx;
  background: rgba(242,41,166,0.92); color: #fff; font-size: 22rpx; font-weight: 600;
}

.card-title {
  padding: 16rpx 18rpx 6rpx; font-size: 25rpx; color: #fff; line-height: 1.4;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.card-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4rpx 18rpx 18rpx;
}
.card-engine { font-size: 21rpx; color: #9a8fb0; }
.card-pop { display: flex; align-items: center; gap: 6rpx; font-size: 21rpx; color: #9a8fb0; }
.heart { color: #f229a6; font-size: 24rpx; }

.empty { text-align: center; color: rgba(255,255,255,0.5); font-size: 26rpx; padding: 120rpx 0; }
.more { text-align: center; color: rgba(255,255,255,0.4); font-size: 23rpx; padding: 24rpx 0 8rpx; }
.bottom-safe { height: calc(40rpx + constant(safe-area-inset-bottom)); height: calc(40rpx + env(safe-area-inset-bottom)); }
