
.page { min-height: 100vh; }

/* ===== 沉浸式头图 ===== */
.header { position: relative; min-height: 330rpx; overflow: hidden; }
.header-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.header-fade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 160rpx;
  background: linear-gradient(transparent, var(--surface));
}
.header-inner { position: relative; padding: 40rpx 28rpx 20rpx; }
.h-title { font-size: 48rpx; font-weight: 700; color: var(--text); }
.h-sub { font-size: 25rpx; color: var(--text-muted); margin-top: 12rpx; }

.cat-bar { white-space: nowrap; margin-top: 30rpx; }
.cat { display: inline-block; margin-right: 36rpx; text-align: center; }
.cat text { font-size: 28rpx; color: var(--text-muted); }
.cat.on text { color: var(--text); font-weight: 600; font-size: 30rpx; }
.cat-line { width: 40rpx; height: 4rpx; border-radius: 2rpx; background: var(--surface-muted); margin: 10rpx auto 0; }

/* ===== 瀑布流 ===== */
.masonry { display: flex; padding: 24rpx 24rpx 0; gap: 16rpx; }
.masonry-col { flex: 1; width: 0; }

.card {
  background: var(--surface); border-radius: 22rpx; overflow: hidden; margin-bottom: 16rpx;
}
.card-media { position: relative; width: 100%; }
.card-img { width: 100%; height: 100%; display: block; }
.card-fail { background: linear-gradient(135deg, var(--surface), var(--surface)); }
.card-grad { position: absolute; left: 0; right: 0; bottom: 0; height: 90rpx; background: linear-gradient(transparent, rgba(151,119,69,0.16)); }
.card-follow {
  position: absolute; right: 14rpx; top: 14rpx; z-index: 2;
  padding: 8rpx 20rpx; border-radius: 30rpx;
  background: var(--grad); color: #fff8e8; font-size: 22rpx; font-weight: 600;
}
.video-badge {
  position: absolute; left: 14rpx; bottom: 14rpx; z-index: 2;
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 16rpx; border-radius: 30rpx;
  background: rgba(44,39,30,0.58); color: #fff8e8; font-size: 21rpx;
}
.video-play { font-size: 18rpx; }

.card-title {
  padding: 16rpx 18rpx 6rpx; font-size: 25rpx; color: var(--text); line-height: 1.4;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.card-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4rpx 18rpx 18rpx;
}
.card-engine { font-size: 21rpx; color: var(--text-muted); }
.card-pop { display: flex; align-items: center; gap: 6rpx; font-size: 21rpx; color: var(--text-muted); }
.heart { color: var(--primary); font-size: 24rpx; }

.empty { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 120rpx 0; }
.more { text-align: center; color: var(--text-muted); font-size: 23rpx; padding: 24rpx 0 8rpx; }
.bottom-safe { height: calc(150rpx + constant(safe-area-inset-bottom)); height: calc(150rpx + env(safe-area-inset-bottom)); }

.page { background:transparent; }
.header { min-height:250rpx; }
.header-inner { padding:36rpx 32rpx 10rpx; }
.h-title { font-family:"Songti SC","STSong",serif; font-weight:500; }
.masonry .card { padding:0; border:1rpx solid var(--line); box-shadow:0 6rpx 18rpx rgba(92,70,37,.04); }
