.brand { text-align: center; margin: 70rpx 0 44rpx; }
.brand-title { font-size: 52rpx; font-weight: 600; letter-spacing: 4rpx; color: var(--secondary); }
.brand-sub { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--text-muted); }

.tabs { display: flex; margin-bottom: 30rpx; border-bottom: 1rpx solid var(--line); }
.tab { flex: 1; text-align: center; padding: 20rpx 0; color: var(--text-muted); font-size: 29rpx; }
.tab.active { color: var(--primary); border-bottom: 4rpx solid var(--primary); font-weight: 600; }

.field { margin-bottom: 28rpx; }
.field-label { display: block; font-size: 25rpx; color: var(--text-muted); margin-bottom: 14rpx; }
.input {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 24rpx;
  color: var(--text);
  font-size: 29rpx;
}
.ph { color: #6f6980; }
.err { color: var(--error); font-size: 25rpx; margin-bottom: 20rpx; }
.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 4rpx 0 24rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.7;
}
.agreement-check { display: flex; align-items: center; }
.agreement-check checkbox { transform: scale(.78); transform-origin: center; margin-right: -4rpx; }
.agreement-link { color: var(--primary); text-decoration: underline; }
.agreement-separator { color: var(--text-muted); }
.voiceprint-agreement {
  margin: -6rpx 0 26rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid rgba(255, 82, 181, .72);
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 82, 181, .13), rgba(255, 173, 66, .08));
  box-shadow: 0 0 24rpx rgba(255, 82, 181, .12);
}
.voiceprint-agreement-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.voiceprint-agreement-badge { color: #ffb24b; font-size: 24rpx; font-weight: 700; }
.voiceprint-agreement-link { color: #ff69bd; font-size: 23rpx; font-weight: 600; text-decoration: underline; }
.voiceprint-agreement-copy { margin-top: 12rpx; color: #c8c1d0; font-size: 21rpx; line-height: 1.65; }
.card-register-link { margin-top: 24rpx; color: var(--primary); font-size: 24rpx; text-align: center; text-decoration: underline; }
.foot { text-align: center; font-size: 23rpx; margin-top: 30rpx; color: var(--text-muted); }
