.login-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 54rpx;
  background: #08060e;
}

.ambient { position: absolute; z-index: 0; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; pointer-events: none; background: linear-gradient(180deg, #030713 0%, #070817 30%, #090610 66%, #08060e 100%); }
.warp-canvas { position: absolute; z-index: 2; top: 0; left: 0; width: 100%; height: 520rpx; opacity: .68; pointer-events: none; }
.warp-core { position: absolute; top: -8rpx; left: 50%; width: 460rpx; height: 300rpx; margin-left: -230rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(128,181,255,.28), rgba(37,78,174,.15) 32%, rgba(5,12,32,0) 70%); animation: warp-core-breathe 4.6s ease-in-out infinite; }
.warp-core-flash { position: absolute; top: 105rpx; left: 200rpx; width: 60rpx; height: 60rpx; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.95), rgba(120,181,255,.6) 22%, rgba(57,100,214,.18) 52%, transparent 72%); box-shadow: 0 0 36rpx rgba(107,166,255,.65), 0 0 90rpx rgba(58,104,212,.34); animation: core-flash 3s ease-in-out infinite; }
.warp-core-ring { position: absolute; top: 90rpx; left: 185rpx; width: 88rpx; height: 88rpx; border: 1rpx solid rgba(135,187,255,.4); border-radius: 50%; animation: core-ring 3s ease-out infinite; }
.warp-spoke { position: absolute; z-index: 1; top: 127rpx; left: 50%; width: 2rpx; height: 2rpx; opacity: .1; transform-origin: 1rpx 1rpx; }
.warp-ray { position: absolute; top: 10rpx; left: 0; width: 3rpx; height: 210rpx; border-radius: 5rpx; transform-origin: top center; background: linear-gradient(180deg, rgba(198,225,255,0), rgba(142,187,255,.72) 34%, rgba(62,104,213,.18) 78%, transparent); box-shadow: 0 0 10rpx rgba(112,164,255,.4); animation: ray-flight 2.8s cubic-bezier(.16,.5,.3,1) infinite; }
.spoke-1 { transform: rotate(0deg); }
.spoke-2 { transform: rotate(30deg); }
.spoke-3 { transform: rotate(60deg); }
.spoke-4 { transform: rotate(90deg); }
.spoke-5 { transform: rotate(120deg); }
.spoke-6 { transform: rotate(150deg); }
.spoke-7 { transform: rotate(180deg); }
.spoke-8 { transform: rotate(210deg); }
.spoke-9 { transform: rotate(240deg); }
.spoke-10 { transform: rotate(270deg); }
.spoke-11 { transform: rotate(300deg); }
.spoke-12 { transform: rotate(330deg); }
.spoke-2 .warp-ray, .spoke-7 .warp-ray, .spoke-10 .warp-ray { height: 300rpx; animation-delay: -.45s; }
.spoke-3 .warp-ray, .spoke-8 .warp-ray { width: 6rpx; height: 160rpx; animation-delay: -1.1s; }
.spoke-4 .warp-ray, .spoke-11 .warp-ray { height: 250rpx; animation-delay: -1.75s; }
.spoke-5 .warp-ray, .spoke-12 .warp-ray { width: 2rpx; height: 340rpx; animation-delay: -2.2s; }
.spoke-6 .warp-ray, .spoke-9 .warp-ray { height: 190rpx; animation-delay: -.85s; }
.spoke-1 .warp-ray { animation-delay: -.06s; }
.spoke-2 .warp-ray { animation-delay: -.3s; }
.spoke-3 .warp-ray { animation-delay: -.54s; }
.spoke-4 .warp-ray { animation-delay: -.78s; }
.spoke-5 .warp-ray { animation-delay: -1.02s; }
.spoke-6 .warp-ray { animation-delay: -1.26s; }
.spoke-7 .warp-ray { animation-delay: -1.5s; }
.spoke-8 .warp-ray { animation-delay: -1.74s; }
.spoke-9 .warp-ray { animation-delay: -1.98s; }
.spoke-10 .warp-ray { animation-delay: -2.22s; }
.spoke-11 .warp-ray { animation-delay: -2.46s; }
.spoke-12 .warp-ray { animation-delay: -2.7s; }
.shard-track { position: absolute; z-index: 1; top: 127rpx; left: 50%; width: 2rpx; height: 2rpx; transform-origin: 1rpx 1rpx; }
.flight-shard { position: absolute; top: 12rpx; left: -2rpx; width: 4rpx; height: 14rpx; border: 1rpx solid rgba(209,231,255,.22); border-radius: 2rpx 4rpx 2rpx 3rpx; background: linear-gradient(165deg, rgba(231,242,255,.38), rgba(89,143,255,.16) 44%, rgba(37,71,157,.03)); box-shadow: 0 0 8rpx rgba(91,148,255,.18); transform-origin: top center; animation: shard-flight 5.6s cubic-bezier(.16,.48,.28,1) infinite; }
.shard-slim { left: -1rpx; width: 3rpx; height: 20rpx; animation-duration: 6.2s; }
.shard-wide { left: -3rpx; width: 7rpx; height: 11rpx; animation-duration: 5s; }
.shard-bright { width: 5rpx; height: 22rpx; background: linear-gradient(165deg, rgba(238,247,255,.5), rgba(117,176,255,.26) 38%, rgba(65,95,203,.04)); box-shadow: 0 0 11rpx rgba(133,185,255,.28); }
.shard-track-1 { transform: rotate(15deg); }
.shard-track-2 { transform: rotate(45deg); }
.shard-track-3 { transform: rotate(75deg); }
.shard-track-4 { transform: rotate(105deg); }
.shard-track-5 { transform: rotate(135deg); }
.shard-track-6 { transform: rotate(165deg); }
.shard-track-7 { transform: rotate(195deg); }
.shard-track-8 { transform: rotate(225deg); }
.shard-track-9 { transform: rotate(255deg); }
.shard-track-10 { transform: rotate(285deg); }
.shard-track-11 { transform: rotate(315deg); }
.shard-track-12 { transform: rotate(345deg); }
.shard-track-1 .flight-shard { animation-delay: -.18s; }
.shard-track-2 .flight-shard { animation-delay: -.46s; }
.shard-track-3 .flight-shard { animation-delay: -.74s; }
.shard-track-4 .flight-shard { animation-delay: -1.02s; }
.shard-track-5 .flight-shard { animation-delay: -1.3s; }
.shard-track-6 .flight-shard { animation-delay: -1.58s; }
.shard-track-7 .flight-shard { animation-delay: -1.86s; }
.shard-track-8 .flight-shard { animation-delay: -2.14s; }
.shard-track-9 .flight-shard { animation-delay: -2.42s; }
.shard-track-10 .flight-shard { animation-delay: -2.7s; }
.shard-track-11 .flight-shard { animation-delay: -2.98s; }
.shard-track-12 .flight-shard { animation-delay: -3.26s; }
.warp-dust { position: absolute; z-index: 2; width: 7rpx; height: 7rpx; border-radius: 2rpx; background: #d9eaff; box-shadow: 0 0 13rpx rgba(131,180,255,.9); animation: dust-flash 2.6s ease-in-out infinite; }
.dust-1 { top: 58rpx; left: 18%; transform: rotate(28deg); }
.dust-2 { top: 76rpx; right: 13%; width: 13rpx; height: 4rpx; animation-delay: -.7s; }
.dust-3 { top: 198rpx; left: 8%; width: 4rpx; height: 12rpx; animation-delay: -1.3s; }
.dust-4 { top: 238rpx; right: 9%; width: 15rpx; height: 3rpx; animation-delay: -1.9s; }
.dust-5 { top: 326rpx; left: 20%; width: 4rpx; height: 15rpx; animation-delay: -2.2s; }
.dust-6 { top: 360rpx; right: 18%; animation-delay: -.35s; }
.ambient-vignette { position: absolute; z-index: 3; top: 0; right: 0; bottom: 0; left: 0; background: radial-gradient(ellipse at 50% 130rpx, transparent 0%, rgba(3,6,17,.08) 36%, rgba(8,6,14,.62) 78%), linear-gradient(180deg, transparent 0%, rgba(8,6,14,.05) 22%, #08060e 48%, #08060e 100%); }

.login-close {
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  color: #9d96ad;
  font-size: 23rpx;
}
.close-icon { display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border: 1rpx solid rgba(255,255,255,.16); border-radius: 50%; font-size: 26rpx; line-height: 1; }

.brand { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; margin: 6rpx 0 34rpx; text-align: center; }
.brand-sigil { position: relative; width: 194rpx; height: 118rpx; margin-bottom: 18rpx; display: flex; align-items: center; justify-content: center; }
.sigil-halo { position: absolute; top: 4rpx; left: 20rpx; width: 154rpx; height: 108rpx; border-radius: 50%; background: radial-gradient(ellipse, rgba(240,165,75,.22), rgba(226,75,160,.06) 46%, transparent 72%); animation: sigil-breathe 4.2s ease-in-out infinite; }
.sigil-line { position: absolute; top: 61rpx; left: 2rpx; width: 190rpx; height: 1rpx; background: linear-gradient(90deg, transparent, rgba(240,165,75,.18), rgba(255,211,139,.7), rgba(226,75,160,.2), transparent); animation: sigil-line-pulse 3.8s ease-in-out infinite; }
.sigil-trail { position: absolute; left: 10rpx; height: 2rpx; border-radius: 4rpx; transform-origin: right center; background: linear-gradient(90deg, transparent, rgba(255,193,96,.7)); animation: trail-flow 3.6s ease-in-out infinite; }
.trail-one { top: 43rpx; width: 72rpx; transform: rotate(8deg); }
.trail-two { top: 61rpx; width: 58rpx; transform: rotate(0deg); animation-delay: -.8s; }
.trail-three { top: 77rpx; width: 66rpx; transform: rotate(-9deg); animation-delay: -1.6s; }
.sparrow-logo { position: relative; z-index: 2; width: 112rpx; height: 112rpx; margin-left: 24rpx; animation: sparrow-float 4.8s ease-in-out infinite; }
.sigil-particle { position: absolute; z-index: 3; border-radius: 50%; background: #ffe1a8; box-shadow: 0 0 14rpx rgba(255,193,92,.8); animation: star-pulse 2.8s ease-in-out infinite; }
.particle-one { top: 18rpx; right: 12rpx; width: 7rpx; height: 7rpx; }
.particle-two { bottom: 19rpx; left: 25rpx; width: 4rpx; height: 4rpx; animation-delay: -1.3s; }
.brand-kicker { color: rgba(255,200,121,.66); font-size: 17rpx; letter-spacing: 5rpx; }
.brand-title { margin-top: 10rpx; color: #ffd18a; font-size: 47rpx; font-weight: 700; letter-spacing: 5rpx; text-shadow: 0 0 28rpx rgba(240,165,75,.18); }
.brand-sub { margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; color: #9f98af; font-size: 23rpx; }
.status-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #dd4ca0; box-shadow: 0 0 14rpx rgba(226,75,160,.8); animation: star-pulse 2s ease-in-out infinite; }

.login-card {
  position: relative;
  z-index: 2;
  margin: 0;
  padding: 32rpx 28rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 30rpx;
  background: linear-gradient(160deg, rgba(29,23,40,.97), rgba(17,13,25,.98));
  box-shadow: 0 28rpx 80rpx rgba(0,0,0,.38), inset 0 1rpx 0 rgba(255,255,255,.06);
}
.card-beam { position: absolute; top: 0; left: 16%; width: 68%; height: 2rpx; background: linear-gradient(90deg, transparent, #f0a54b, #e24ba0, transparent); box-shadow: 0 0 22rpx rgba(226,75,160,.8); animation: beam-breathe 3s ease-in-out infinite; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.card-eyebrow { margin-bottom: 6rpx; color: #887e99; font-size: 16rpx; letter-spacing: 3rpx; }
.card-title { color: #f8f3fb; font-size: 31rpx; font-weight: 700; }
.secure-pill { display: flex; align-items: center; gap: 7rpx; flex: none; padding: 10rpx 14rpx; border: 1rpx solid rgba(240,165,75,.25); border-radius: 999rpx; color: #c8a36d; background: rgba(240,165,75,.07); font-size: 18rpx; }
.secure-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #66d89d; box-shadow: 0 0 10rpx rgba(102,216,157,.7); }

.quick-login { margin-bottom: 20rpx; padding: 18rpx; border: 1rpx solid rgba(226,75,160,.23); border-radius: 20rpx; background: linear-gradient(120deg, rgba(226,75,160,.09), rgba(112,64,184,.09)); }
.quick-login-copy { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.quick-login-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex: none; border: 1rpx solid rgba(255,206,127,.44); border-radius: 16rpx; color: #241323; background: linear-gradient(145deg, #f5bd68, #df599c); font-size: 22rpx; font-weight: 800; box-shadow: 0 0 20rpx rgba(226,75,160,.15); }
.quick-login-title { color: #eee8f2; font-size: 24rpx; font-weight: 650; }
.quick-login-desc { margin-top: 3rpx; color: #8f879b; font-size: 18rpx; }
.btn-card { display: flex; align-items: center; justify-content: center; gap: 14rpx; min-height: 68rpx; border: 1rpx solid rgba(231,92,171,.6); border-radius: 14rpx; color: #ef82c2; background: rgba(226,75,160,.08); font-size: 23rpx; font-weight: 650; }
.btn-card.disabled { opacity: .42; }
.quick-arrow { font-size: 26rpx; }

.login-scope-note { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 22rpx; padding: 16rpx 18rpx; border: 1rpx solid rgba(240,165,75,.18); border-radius: 17rpx; color: #9d96a8; background: rgba(240,165,75,.05); font-size: 19rpx; line-height: 1.55; }
.note-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 28rpx; height: 28rpx; margin-top: 1rpx; border: 1rpx solid rgba(255,200,113,.44); border-radius: 50%; color: #f6ba65; font-size: 18rpx; font-weight: 700; }
.note-copy { display: flex; flex-direction: column; gap: 2rpx; }
.note-title { color: #d8b582; font-size: 19rpx; font-weight: 600; }
.login-divider { display: flex; align-items: center; gap: 18rpx; margin: 4rpx 0 22rpx; color: #756e80; font-size: 18rpx; }
.login-divider::before, .login-divider::after { content: ''; flex: 1; height: 1rpx; background: linear-gradient(90deg, transparent, rgba(255,255,255,.13)); }
.login-divider::after { transform: rotate(180deg); }

.field { margin-bottom: 20rpx; }
.field-label { display: block; margin: 0 0 9rpx 4rpx; color: #aaa2b6; font-size: 21rpx; font-weight: 500; }
.input-shell { display: flex; align-items: center; min-height: 82rpx; padding: 0 20rpx; border: 1rpx solid rgba(255,255,255,.1); border-radius: 17rpx; background: rgba(8,6,14,.5); box-shadow: inset 0 1rpx 12rpx rgba(0,0,0,.2); transition: border-color .2s ease, background .2s ease; }
.input-shell:focus-within { border-color: rgba(226,75,160,.56); background: rgba(23,14,28,.76); box-shadow: 0 0 22rpx rgba(226,75,160,.08); }
.input { flex: 1; height: 82rpx; padding: 0 0 0 18rpx; color: #f5eff8; background: transparent; font-size: 25rpx; }
.ph { color: #625b70; }
.input-icon { position: relative; flex: none; width: 30rpx; height: 32rpx; opacity: .74; }
.user-head { position: absolute; top: 1rpx; left: 9rpx; width: 12rpx; height: 12rpx; border: 2rpx solid #cf91b6; border-radius: 50%; }
.user-body { position: absolute; bottom: 1rpx; left: 3rpx; width: 24rpx; height: 13rpx; border: 2rpx solid #cf91b6; border-bottom: 0; border-radius: 18rpx 18rpx 0 0; }
.lock-loop { position: absolute; top: 0; left: 6rpx; width: 16rpx; height: 15rpx; border: 2rpx solid #cf91b6; border-bottom: 0; border-radius: 12rpx 12rpx 0 0; }
.lock-body { position: absolute; left: 3rpx; bottom: 1rpx; width: 24rpx; height: 18rpx; border: 2rpx solid #cf91b6; border-radius: 5rpx; }
.err { display: flex; align-items: flex-start; gap: 10rpx; margin: -2rpx 0 18rpx; padding: 14rpx 16rpx; border: 1rpx solid rgba(255,92,138,.24); border-radius: 12rpx; color: #ff8ead; background: rgba(255,92,138,.08); font-size: 21rpx; }
.err-dot { flex: none; width: 7rpx; height: 7rpx; margin-top: 10rpx; border-radius: 50%; background: #ff5c8a; }

.agreement-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 3rpx; margin: 2rpx 0 18rpx; color: #9d96a8; font-size: 19rpx; line-height: 1.65; }
.agreement-check { display: flex; align-items: center; }
.agreement-check checkbox { transform: scale(.7); transform-origin: center; margin-right: -8rpx; }
.agreement-link { color: #e761ad; text-decoration: underline; }
.agreement-separator { color: #8f8799; }
.voiceprint-agreement { margin-bottom: 22rpx; padding: 16rpx 18rpx; border: 1rpx solid rgba(226,75,160,.3); border-radius: 17rpx; background: linear-gradient(120deg, rgba(226,75,160,.09), rgba(111,62,181,.08)); }
.voiceprint-agreement-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.voiceprint-title { display: flex; align-items: center; gap: 10rpx; color: #f0b25c; font-size: 20rpx; font-weight: 700; }
.voice-bars { display: flex; align-items: center; gap: 3rpx; width: 27rpx; height: 24rpx; }
.voice-bar { display: block; width: 3rpx; height: 9rpx; border-radius: 3rpx; background: #f0a54b; animation: voice-wave 1.4s ease-in-out infinite; }
.voice-bar:nth-child(2) { height: 18rpx; animation-delay: -.9s; }
.voice-bar:nth-child(3) { height: 13rpx; animation-delay: -.5s; }
.voice-bar:nth-child(4) { height: 21rpx; animation-delay: -.2s; }
.voiceprint-agreement-link { color: #e96cb4; font-size: 19rpx; }
.voiceprint-agreement-copy { margin-top: 9rpx; color: #9e96a8; font-size: 18rpx; line-height: 1.55; }

.login-button { position: relative; min-height: 84rpx; padding: 0 28rpx; overflow: hidden; border-radius: 17rpx; background: linear-gradient(110deg, #7040b8, #c6429a 52%, #e28953); box-shadow: 0 14rpx 32rpx rgba(156,55,145,.24), inset 0 1rpx 0 rgba(255,255,255,.2); font-size: 26rpx; letter-spacing: 2rpx; }
.login-button text { position: relative; z-index: 2; }
.button-sheen { position: absolute; z-index: 1; top: -40%; left: -30%; width: 26%; height: 180%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.32), transparent); transform: skewX(-22deg); animation: button-sheen 4.6s ease-in-out infinite; }
.button-arrow { position: absolute !important; right: 28rpx; color: rgba(255,255,255,.78); font-size: 30rpx; }
.login-button.disabled { opacity: .48; box-shadow: none; }
.login-button.disabled .button-sheen { display: none; }
.card-register-link { display: flex; justify-content: center; gap: 8rpx; margin-top: 20rpx; color: #8f879a; font-size: 20rpx; }
.register-action { color: #de55a4; }
.foot { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 22rpx; color: #70697b; font-size: 17rpx; }
.foot-line { width: 52rpx; height: 1rpx; background: linear-gradient(90deg, transparent, rgba(255,255,255,.15)); }
.foot-line:last-child { transform: rotate(180deg); }

@keyframes warp-core-breathe { 0%,100% { opacity: .55; transform: scale(.9); } 50% { opacity: 1; transform: scale(1.08); } }
@keyframes core-flash { 0%,100% { opacity: .45; transform: scale(.72); } 50% { opacity: 1; transform: scale(1.22); } }
@keyframes core-ring { 0% { opacity: .75; transform: scale(.25); } 75%,100% { opacity: 0; transform: scale(2.5); } }
@keyframes ray-flight { 0% { opacity: 0; transform: translateY(-12rpx) scaleY(.04); } 18% { opacity: .9; } 76% { opacity: .55; } 100% { opacity: 0; transform: translateY(54rpx) scaleY(1.85); } }
@keyframes shard-flight { 0% { opacity: 0; transform: translateY(4rpx) skewX(-10deg) scale(.08); } 20% { opacity: .32; } 60% { opacity: .22; } 100% { opacity: 0; transform: translateY(112rpx) skewX(10deg) scale(.66) rotate(12deg); } }
@keyframes dust-flash { 0%,100% { opacity: .15; transform: scale(.4); } 45% { opacity: 1; transform: scale(1.6); } 70% { opacity: .35; transform: scale(.8); } }
@keyframes star-pulse { 0%,100% { opacity: .25; transform: scale(.65); } 50% { opacity: 1; transform: scale(1.35); } }
@keyframes sigil-breathe { 0%,100% { opacity: .4; transform: scale(.82); } 50% { opacity: 1; transform: scale(1.12); } }
@keyframes sigil-line-pulse { 0%,100% { opacity: .2; transform: scaleX(.62); } 50% { opacity: .9; transform: scaleX(1); } }
@keyframes trail-flow { 0%,100% { opacity: .18; transform: translateX(-16rpx) scaleX(.58); } 50% { opacity: .86; transform: translateX(8rpx) scaleX(1); } }
@keyframes sparrow-float { 0%,100% { transform: translate3d(-2rpx,3rpx,0) scale(.97); opacity: .88; } 50% { transform: translate3d(4rpx,-5rpx,0) scale(1.03); opacity: 1; } }
@keyframes beam-breathe { 0%,100% { opacity: .46; transform: scaleX(.72); } 50% { opacity: 1; transform: scaleX(1); } }
@keyframes voice-wave { 0%,100% { transform: scaleY(.5); opacity: .5; } 50% { transform: scaleY(1.25); opacity: 1; } }
@keyframes button-sheen { 0%,58% { left: -35%; opacity: 0; } 65% { opacity: 1; } 82%,100% { left: 120%; opacity: 0; } }
