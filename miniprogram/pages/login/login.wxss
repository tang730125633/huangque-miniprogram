page{--bg:#f6f4ef;--surface:rgba(255,255,255,.78);--text:#20231e;--text-muted:#666b64;--line:#ddd9d0;--primary:#9a6a21;--secondary:#9a6a21;--error:#934d36;--grad:#202620;background:radial-gradient(circle at 88% 0%,rgba(226,209,171,.5),transparent 30%),linear-gradient(180deg,#faf9f6,#f4f1ea);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;}
.paper-grain{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.12;background-image:url("data:image/svg+xml;base64,");background-size:180px 180px;}
.container{position:relative;z-index:1;padding:24rpx 38rpx calc(40rpx + env(safe-area-inset-bottom));}
button{box-sizing:border-box;font:inherit;line-height:inherit;margin:0;padding:0;}
button::after{border:0;}
.login-close{position:absolute;top:8rpx;right:30rpx;width:88rpx;min-height:88rpx;line-height:88rpx;background:transparent;color:var(--text-muted);font-size:25rpx;text-align:center;}
.brand{margin:36rpx 0 42rpx;text-align:center;}
.brand-seal{display:flex;align-items:center;justify-content:center;width:110rpx;height:110rpx;margin:0 auto 24rpx;border:1rpx solid #ae9467;border-radius:50%;color:#8d7040;font:64rpx "Songti SC","STSong",serif;}
.brand-eyebrow{color:#897344;font-size:21rpx;letter-spacing:3rpx;margin-bottom:26rpx;}
.brand-title{color:var(--text);font-size:42rpx;line-height:1.5;font-weight:600;letter-spacing:1rpx;}
.brand-sub{display:block;margin-top:16rpx;font-size:25rpx;color:var(--text-muted);}
.card{padding:28rpx;border:1rpx solid #cdbf9f;border-radius:20rpx;background:rgba(255,253,247,.38);box-shadow:0 6rpx 20rpx rgba(100,80,42,.035);}
.tabs{display:flex;margin-bottom:32rpx;border-bottom:1rpx solid #d4c7ae;}
.tab{flex:1;width:50%;min-height:88rpx;padding:22rpx 0;background:transparent;border-radius:0;color:var(--text-muted);font-size:29rpx;text-align:center;}
.tab.active{color:#29271f;border-bottom:3rpx solid #92703a;font-weight:600;}
.invite-notice{margin:0 0 24rpx;padding:18rpx 20rpx;color:#786033;background:#ebe0c9;border:1rpx solid #c9b591;border-radius:10rpx;font-size:25rpx;line-height:1.7;}
.invite-notice.error,.err{color:var(--error);font-size:25rpx;line-height:1.7;}
.err{margin-bottom:24rpx;}
.field{margin-bottom:28rpx;}
.field-label{display:block;font-size:26rpx;color:var(--text-muted);margin-bottom:14rpx;}
.input{box-sizing:border-box;width:100%;height:94rpx;padding:20rpx 24rpx;background:rgba(255,253,247,.44);border:1rpx solid #cdbf9f;border-radius:12rpx;color:var(--text);font-size:29rpx;}
.ph{color:#968b76;}
.agreement-row{display:flex;flex-wrap:wrap;align-items:center;gap:4rpx;margin:8rpx 0 28rpx;font-size:23rpx;line-height:1.8;color:var(--text-muted);}
.agreement-check{display:flex;align-items:center;min-height:68rpx;}
.agreement-check checkbox{transform:scale(.85);transform-origin:left center;}
.agreement-link{color:#816338;text-decoration:underline;}
.agreement-separator{color:var(--text-muted);}
.voiceprint-agreement{margin-bottom:30rpx;padding:22rpx;border:1rpx solid #cdbd9c;border-radius:12rpx;background:rgba(230,215,184,.30);}
.voiceprint-agreement-head{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;justify-content:space-between;}
.voiceprint-agreement-badge{color:#6e5936;font-size:24rpx;font-weight:600;}
.voiceprint-agreement-link{color:#816338;font-size:23rpx;text-decoration:underline;}
.voiceprint-agreement-copy{margin-top:14rpx;color:#756b58;font-size:23rpx;line-height:1.8;}
.container .btn-primary{display:block;width:100%;min-height:94rpx;padding:24rpx;background:#292b23;border-radius:12rpx;color:#fff8e8;text-align:center;font-size:29rpx;line-height:1.6;box-shadow:none;}
.container .btn-primary.disabled{background:#d8cdb7;color:#716754;opacity:1;}
.foot{text-align:center;font-size:23rpx;line-height:1.8;margin-top:28rpx;color:var(--text-muted);}
