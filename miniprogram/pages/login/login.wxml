<view class="container">
  <view class="brand">
    <text class="brand-title gold">黄雀作图</text>
    <text class="brand-sub muted">AI 生图工作台</text>
  </view>

  <view class="card">
    <view class="tabs">
      <view class="tab {{mode==='login'?'active':''}}" bindtap="setMode" data-m="login">登录</view>
      <view class="tab {{mode==='register'?'active':''}}" bindtap="setMode" data-m="register">注册</view>
    </view>

    <view class="field">
      <text class="field-label">账号</text>
      <input class="input" type="text" placeholder="请输入账号" placeholder-class="ph"
        value="{{username}}" bindinput="onUsername" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" password="{{true}}" placeholder="请输入密码" placeholder-class="ph"
        value="{{password}}" bindinput="onPassword" />
    </view>

    <view wx:if="{{mode==='register'}}" class="field">
      <text class="field-label">邀请码（选填）</text>
      <input class="input invite-input" type="text" maxlength="6"
        placeholder="输入 6 位邀请码" placeholder-class="ph"
        value="{{inviteCode}}" bindinput="onInviteCode" bindblur="validateInviteCode" />
      <view wx:if="{{inviteHint}}" class="invite-hint">{{inviteHint}}</view>
    </view>

    <view wx:if="{{mode==='register'}}" class="reg-tip"><image class="reg-tip-ic" src="../../assets/icons/gift.svg"></image>新用户注册即送 16 点，可免费体验作图</view>

    <view wx:if="{{err}}" class="err">{{err}}</view>

    <view class="agreement-row">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-check">
          <checkbox value="accepted" checked="{{agreed}}" color="#b048c8" />
          <text>我已阅读并同意</text>
        </label>
      </checkbox-group>
      <navigator class="agreement-link" url="/pages/legal/legal?type=terms">《用户服务协议》</navigator>
      <text class="agreement-separator">和</text>
      <text class="agreement-link" bindtap="openPrivacyContract">《隐私保护指引》</text>
    </view>

    <view class="btn-primary {{(loading || !agreed)?'disabled':''}}" bindtap="submit">
      {{loading ? '请稍候…' : (mode==='login' ? '登录' : '注册并登录')}}
    </view>
  </view>

  <view class="foot muted">数据由黄雀传媒后端安全处理</view>
</view>
