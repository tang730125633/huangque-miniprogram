<view class="container">
  <view class="login-close" bindtap="close">关闭</view>
  <view class="brand">
    <text class="brand-title gold">黄雀 AI 工作台</text>
    <text class="brand-sub muted">{{mode === 'register' ? '创建你的黄雀 AI 账号' : '登录你的黄雀 AI 账号'}}</text>
  </view>

  <view class="card">
    <view class="tabs">
      <view class="tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="setMode">登录</view>
      <view class="tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="setMode">注册</view>
    </view>

    <view wx:if="{{mode === 'register' && inviteRequired && inviteValidating}}" class="invite-notice">正在确认邀请信息…</view>
    <view wx:elif="{{mode === 'register' && inviteRequired && inviteError}}" class="invite-notice error">{{inviteError}}</view>
    <view wx:elif="{{mode === 'register' && inviteRequired}}" class="invite-notice">你正在通过“{{inviterName}}”的邀请注册</view>

    <view class="field">
      <text class="field-label">账号</text>
      <input class="input" type="text" placeholder="请输入账号" placeholder-class="ph"
        value="{{username}}" bindinput="onUsername" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" password="{{true}}" placeholder="请输入密码" placeholder-class="ph"
        value="{{password}}" bindinput="onPassword" />
    </view>

    <view wx:if="{{err}}" class="err">{{err}}</view>

    <view class="agreement-row">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-check">
          <checkbox value="accepted" checked="{{agreed}}" color="#b048c8" />
          <text>我已阅读并同意</text>
        </label>
      </checkbox-group>
      <navigator class="agreement-link" url="/pages/legal/legal?type=terms">《用户服务协议》</navigator>
      <text class="agreement-separator">和</text>
      <text class="agreement-link" bindtap="openPrivacyContract">《隐私保护指引》</text>
    </view>

    <view class="voiceprint-agreement">
      <view class="voiceprint-agreement-head">
        <text class="voiceprint-agreement-badge">声音信息专项授权</text>
        <navigator class="voiceprint-agreement-link" url="/pages/legal/legal?type=voiceprint">查看《声纹授权协议》 ›</navigator>
      </view>
      <view class="voiceprint-agreement-copy">登录不代表声纹授权。仅当你主动使用声音克隆或上传口播音频时，系统才会再次弹窗，并要求单独勾选同意；未授权不会采集或上传声音，也不影响登录及其他功能。</view>
    </view>

    <view class="btn-primary {{(loading || !agreed)?'disabled':''}}" bindtap="submit">
      {{loading ? '请稍候…' : (mode === 'register' ? '注册并登录' : '登录')}}
    </view>
  </view>

  <view class="foot muted">登录或注册后可使用黄雀 AI 的全部账户功能</view>
</view>
