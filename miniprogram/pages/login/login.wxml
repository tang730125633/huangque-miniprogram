<view class="paper-grain" aria-hidden="true" />
<view class="container">
  <button class="login-close" bindtap="close" aria-label="关闭登录页">关闭</button>
  <view class="brand">
    <view class="brand-seal" aria-hidden="true">雀</view>
    <view class="brand-eyebrow">HUANGQUE · 黄雀</view>
    <view class="brand-title">{{mode === 'register' ? '你的创作' : '让每一个想法'}}<view>{{mode === 'register' ? '从这一页开始。' : '都有落下的地方。'}}</view></view>
    <text class="brand-sub muted">{{mode === 'register' ? '创建你的黄雀 AI 账号' : '登录你的黄雀 AI 账号'}}</text>
  </view>

  <view class="card">
    <view class="tabs">
      <button class="tab {{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="setMode">登录</button>
      <button class="tab {{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="setMode">注册</button>
    </view>

    <view wx:if="{{mode === 'register' && inviteRequired && inviteValidating}}" class="invite-notice">正在确认邀请信息…</view>
    <view wx:elif="{{mode === 'register' && inviteRequired && inviteError}}" class="invite-notice error">{{inviteError}}</view>
    <view wx:elif="{{mode === 'register' && inviteRequired}}" class="invite-notice">你正在通过“{{inviterName}}”的邀请注册</view>

    <view class="field">
      <text class="field-label">账号</text>
      <input class="input" type="text" aria-label="黄雀账号" placeholder="请输入账号" placeholder-class="ph"
        value="{{username}}" bindinput="onUsername" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" password="{{true}}" aria-label="密码" placeholder="请输入密码" placeholder-class="ph"
        value="{{password}}" bindinput="onPassword" />
    </view>

    <view wx:if="{{err}}" class="err">{{err}}</view>

    <view class="agreement-row">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-check">
          <checkbox value="accepted" checked="{{agreed}}" color="#92703a" />
          <text>我已阅读并同意</text>
        </label>
      </checkbox-group>
      <navigator class="agreement-link" url="/pages/legal/legal?type=terms">《用户服务协议》</navigator>
      <text class="agreement-separator">和</text>
      <text class="agreement-link" bindtap="openPrivacyContract">《隐私保护指引》</text>
    </view>

    <button class="btn-primary {{(loading || !agreed)?'disabled':''}}" bindtap="submit" disabled="{{loading || !agreed}}" loading="{{loading}}">
      {{loading ? '请稍候…' : (mode === 'register' ? '注册并登录' : '登录黄雀')}}
    </button>
  </view>

  <view class="foot muted">登录或注册后可使用黄雀 AI 的全部账户功能</view>
</view>
