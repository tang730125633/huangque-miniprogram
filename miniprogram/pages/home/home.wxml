<view class="home">

  <!-- 顶部沉浸式黑色留白（含胶囊安全区） -->
  <view class="top-spacer">
    <!-- 纯 WXSS 动效：不依赖 GIF / 定时器，页面离开后由渲染层自动停止 -->
    <view class="hero-motion" aria-hidden="true">
      <view class="hero-aurora"></view>
      <view class="hero-orbit hero-orbit-back"></view>
      <view class="hero-orbit hero-orbit-front"></view>
      <view class="hero-core"><view class="hero-core-dot"></view></view>
      <view class="hero-spark hero-spark-one"></view>
      <view class="hero-spark hero-spark-two"></view>
      <view class="hero-spark hero-spark-three"></view>
    </view>
    <view class="brandbar">
      <view class="brand-lockup">
        <text class="brand">黄雀 AI</text>
        <text class="brand-tagline">CREATE · IMAGINE · SHARE</text>
      </view>
      <view class="pts" bindtap="onTapPoints">
        <image class="pts-ic" src="../../assets/icons/coin.svg"></image>
        <text>{{points === null ? '去登录' : points + ' 点'}}</text>
      </view>
    </view>
  </view>

  <view class="content">

    <!-- 功能矩阵：左大 + 右上下双卡 -->
    <view class="mosaic">
      <view class="primary-card" bindtap="onTapPrimaryCreation">
        <view class="pc-title">视频创作</view>
        <view class="pc-sub">文生视频与图生视频</view>
        <view class="pc-price">10 点/秒起</view>
        <view class="pc-icon-slot">
          <image class="pc-icon" src="{{assets.creativeSymbol}}" mode="aspectFit"></image>
        </view>
      </view>

      <view class="right-col">
        <view class="mini-card mc-image" bindtap="onTapImageCreation">
          <view class="mc-body">
            <view class="mc-title">智能生图/改图</view>
            <view class="tag tag-cyan">多模型创作</view>
          </view>
          <image class="mc-icon" src="{{assets.imageToolIcon}}" mode="aspectFit"></image>
        </view>

        <view class="mini-card mc-video" bindtap="onTapVideoAnalysis">
          <view class="mc-body">
            <view class="mc-title">一键跟创</view>
            <view class="tag tag-orange">灵感案例快速生成</view>
          </view>
          <image class="mc-icon" src="{{assets.videoAnalysisIcon}}" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 数字化 IP 入口 -->
    <view class="dh-entry" bindtap="onTapDigitalHuman">
      <image class="dh-avatar" src="{{assets.digitalHumanAvatar}}" mode="aspectFill"></image>
      <view class="dh-copy">
        <text class="dh-title">数字化 IP</text>
      </view>
      <text class="dh-cta">建立档案 ›</text>
    </view>

    <!-- 顶部轮播 Banner（可扩展） -->
    <view class="rt-swiper-wrap">
      <swiper
        class="rt-swiper"
        circular="{{banners.length > 1}}"
        indicator-dots="{{false}}"
        autoplay="{{bannerAutoplay && banners.length > 1}}"
        interval="5000"
        duration="300"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="rt-banner" bindtap="onTapRoleTransfer" data-path="{{item.path}}">
            <image class="rt-bg" src="{{item.image}}" mode="aspectFill" fade-in="{{false}}"></image>
            <view class="rt-mask"></view>
            <view class="rt-text">
              <view class="rt-title">{{item.title}}</view>
              <view class="rt-sub">{{item.sub}}</view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="rt-page">{{bannerCurrent + 1}}/{{banners.length}}</view>
    </view>

    <!-- 教程与创作案例 -->
    <view class="tut-head">
      <view class="tut-line"></view>
      <text class="tut-title">教程与创作案例</text>
      <view class="tut-line"></view>
    </view>

    <scroll-view class="tut-scroll" scroll-x enable-flex enhanced show-scrollbar="{{false}}">
      <view class="tut-card" wx:for="{{tutorials}}" wx:key="id" bindtap="onTapTutorial" data-id="{{item.id}}">
        <image class="tut-cover" src="{{item.image}}" mode="aspectFill"></image>
        <view class="tut-name">{{item.title}}</view>
      </view>
    </scroll-view>

    <!-- 静态声明动态图片，防止上传打包器将首页素材误判为未使用文件 -->
    <view class="home-asset-manifest" aria-hidden="true">
      <image src="/assets/home/video-mix-banner.jpg"></image>
      <image src="/assets/home/role-transfer-banner.jpg"></image>
      <image src="/assets/home/tutorial-image-creation.jpg"></image>
      <image src="/assets/home/tutorial-video-analysis.jpg"></image>
      <image src="/assets/home/tutorial-digital-human.jpg"></image>
    </view>

    <view class="build-version">版本 v0.056</view>
    <view class="bottom-safe"></view>
  </view>

  <view wx:if="{{videoIp12PromptVisible}}" class="ip12-prompt-mask" catchtap="skipVideoIp12Prompt">
    <view class="ip12-prompt" catchtap="keepVideoIp12Prompt">
      <button class="ip12-prompt-skip" bindtap="skipVideoIp12Prompt" aria-label="暂时跳过">跳过</button>
      <view class="ip12-prompt-kicker">让每条视频更像你</view>
      <view class="ip12-prompt-title">先建立数字化 IP 档案？</view>
      <view class="ip12-prompt-copy">完成定位、受众与内容方向后，AI 能为后续视频创作提供更贴合你的建议。现在不方便，也可以直接继续。</view>
      <button class="ip12-prompt-primary" bindtap="createIp12BeforeVideo">去创建档案</button>
      <button class="ip12-prompt-secondary" bindtap="continueToVideo">继续创作</button>
    </view>
  </view>
</view>
