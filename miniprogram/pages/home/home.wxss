.home { min-height: 100vh; color: var(--text); }
.brandbar { display: flex; align-items: center; justify-content: space-between; padding: calc(116rpx + env(safe-area-inset-top)) 190rpx 18rpx 32rpx; }
.brand-lockup { display: flex; align-items: center; gap: 14rpx; }
.brand-seal { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border: 1rpx solid var(--primary); border-radius: 18rpx; color: var(--primary); font: 34rpx "Songti SC", "STSong", serif; transform: rotate(-4deg); }
.brand { font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-tagline { margin-top: 3rpx; color: var(--text-soft); font-size: 15rpx; font-weight: 600; letter-spacing: 2rpx; }
.pts { min-height: 56rpx; box-sizing: border-box; padding: 13rpx 20rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--text); background: rgba(255,255,255,.62); font-size: 21rpx; font-weight: 600; }
.content { padding: 0 28rpx; }
.home-intro { padding: 30rpx 4rpx 32rpx; }
.eyebrow { display: flex; align-items: center; gap: 10rpx; color: var(--primary); font-size: 20rpx; font-weight: 600; letter-spacing: 1rpx; }
.eyebrow-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 7rpx var(--primary-soft); }
.home-title { margin-top: 24rpx; font: 700 54rpx/1.2 -apple-system, "PingFang SC", sans-serif; letter-spacing: -2rpx; }
.title-second { display: block; color: var(--primary-ink); }
.home-copy { margin-top: 18rpx; color: var(--text-muted); font-size: 24rpx; line-height: 1.65; }

.home .paper-entry { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 190rpx; margin: 0; padding: 28rpx; border: 0; border-radius: 28rpx; color: #fffdf8; text-align: left; background: linear-gradient(138deg, #1d211d 0%, #303a32 100%); box-shadow: 0 22rpx 54rpx rgba(31,37,32,.20); }
.paper-entry::after { border: 0; }
.entry-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 22rpx; border-radius: 22rpx; background: rgba(255,255,255,.12); flex: none; }
.entry-icon image { width: 36rpx; height: 36rpx; }
.entry-main { flex: 1; min-width: 0; }
.paper-entry-kicker { color: #d8bc7a; font-size: 19rpx; font-weight: 600; letter-spacing: 1rpx; }
.paper-entry-title { margin-top: 10rpx; font-size: 31rpx; font-weight: 700; }
.paper-entry-copy { margin-top: 8rpx; color: rgba(255,255,255,.62); font-size: 20rpx; line-height: 1.5; }
.entry-arrow { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-left: 14rpx; border-radius: 50%; color: #1d211d; background: #f2d995; font-size: 28rpx; flex: none; }

.section-head { display: flex; align-items: center; justify-content: space-between; margin: 44rpx 2rpx 20rpx; }
.section-title { font-size: 31rpx; font-weight: 700; letter-spacing: -1rpx; }
.section-note { color: var(--text-soft); font-size: 20rpx; }
.primary-card { position: relative; display: flex; align-items: center; min-height: 222rpx; box-sizing: border-box; padding: 30rpx; overflow: hidden; border: 1rpx solid #d8d2c7; border-radius: 26rpx; background: rgba(255,255,255,.82); box-shadow: 0 12rpx 34rpx rgba(46,45,39,.07); }
.primary-copy { position: relative; z-index: 2; flex: 1; min-width: 0; }
.card-kicker { color: var(--primary); font-size: 16rpx; font-weight: 700; letter-spacing: 2rpx; }
.pc-title { margin-top: 12rpx; font-size: 34rpx; font-weight: 700; }
.pc-sub { width: 390rpx; margin-top: 9rpx; color: var(--text-muted); font-size: 21rpx; line-height: 1.5; }
.pc-price { display: inline-flex; margin-top: 22rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--primary-ink); background: var(--primary-soft); font-size: 18rpx; font-weight: 600; }
.video-orb { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; margin-left: 12rpx; border-radius: 38rpx; background: linear-gradient(145deg, #a77b31, #72501d); box-shadow: 14rpx 16rpx 0 #eadfc8; transform: rotate(5deg); flex: none; }
.video-orb image { width: 42rpx; height: 42rpx; }

.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 16rpx; }
.mini-card { min-height: 246rpx; box-sizing: border-box; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: rgba(255,255,255,.72); }
.mc-video { border-color: #ced8cf; background: #e8eee7; }
.mini-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-bottom: 28rpx; border-radius: 18rpx; }
.image-icon { background: var(--primary-soft); }
.image-icon image { width: 38rpx; height: 38rpx; }
.follow-icon { color: #fff; background: var(--accent); font-size: 29rpx; }
.mc-title { font-size: 25rpx; font-weight: 700; }
.mc-sub { min-height: 62rpx; margin-top: 10rpx; color: var(--text-muted); font-size: 19rpx; line-height: 1.55; }
.mini-link { margin-top: 18rpx; color: var(--primary-ink); font-size: 19rpx; font-weight: 600; }
.mc-video .mini-link { color: #41564b; }

.dh-entry { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: rgba(255,255,255,.55); }
.dh-avatar { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; color: #53635a; background: #e2e8e2; font: 32rpx "Songti SC", serif; flex: none; }
.dh-copy { flex: 1; min-width: 0; }
.dh-title { font-size: 25rpx; font-weight: 700; }
.dh-sub { margin-top: 6rpx; overflow: hidden; color: var(--text-muted); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.dh-cta { color: var(--primary-ink); font-size: 19rpx; font-weight: 600; flex: none; }

.editorial-head { margin-top: 48rpx; }
.rt-swiper-wrap { position: relative; height: 210rpx; overflow: hidden; border: 1rpx solid #d8d1c6; border-radius: 26rpx; background: #e9e1d2; }
.rt-swiper { height: 210rpx; }
.rt-banner { display: flex; align-items: center; box-sizing: border-box; height: 100%; padding: 26rpx 28rpx; gap: 18rpx; }
.rt-text { position: relative; z-index: 2; flex: 1; min-width: 0; }
.rt-kicker { color: var(--primary); font-size: 16rpx; font-weight: 700; letter-spacing: 2rpx; }
.rt-title { margin-top: 12rpx; font-size: 29rpx; font-weight: 700; }
.rt-sub { margin-top: 8rpx; color: var(--text-muted); font-size: 19rpx; line-height: 1.5; }
.rt-page { position: absolute; right: 22rpx; bottom: 14rpx; color: var(--text-soft); font-size: 17rpx; font-variant-numeric: tabular-nums; }
.banner-art { position: relative; width: 118rpx; height: 138rpx; flex: none; }
.art-sheet { position: absolute; display: flex; align-items: center; justify-content: center; width: 92rpx; height: 116rpx; border: 1rpx solid #bead8d; border-radius: 12rpx; color: #89714a; background: #fffaf0; }
.art-sheet.back { top: 10rpx; left: 15rpx; background: #d7c7aa; transform: rotate(11deg); }
.art-sheet.front { font: 40rpx "Songti SC", serif; transform: rotate(-6deg); box-shadow: 0 10rpx 24rpx rgba(91,70,37,.08); }

.tut-scroll { width: 100%; white-space: nowrap; }
.tut-card { display: inline-block; width: 238rpx; margin-right: 14rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 20rpx; background: rgba(255,255,255,.72); vertical-align: top; }
.tut-cover { position: relative; height: 176rpx; background: #e9dfcb; }
.cover-1 { background: #e2e9e3; }
.cover-2 { background: #ebe0db; }
.tut-number { position: absolute; left: 18rpx; top: 14rpx; color: var(--text-soft); font-size: 17rpx; font-weight: 700; }
.tut-symbol { display: flex; align-items: center; justify-content: center; height: 100%; color: #836a40; font: 62rpx "Songti SC", serif; }
.tut-edition { position: absolute; left: 18rpx; bottom: 13rpx; color: #8a806f; font-size: 11rpx; letter-spacing: 1rpx; }
.tut-name { padding: 17rpx 18rpx; overflow: hidden; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.tut-name text { color: var(--primary); }
.build-version { margin: 46rpx 0 0; color: var(--text-soft); text-align: center; font-size: 19rpx; }
.version-label { margin-top: 9rpx; font-size: 15rpx; opacity: .72; }
.bottom-safe { height: calc(144rpx + env(safe-area-inset-bottom)); }

.ip12-prompt-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 34rpx; background: rgba(23,27,23,.48); backdrop-filter: blur(8rpx); }
.ip12-prompt { position: relative; padding: 54rpx 32rpx 30rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: #fffdf8; box-shadow: 0 30rpx 90rpx rgba(24,28,24,.22); }
.ip12-prompt-skip { position: absolute; top: 12rpx; right: 18rpx; color: var(--text-muted); background: transparent; font-size: 22rpx; }
.ip12-prompt-kicker { color: var(--primary); font-size: 20rpx; font-weight: 600; }
.ip12-prompt-title { margin: 16rpx 0; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.ip12-prompt-copy { margin-bottom: 28rpx; color: var(--text-muted); font-size: 24rpx; line-height: 1.75; }
.ip12-prompt .ip12-prompt-primary, .ip12-prompt .ip12-prompt-secondary { width: 100%; margin-top: 14rpx; border-radius: 16rpx; font-size: 26rpx; }
.ip12-prompt-primary { color: #fff; background: var(--grad); }
.ip12-prompt-secondary { color: var(--text); background: var(--surface-muted); }
