/* 顶部黑色留白高度：集中定义，便于真机校准 */
.home {
  --top-spacer: 430rpx;      /* 沉浸式动态主视觉高度（不含状态栏安全区） */
  --edge: 32rpx;             /* 页面左右边距 */
  --gap: 22rpx;              /* 模块垂直间距 */
  --card-radius: 28rpx;
  min-height: 100vh;
  background: #07060c;
}

/* 顶部留白：状态栏安全区 + 自定义留白 */
.top-spacer {
  position: relative;
  overflow: hidden;
  height: calc(var(--top-spacer) + constant(safe-area-inset-top));
  height: calc(var(--top-spacer) + env(safe-area-inset-top));
  display: flex; align-items: flex-end;
  padding: 0 var(--edge) 26rpx;
  box-sizing: border-box;
}
.back-card {
  position: absolute; z-index: 8; left: var(--edge); top: 104rpx;
  display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx 12rpx 14rpx;
  border: 1rpx solid rgba(255,255,255,.13); border-radius: 999rpx;
  color: rgba(255,255,255,.86); background: rgba(7,6,12,.46); font-size: 22rpx;
}
.back-card-arrow { margin-top: -2rpx; color: #f0a54b; font-size: 36rpx; line-height: 24rpx; }
.hero-motion {
  position: absolute;
  left: var(--edge);
  right: var(--edge);
  bottom: 62rpx;
  height: 218rpx;
  perspective: 860rpx;
  transform-style: preserve-3d;
  pointer-events: none;
}

/* 紫黑空间裂谷：用极轻的镜头与光带运动替代原球体自转。 */
.cosmic-rift {
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  height: auto;
  overflow: hidden;
  border-radius: 0;
  perspective: 900rpx;
  transform-style: preserve-3d;
  background: #08040d;
  box-shadow: none;
}
.rift-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.94;
  transform-origin: 50% 54%;
  animation: riftCameraDrift 8.8s cubic-bezier(0.45, 0.08, 0.28, 0.98) infinite alternate;
}
.rift-art-echo {
  opacity: 0.22;
  filter: saturate(1.35) brightness(1.18);
  animation: energyEchoDrift 12.6s cubic-bezier(0.42, 0.06, 0.26, 0.98) infinite alternate-reverse;
}
.rift-depth {
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: -30rpx;
  height: 112rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(240, 48, 174, 0.23) 0%, rgba(107, 29, 156, 0.10) 44%, transparent 72%);
  filter: blur(13rpx);
  animation: riftDepthPulse 5.6s ease-in-out infinite;
}
.rift-glow {
  position: absolute;
  width: 230rpx;
  height: 90rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 72, 191, 0.28) 0%, rgba(133, 34, 192, 0.09) 50%, transparent 74%);
  filter: blur(12rpx);
  animation: riftGlowDrift 7.8s ease-in-out infinite alternate;
}
.rift-glow-left {
  left: 8%;
  bottom: 14rpx;
}
.rift-glow-right {
  right: 5%;
  bottom: 22rpx;
  opacity: 0.76;
  animation-delay: -3.9s;
}
.energy-volume {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transform-style: preserve-3d;
  pointer-events: none;
}
.energy-sheet {
  position: absolute;
  left: -34%;
  width: 168%;
  border-radius: 50%;
  box-sizing: border-box;
  transform-style: preserve-3d;
  transform-origin: 50% 50%;
}
.energy-sheet-back {
  top: 29%;
  height: 46%;
  opacity: 0.34;
  background: linear-gradient(104deg, transparent 7%, rgba(91, 50, 173, 0.08) 23%, rgba(237, 65, 189, 0.26) 49%, rgba(132, 60, 222, 0.10) 74%, transparent 93%);
  border-top: 1rpx solid rgba(209, 112, 255, 0.25);
  box-shadow: 0 -8rpx 30rpx rgba(168, 55, 220, 0.16), inset 0 12rpx 28rpx rgba(242, 76, 193, 0.08);
  filter: blur(10rpx);
  animation: energySheetBack 18s cubic-bezier(0.42, 0.05, 0.22, 0.98) infinite alternate;
}
.energy-sheet-mid {
  top: 39%;
  height: 34%;
  opacity: 0.48;
  background: linear-gradient(96deg, transparent 4%, rgba(251, 85, 201, 0.11) 30%, rgba(170, 75, 240, 0.28) 52%, rgba(255, 105, 208, 0.10) 70%, transparent 96%);
  border-top: 2rpx solid rgba(255, 117, 214, 0.38);
  border-bottom: 1rpx solid rgba(145, 93, 242, 0.18);
  box-shadow: 0 -5rpx 24rpx rgba(239, 64, 187, 0.20), inset 0 9rpx 20rpx rgba(119, 53, 214, 0.12);
  filter: blur(3rpx);
  animation: energySheetMid 13.6s cubic-bezier(0.36, 0.08, 0.24, 0.96) infinite alternate-reverse;
}
.energy-sheet-front {
  top: 49%;
  height: 38%;
  opacity: 0.32;
  background: linear-gradient(88deg, transparent 7%, rgba(166, 83, 244, 0.12) 28%, rgba(255, 73, 190, 0.24) 54%, rgba(119, 69, 230, 0.08) 76%, transparent 94%);
  border-bottom: 2rpx solid rgba(194, 102, 255, 0.28);
  box-shadow: 0 8rpx 30rpx rgba(111, 47, 198, 0.16);
  filter: blur(5rpx);
  animation: energySheetFront 15.2s cubic-bezier(0.40, 0.04, 0.26, 0.98) infinite alternate;
}
.energy-caustic {
  position: absolute;
  left: 50%;
  top: 47%;
  width: 440rpx;
  height: 170rpx;
  margin: -85rpx 0 0 -220rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 221, 246, 0.30) 0%, rgba(250, 77, 194, 0.20) 17%, rgba(140, 54, 218, 0.09) 44%, transparent 72%);
  filter: blur(14rpx);
  animation: energyCaustic 6.4s ease-in-out infinite alternate;
}
.energy-prism {
  position: absolute;
  left: -38%;
  top: 5%;
  width: 54%;
  height: 112%;
  opacity: 0;
  background: linear-gradient(108deg, transparent 10%, rgba(255, 255, 255, 0.09) 42%, rgba(255, 87, 198, 0.16) 51%, rgba(145, 99, 255, 0.09) 59%, transparent 88%);
  filter: blur(6rpx);
  transform: skewX(-13deg);
  animation: energyPrismPass 9.8s ease-in-out infinite;
}
.energy-flare {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 132rpx;
  height: 132rpx;
  margin: -66rpx 0 0 -66rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.96) 0%, rgba(255, 214, 246, 0.70) 8%, rgba(255, 93, 205, 0.38) 22%, rgba(137, 66, 235, 0.16) 43%, transparent 72%);
  filter: blur(7rpx);
  animation: energyFlare 4.8s ease-in-out infinite;
}
.energy-rift-frame {
  position: absolute;
  left: 50%;
  top: 45%;
  width: 610rpx;
  height: 230rpx;
  margin: -115rpx 0 0 -305rpx;
  transform-style: preserve-3d;
  pointer-events: none;
  animation: riftFrameBreathe 5.6s ease-in-out infinite alternate;
}
.rift-arc {
  position: absolute;
  top: 50%;
  width: 270rpx;
  height: 118rpx;
  margin-top: -59rpx;
  border-radius: 50%;
  box-sizing: border-box;
  filter: drop-shadow(0 0 8rpx rgba(255, 72, 202, 0.84));
}
.rift-arc-left {
  left: -28rpx;
  border-top: 3rpx solid rgba(255, 140, 225, 0.82);
  border-left: 1rpx solid rgba(159, 91, 255, 0.34);
  transform-origin: 100% 50%;
  animation: riftArcLeft 7.2s cubic-bezier(0.38, 0.06, 0.22, 0.96) infinite alternate;
}
.rift-arc-right {
  right: -28rpx;
  border-bottom: 3rpx solid rgba(190, 105, 255, 0.76);
  border-right: 1rpx solid rgba(255, 83, 198, 0.38);
  transform-origin: 0 50%;
  animation: riftArcRight 8.4s cubic-bezier(0.36, 0.05, 0.24, 0.98) infinite alternate-reverse;
}
.rift-arc-crown {
  left: 50%;
  top: 50%;
  width: 420rpx;
  height: 132rpx;
  margin: -66rpx 0 0 -210rpx;
  border-top: 2rpx solid rgba(255, 197, 237, 0.62);
  border-bottom: 2rpx solid rgba(119, 86, 247, 0.30);
  box-shadow: 0 -10rpx 28rpx rgba(255, 61, 190, 0.22), inset 0 8rpx 24rpx rgba(158, 67, 230, 0.14);
  animation: riftArcCrown 10.2s ease-in-out infinite alternate;
}
.energy-axis {
  position: absolute;
  left: 50%;
  top: -10%;
  width: 54rpx;
  height: 112%;
  margin-left: -27rpx;
  opacity: 0.58;
  background: linear-gradient(90deg, transparent 0%, rgba(126, 83, 245, 0.08) 22%, rgba(255, 238, 252, 0.78) 49%, rgba(255, 87, 198, 0.16) 70%, transparent 100%);
  filter: blur(8rpx);
  transform-origin: 50% 46%;
  animation: energyAxis 5.2s ease-in-out infinite alternate;
}
.portal-rings {
  position: absolute;
  left: 50%;
  top: 45%;
  width: 2rpx;
  height: 2rpx;
  transform-style: preserve-3d;
  pointer-events: none;
}
.portal-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  box-sizing: border-box;
  filter: drop-shadow(0 0 7rpx rgba(255, 80, 198, 0.88));
}
.portal-ring-horizontal {
  width: 300rpx;
  height: 104rpx;
  margin: -52rpx 0 0 -150rpx;
  border-top: 3rpx solid rgba(255, 220, 247, 0.90);
  border-right: 2rpx solid rgba(255, 73, 194, 0.42);
  border-bottom: 2rpx solid rgba(124, 89, 247, 0.52);
  border-left: 1rpx solid rgba(255, 255, 255, 0.12);
  animation: portalRingHorizontal 9.4s linear infinite;
}
.portal-ring-vertical {
  width: 118rpx;
  height: 266rpx;
  margin: -133rpx 0 0 -59rpx;
  border-top: 2rpx solid rgba(255, 116, 211, 0.48);
  border-right: 3rpx solid rgba(181, 119, 255, 0.82);
  border-bottom: 1rpx solid rgba(255, 224, 248, 0.32);
  border-left: 2rpx solid rgba(255, 73, 193, 0.38);
  animation: portalRingVertical 12.8s linear infinite reverse;
}
.energy-shockwaves {
  position: absolute;
  left: 50%;
  top: 45%;
  width: 2rpx;
  height: 2rpx;
  transform-style: preserve-3d;
  pointer-events: none;
}
.shockwave {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 190rpx;
  height: 82rpx;
  margin: -41rpx 0 0 -95rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 156, 225, 0.74);
  box-shadow: 0 0 16rpx rgba(255, 71, 192, 0.46), inset 0 0 14rpx rgba(126, 74, 239, 0.28);
  opacity: 0;
  transform: rotateX(64deg) scale(0.36);
  animation: energyShockwave 4.8s cubic-bezier(0.18, 0.66, 0.24, 1) infinite;
}
.shockwave-two { animation-delay: -1.6s; border-color: rgba(156, 115, 255, 0.68); }
.shockwave-three { animation-delay: -3.2s; border-color: rgba(255, 101, 205, 0.56); }
.warp-streak {
  position: absolute;
  left: 50%;
  top: 45%;
  width: 150rpx;
  height: 2rpx;
  border-radius: 50%;
  opacity: 0;
  transform-origin: 0 50%;
  background: linear-gradient(90deg, rgba(255,255,255,0.94), rgba(255,92,205,0.62) 18%, rgba(138,84,248,0.18) 58%, transparent 100%);
  filter: drop-shadow(0 0 5rpx rgba(255, 72, 194, 0.72));
  animation: warpStreak 5.8s ease-out infinite;
}
.warp-streak-one { margin: -76rpx 0 0 -250rpx; transform: rotate(203deg); animation-delay: -0.8s; }
.warp-streak-two { margin: 48rpx 0 0 -278rpx; transform: rotate(166deg); animation-delay: -2.2s; }
.warp-streak-three { margin: -94rpx 0 0 82rpx; transform: rotate(-22deg); animation-delay: -3.7s; }
.warp-streak-four { margin: 62rpx 0 0 70rpx; transform: rotate(18deg); animation-delay: -4.6s; }
.warp-streak-five { margin: -116rpx 0 0 -34rpx; transform: rotate(-86deg); animation-delay: -1.5s; }
.warp-streak-six { margin: 94rpx 0 0 16rpx; transform: rotate(86deg); animation-delay: -3s; }
.rift-particle-field {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 2rpx;
  border-radius: 50%;
  background: rgba(255, 210, 240, 0.86);
  box-shadow:
    -298rpx -52rpx 0 rgba(255, 136, 213, 0.48),
    -250rpx 58rpx 0 rgba(190, 109, 250, 0.46),
    -206rpx -22rpx 0 rgba(255, 196, 233, 0.62),
    -154rpx 76rpx 0 rgba(255, 93, 195, 0.56),
    -102rpx -69rpx 0 rgba(208, 138, 255, 0.54),
    -54rpx 61rpx 0 rgba(255, 196, 235, 0.64),
    46rpx -63rpx 0 rgba(255, 143, 216, 0.56),
    98rpx 75rpx 0 rgba(197, 119, 255, 0.48),
    146rpx -28rpx 0 rgba(255, 202, 237, 0.68),
    207rpx 56rpx 0 rgba(255, 94, 197, 0.55),
    252rpx -58rpx 0 rgba(203, 132, 255, 0.48),
    294rpx 22rpx 0 rgba(255, 187, 230, 0.60);
  animation: riftParticlesFlow 6.2s ease-in-out infinite alternate;
}
.rift-stars {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.36;
  background:
    radial-gradient(circle at 13% 29%, rgba(255, 209, 240, 0.84) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 31% 18%, rgba(216, 159, 255, 0.68) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 72% 24%, rgba(255, 176, 226, 0.74) 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 87% 39%, rgba(229, 190, 255, 0.70) 0 1rpx, transparent 2rpx);
  animation: riftStarsBreathe 6.6s ease-in-out infinite alternate;
}
.rift-vignette {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  background:
    linear-gradient(180deg, rgba(4, 2, 9, 0.22) 0%, transparent 24%, transparent 54%, rgba(5, 2, 9, 0.84) 100%),
    linear-gradient(90deg, rgba(7, 3, 12, 0.64) 0%, transparent 16%, transparent 84%, rgba(7, 3, 12, 0.64) 100%);
  box-shadow: inset 0 0 46rpx rgba(0, 0, 0, 0.44);
}
.hero-center-logo {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 142rpx;
  height: 128rpx;
  margin: -64rpx 0 0 -71rpx;
  z-index: 5;
  opacity: 0;
  transform-origin: 50% 52%;
  animation: heroLogoReveal 4.6s cubic-bezier(0.22, 0.72, 0.20, 1) 0.45s forwards;
}
.hero-center-logo-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  filter: drop-shadow(0 0 8rpx rgba(255, 218, 126, 0.76)) drop-shadow(0 0 24rpx rgba(238, 116, 48, 0.28));
  animation: heroLogoFloat 5.8s ease-in-out 5.05s infinite alternate;
}
.hero-center-logo-aura {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 280rpx;
  height: 204rpx;
  margin: -102rpx 0 0 -140rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 223, 133, 0.36) 0%, rgba(245, 126, 52, 0.16) 24%, rgba(226, 67, 169, 0.12) 48%, transparent 74%);
  filter: blur(15rpx);
  animation: heroLogoAura 4.8s ease-in-out 2.4s infinite alternate;
}
.hero-center-logo-shimmer {
  position: absolute;
  left: -44rpx;
  top: -18rpx;
  width: 22rpx;
  height: 132rpx;
  opacity: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 235, 177, 0.72), transparent);
  filter: blur(3rpx);
  transform: rotate(18deg);
  animation: heroLogoShimmer 7.2s ease-in-out 3.2s infinite;
}

@keyframes riftCameraDrift {
  0% { transform: translate3d(-14rpx, 5rpx, 0) scale(1.04); filter: saturate(0.90) brightness(0.84); }
  32% { transform: translate3d(7rpx, -3rpx, 0) scale(1.075); filter: saturate(1.06) brightness(0.96); }
  68% { transform: translate3d(-5rpx, -7rpx, 0) scale(1.10); filter: saturate(1.14) brightness(1.03); }
  100% { transform: translate3d(15rpx, 3rpx, 0) scale(1.055); filter: saturate(0.98) brightness(0.90); }
}
@keyframes energyEchoDrift {
  0% { opacity: 0.09; transform: translate3d(20rpx, -5rpx, 0) scale(1.08, 1.03); }
  42% { opacity: 0.26; transform: translate3d(-9rpx, 4rpx, 0) scale(1.03, 1.10); }
  100% { opacity: 0.13; transform: translate3d(-22rpx, -2rpx, 0) scale(1.09, 1.04); }
}
@keyframes energySheetBack {
  0% { transform: translate3d(-76rpx, 18rpx, -90rpx) rotateX(58deg) rotateZ(-7deg) scaleX(0.86); opacity: 0.18; }
  38% { transform: translate3d(14rpx, -8rpx, -54rpx) rotateX(66deg) rotateZ(2deg) scaleX(1.02); opacity: 0.40; }
  100% { transform: translate3d(82rpx, -17rpx, -26rpx) rotateX(54deg) rotateZ(8deg) scaleX(1.13); opacity: 0.28; }
}
@keyframes energySheetMid {
  0% { transform: translate3d(72rpx, -10rpx, -12rpx) rotateX(63deg) rotateZ(6deg) scaleX(0.82); opacity: 0.22; }
  52% { transform: translate3d(-8rpx, 6rpx, 22rpx) rotateX(72deg) rotateZ(-2deg) scaleX(1.04); opacity: 0.56; }
  100% { transform: translate3d(-78rpx, 13rpx, 48rpx) rotateX(59deg) rotateZ(-8deg) scaleX(1.16); opacity: 0.34; }
}
@keyframes energySheetFront {
  0% { transform: translate3d(-88rpx, 15rpx, 32rpx) rotateX(69deg) rotateZ(-5deg) scaleX(0.88); opacity: 0.16; }
  44% { transform: translate3d(10rpx, -4rpx, 58rpx) rotateX(76deg) rotateZ(2deg) scaleX(1.08); opacity: 0.42; }
  100% { transform: translate3d(92rpx, -18rpx, 74rpx) rotateX(64deg) rotateZ(7deg) scaleX(1.18); opacity: 0.24; }
}
@keyframes energyCaustic {
  0% { opacity: 0.20; transform: translate3d(-18rpx, 8rpx, 0) scale3d(0.72, 0.76, 1); }
  100% { opacity: 0.76; transform: translate3d(20rpx, -9rpx, 0) scale3d(1.22, 1.08, 1); }
}
@keyframes energyPrismPass {
  0%, 16% { opacity: 0; transform: translateX(0) skewX(-13deg); }
  34% { opacity: 0.44; }
  62% { opacity: 0.08; transform: translateX(980rpx) skewX(-13deg); }
  100% { opacity: 0; transform: translateX(980rpx) skewX(-13deg); }
}
@keyframes energyFlare {
  0%, 100% { opacity: 0.34; transform: scale(0.62); }
  44% { opacity: 1; transform: scale(1.42); }
  58% { opacity: 0.62; transform: scale(0.94); }
}
@keyframes riftFrameBreathe {
  0% { opacity: 0.58; transform: translate3d(0, 5rpx, -10rpx) scale3d(0.90, 0.86, 1); }
  100% { opacity: 1; transform: translate3d(0, -7rpx, 34rpx) scale3d(1.08, 1.04, 1); }
}
@keyframes riftArcLeft {
  0% { transform: translate3d(-30rpx, 12rpx, -34rpx) rotateX(62deg) rotateZ(-14deg) scaleX(0.78); opacity: 0.32; }
  46% { transform: translate3d(10rpx, -8rpx, 18rpx) rotateX(72deg) rotateZ(4deg) scaleX(1.12); opacity: 0.94; }
  100% { transform: translate3d(38rpx, 4rpx, 44rpx) rotateX(58deg) rotateZ(13deg) scaleX(0.92); opacity: 0.58; }
}
@keyframes riftArcRight {
  0% { transform: translate3d(34rpx, -8rpx, -24rpx) rotateX(68deg) rotateZ(15deg) scaleX(0.82); opacity: 0.38; }
  52% { transform: translate3d(-12rpx, 7rpx, 28rpx) rotateX(76deg) rotateZ(-5deg) scaleX(1.16); opacity: 1; }
  100% { transform: translate3d(-42rpx, -3rpx, 48rpx) rotateX(60deg) rotateZ(-14deg) scaleX(0.90); opacity: 0.54; }
}
@keyframes riftArcCrown {
  0% { transform: translate3d(-22rpx, 9rpx, -46rpx) rotateX(70deg) rotateZ(-6deg) scaleX(0.84); opacity: 0.24; }
  50% { transform: translate3d(8rpx, -6rpx, 24rpx) rotateX(78deg) rotateZ(2deg) scaleX(1.18); opacity: 0.84; }
  100% { transform: translate3d(26rpx, 5rpx, 54rpx) rotateX(66deg) rotateZ(7deg) scaleX(0.96); opacity: 0.46; }
}
@keyframes energyAxis {
  0% { opacity: 0.18; transform: scale3d(0.36, 0.76, 1) rotate(1deg); }
  44% { opacity: 0.78; transform: scale3d(1.20, 1.04, 1) rotate(-1deg); }
  100% { opacity: 0.38; transform: scale3d(0.64, 1.18, 1) rotate(2deg); }
}
@keyframes portalRingHorizontal {
  0% { transform: rotateX(68deg) rotateZ(0deg) scale(0.92); opacity: 0.46; }
  50% { transform: rotateX(74deg) rotateZ(180deg) scale(1.08); opacity: 0.96; }
  100% { transform: rotateX(68deg) rotateZ(360deg) scale(0.92); opacity: 0.46; }
}
@keyframes portalRingVertical {
  0% { transform: rotateY(62deg) rotateZ(0deg) scale(0.90); opacity: 0.34; }
  50% { transform: rotateY(78deg) rotateZ(180deg) scale(1.10); opacity: 0.88; }
  100% { transform: rotateY(62deg) rotateZ(360deg) scale(0.90); opacity: 0.34; }
}
@keyframes energyShockwave {
  0% { opacity: 0; transform: rotateX(64deg) scale(0.34); }
  18% { opacity: 0.92; }
  72% { opacity: 0.16; }
  100% { opacity: 0; transform: rotateX(64deg) scale(3.15); }
}
@keyframes warpStreak {
  0%, 68% { opacity: 0; width: 18rpx; filter: blur(2rpx); }
  76% { opacity: 0.92; width: 86rpx; filter: blur(0); }
  92% { opacity: 0.20; width: 210rpx; }
  100% { opacity: 0; width: 260rpx; filter: blur(3rpx); }
}
@keyframes heroLogoReveal {
  0% { opacity: 0; transform: translate3d(0, 18rpx, 0) scale(0.68); filter: blur(12rpx); }
  38% { opacity: 0.34; }
  72% { opacity: 0.92; transform: translate3d(0, -2rpx, 0) scale(1.04); filter: blur(1rpx); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: blur(0); }
}
@keyframes heroLogoFloat {
  0% { transform: translate3d(-2rpx, 2rpx, 0) scale(0.98); }
  100% { transform: translate3d(2rpx, -3rpx, 0) scale(1.025); }
}
@keyframes heroLogoAura {
  0% { opacity: 0.30; transform: scale(0.82); }
  100% { opacity: 0.74; transform: scale(1.12); }
}
@keyframes heroLogoShimmer {
  0%, 24% { opacity: 0; transform: translateX(0) rotate(18deg); }
  38% { opacity: 0.58; }
  58% { opacity: 0; transform: translateX(188rpx) rotate(18deg); }
  100% { opacity: 0; transform: translateX(188rpx) rotate(18deg); }
}
@keyframes riftDepthPulse {
  0%, 100% { opacity: 0.34; transform: scaleX(0.84); }
  50% { opacity: 0.72; transform: scaleX(1.10); }
}
@keyframes riftGlowDrift {
  0% { opacity: 0.24; transform: translate3d(-16rpx, 3rpx, 0) scale(0.84); }
  100% { opacity: 0.72; transform: translate3d(20rpx, -4rpx, 0) scale(1.16); }
}
@keyframes riftStarsBreathe {
  0% { opacity: 0.14; transform: translateY(2rpx); }
  100% { opacity: 0.42; transform: translateY(-3rpx); }
}
@keyframes riftParticlesFlow {
  0% { opacity: 0.18; transform: translate3d(-12rpx, 8rpx, 0) scale(0.82); }
  100% { opacity: 0.72; transform: translate3d(18rpx, -10rpx, 0) scale(1.16); }
}

.brandbar { position: relative; z-index: 2; width: 100%; display: flex; align-items: center; justify-content: space-between; }
.brand-lockup { display: flex; flex-direction: column; gap: 5rpx; }
.brand { font-size: 34rpx; font-weight: 600; color: rgba(255,255,255,0.92); letter-spacing: 1rpx; }
.brand-tagline { font-size: 13rpx; color: rgba(255,255,255,0.34); letter-spacing: 2.6rpx; }
.pts {
  display: flex; align-items: center; gap: 6rpx;
  background: rgba(255,255,255,0.07); border: 1rpx solid rgba(255,255,255,0.1);
  padding: 10rpx 22rpx; border-radius: 40rpx; color: #f0a54b; font-size: 24rpx; font-weight: 600;
}
.pts-ic { width: 30rpx; height: 30rpx; }

.content { position: relative; padding: 0 var(--edge); }

.hero-content-blend {
  position: absolute;
  left: 0;
  right: 0;
  top: -82rpx;
  height: 116rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(226, 49, 169, 0.13) 0%, rgba(103, 34, 153, 0.06) 42%, transparent 72%),
    linear-gradient(180deg, transparent 0%, rgba(7, 6, 12, 0.58) 42%, #07060c 100%);
  filter: blur(1rpx);
  animation: heroContentBlend 5.8s ease-in-out infinite alternate;
}
@keyframes heroContentBlend {
  0% { opacity: 0.58; transform: scaleX(0.94); }
  100% { opacity: 0.92; transform: scaleX(1.04); }
}

/* ===== 功能矩阵 ===== */
.mosaic { position: relative; z-index: 1; display: flex; gap: var(--gap); margin-top: -14rpx; }
.primary-card {
  position: relative; width: 49%; box-sizing: border-box;
  min-height: 340rpx; border-radius: var(--card-radius);
  padding: 34rpx 30rpx; overflow: hidden;
  background: linear-gradient(150deg, #ff4d9d 0%, #b845e0 55%, #7a3ff0 100%);
  box-shadow: 0 -16rpx 44rpx rgba(184, 48, 181, 0.12), 0 18rpx 42rpx rgba(0, 0, 0, 0.24);
}
.pc-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.pc-sub { font-size: 24rpx; color: rgba(255,255,255,0.86); margin-top: 14rpx; line-height: 1.45; }
.pc-price {
  display: inline-block; margin-top: 14rpx; padding: 6rpx 14rpx; border-radius: 18rpx;
  background: rgba(0,0,0,.2); color: #fff; font-size: 22rpx; font-weight: 600;
}
.pc-icon-slot {
  position: absolute; left: 30rpx; bottom: 30rpx;
  width: 132rpx; height: 132rpx; border-radius: 50%;
  background: rgba(0,0,0,0.22); display: flex; align-items: center; justify-content: center;
}
.pc-icon { width: 108rpx; height: 108rpx; }

.right-col { width: 49%; display: flex; flex-direction: column; gap: var(--gap); }
.mini-card {
  position: relative; flex: 1; min-height: 159rpx; box-sizing: border-box;
  border-radius: var(--card-radius); padding: 26rpx 26rpx; overflow: hidden;
  display: flex; align-items: center;
  box-shadow: 0 -12rpx 36rpx rgba(121, 46, 167, 0.10), 0 14rpx 34rpx rgba(0, 0, 0, 0.22);
}
.mc-image { background: linear-gradient(145deg, #2a1740, #171022); }
.mc-video { background: linear-gradient(145deg, #3a1730, #1c1020); }
.mc-body { flex: 1; }
.mc-title { font-size: 30rpx; font-weight: 600; color: #fff; }
.tag {
  display: inline-block; margin-top: 14rpx; padding: 6rpx 16rpx; border-radius: 20rpx;
  font-size: 20rpx; color: #fff; font-weight: 500;
}
.tag-cyan { background: linear-gradient(135deg, #23c8c0, #2f8bed); }
.tag-orange { background: linear-gradient(135deg, #ff8a3d, #ff4d6d); }
.mc-icon { width: 92rpx; height: 92rpx; flex: none; margin-left: 12rpx; }

/* ===== 数字化 IP 入口 ===== */
.dh-entry {
  position: relative; margin-top: var(--gap); min-height: 150rpx;
  border-radius: var(--card-radius); padding: 30rpx 30rpx 30rpx 190rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(120deg, #2c1746, #1a1030);
}
.dh-avatar {
  position: absolute; left: 26rpx; bottom: 0; width: 150rpx; height: 190rpx;
  border-radius: 20rpx;
}
.dh-copy { display: flex; flex-direction: column; gap: 8rpx; }
.dh-title { font-size: 32rpx; font-weight: 600; color: #fff; }
.dh-cta { font-size: 25rpx; color: rgba(255,255,255,0.7); }

/* ===== 顶部轮播 Banner ===== */
.rt-swiper-wrap { position: relative; margin-top: var(--gap); height: 220rpx; }
.rt-swiper { height: 220rpx; }
.rt-banner {
  position: relative; height: 220rpx; border-radius: var(--card-radius); overflow: hidden;
  background: linear-gradient(135deg, #291440, #11101f);
}
/* 不用 inset：部分小程序渲染层热更新后不会稳定计算该简写，导致图片节点存在但没有铺满。 */
.rt-bg {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  width: 100%; height: 100%; display: block; z-index: 0;
}
.rt-mask {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 1;
  background: linear-gradient(90deg, rgba(10,8,16,0.82) 30%, rgba(10,8,16,0.15));
}
.rt-text { position: absolute; left: 34rpx; top: 50rpx; z-index: 2; }
.rt-title { font-size: 36rpx; font-weight: 700; color: #fff; }
.rt-sub { font-size: 23rpx; color: rgba(255,255,255,0.7); margin-top: 12rpx; }
.rt-page {
  position: absolute; right: 24rpx; bottom: 22rpx; z-index: 3;
  padding: 4rpx 18rpx; border-radius: 20rpx; background: rgba(10, 8, 16, 0.48);
  color: rgba(255, 255, 255, 0.82); font-size: 22rpx; pointer-events: none;
}

/* ===== 教程与创作案例 ===== */
.tut-head { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: 40rpx 0 24rpx; }
.tut-title { font-size: 30rpx; font-weight: 600; color: #ff4d9d; }
.tut-line { width: 90rpx; height: 2rpx; background: linear-gradient(90deg, transparent, rgba(255,77,157,0.7)); }
.tut-line:last-child { background: linear-gradient(90deg, rgba(255,77,157,0.7), transparent); }

.tut-scroll { white-space: nowrap; }
.tut-card {
  display: inline-block; width: 300rpx; margin-right: 20rpx; vertical-align: top;
  border-radius: 22rpx; overflow: hidden; background: var(--surface); border: 1rpx solid var(--line);
}
.tut-cover { width: 300rpx; height: 400rpx; display: block; background: var(--surface-muted); }
.tut-name { padding: 18rpx 20rpx; font-size: 25rpx; color: var(--text); white-space: normal; line-height: 1.4; }

.home-asset-manifest {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}
.home-asset-manifest > image { width: 1px; height: 1px; }

.build-version {
  margin-top: 34rpx;
  text-align: center;
  color: rgba(255,255,255,0.28);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.ip12-prompt-mask {
  position: fixed; z-index: 1000; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  padding: 48rpx; box-sizing: border-box;
  background: rgba(4, 3, 9, 0.72);
}
.ip12-prompt {
  position: relative; width: 100%; max-width: 620rpx; box-sizing: border-box;
  padding: 54rpx 42rpx 38rpx; border-radius: 34rpx;
  background: linear-gradient(155deg, #241335, #110c1c 72%);
  border: 1rpx solid rgba(255,255,255,0.13);
  box-shadow: 0 28rpx 80rpx rgba(0,0,0,0.46);
}
.ip12-prompt-skip {
  position: absolute; top: 18rpx; right: 20rpx; min-width: 96rpx;
  margin: 0; padding: 0 12rpx; border: 0; background: transparent;
  color: rgba(255,255,255,0.52); font-size: 23rpx; line-height: 54rpx;
}
.ip12-prompt-skip::after { border: 0; }
.ip12-prompt-kicker { color: #f5a5d4; font-size: 22rpx; letter-spacing: 2rpx; }
.ip12-prompt-title { margin-top: 14rpx; color: #fff; font-size: 38rpx; font-weight: 700; }
.ip12-prompt-copy { margin-top: 20rpx; color: rgba(255,255,255,0.68); font-size: 25rpx; line-height: 1.7; }
.ip12-prompt-primary,
.ip12-prompt-secondary {
  width: 100%; margin: 28rpx 0 0; border-radius: 999rpx;
  font-size: 28rpx; font-weight: 650; line-height: 88rpx;
}
.ip12-prompt-primary { color: #fff; background: linear-gradient(135deg, #ff4d9d, #8a47e8); }
.ip12-prompt-primary::after { border: 0; }
.ip12-prompt-secondary {
  margin-top: 16rpx; color: rgba(255,255,255,0.78);
  background: rgba(255,255,255,0.07); border: 1rpx solid rgba(255,255,255,0.12);
}
.ip12-prompt-secondary::after { border: 0; }

.bottom-safe { height: calc(150rpx + constant(safe-area-inset-bottom)); height: calc(150rpx + env(safe-area-inset-bottom)); }
