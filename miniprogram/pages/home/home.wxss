.home { min-height:100vh; color:var(--text); }
.brandbar { display:flex; align-items:center; justify-content:space-between; padding:calc(170rpx + env(safe-area-inset-top)) 34rpx 20rpx; }
.brand-lockup { display:flex; align-items:center; gap:15rpx; }
.brand-seal { width:65rpx; height:65rpx; border:1rpx solid var(--primary); border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--primary); font:40rpx "Songti SC","STSong",serif; }
.brand { font-size:29rpx; font-weight:600; letter-spacing:2rpx; }
.brand-tagline { margin-top:5rpx; color:var(--text-muted); font-size:18rpx; letter-spacing:2rpx; }
.pts { padding:12rpx 18rpx; border:1rpx solid var(--line); border-radius:999rpx; color:var(--primary); font-size:22rpx; }
.content { padding:0 32rpx; }
.home-intro { padding:40rpx 4rpx 36rpx; }
.eyebrow { color:var(--primary); font-size:17rpx; letter-spacing:2rpx; }
.home-title { margin-top:22rpx; font:58rpx/1.45 "Songti SC","STSong",serif; letter-spacing:2rpx; }
.title-second { display:block; }
.home-copy { margin-top:18rpx; font-size:24rpx; color:var(--text-muted); line-height:1.7; }
.home .paper-entry { display:block; box-sizing:border-box; width:100%; margin:0; padding:26rpx; text-align:left; border:1rpx solid #c8b894; border-radius:20rpx; background:rgba(255,253,247,.65); color:var(--text); line-height:1.5; box-shadow:0 8rpx 24rpx rgba(92,70,37,.06); }
.paper-entry::after { border:0; }
.paper-entry-top,.paper-entry-bottom { display:flex; justify-content:space-between; align-items:center; gap:12rpx; }
.paper-entry-kicker { color:var(--primary); font-size:21rpx; }
.entry-star { font-size:30rpx; color:var(--primary); }
.paper-entry-title { margin:18rpx 0 26rpx; font:34rpx "Songti SC","STSong",serif; }
.paper-entry-copy { font-size:22rpx; color:var(--text-muted); }
.entry-arrow { width:54rpx; height:54rpx; border-radius:50%; background:var(--grad); color:#fff8e8; text-align:center; line-height:54rpx; font-size:30rpx; flex:none; }
.section-head { margin:38rpx 2rpx 22rpx; display:flex; align-items:center; justify-content:space-between; }
.section-title { font:32rpx "Songti SC","STSong",serif; }
.section-note { font-size:20rpx; color:var(--text-muted); }
.mosaic { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.primary-card { position:relative; min-height:292rpx; box-sizing:border-box; padding:26rpx; overflow:hidden; border:1rpx solid #cbbda3; border-radius:18rpx; background:#e6dbc4; }
.pc-title { font-size:31rpx; font-weight:600; }
.pc-sub { margin-top:9rpx; font-size:20rpx; color:var(--text-muted); }
.pc-price { position:absolute; bottom:22rpx; left:26rpx; color:var(--primary-ink); font-size:19rpx; }
.film-art { position:relative; margin:28rpx auto 20rpx; width:140rpx; height:110rpx; }
.film-frame { position:relative; z-index:1; width:120rpx; height:78rpx; border:2rpx solid #9e8960; border-radius:8rpx; background:#f5ecda; transform:rotate(-8deg); display:flex; align-items:center; justify-content:center; color:#8a7550; font-size:38rpx; box-shadow:5rpx 6rpx 0 #d0bfa0; }
.film-lines { position:absolute; top:22rpx; right:0; width:125rpx; height:80rpx; border:1rpx solid #b7a37d; border-radius:8rpx; transform:rotate(10deg); }
.right-col { display:flex; flex-direction:column; gap:16rpx; }
.mini-card { flex:1; display:flex; align-items:center; justify-content:space-between; gap:6rpx; padding:22rpx 20rpx; border:1rpx solid var(--line); border-radius:18rpx; background:rgba(255,253,247,.62); }
.mc-video { background:#e4e6d7; border-color:#c7cab6; }
.mc-title { font-size:25rpx; font-weight:600; }
.mc-sub { margin-top:12rpx; font-size:19rpx; color:var(--text-muted); line-height:1.5; }
.tool-mark { font-size:40rpx; color:var(--primary); flex:none; }
.dh-entry { margin-top:18rpx; padding:24rpx; display:flex; align-items:center; gap:20rpx; border:1rpx solid var(--line); border-radius:18rpx; background:rgba(255,253,247,.45); }
.dh-avatar { width:68rpx; height:68rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#e4ddca; color:#81744f; font:34rpx "Songti SC",serif; }
.dh-copy { flex:1; }.dh-title { font-size:27rpx; font-weight:600; }.dh-sub { margin-top:8rpx; font-size:21rpx; color:var(--text-muted); }.dh-cta { font-size:20rpx; color:var(--primary); }
.rt-swiper-wrap { position:relative; height:220rpx; margin-top:28rpx; border:1rpx solid var(--line); border-radius:18rpx; overflow:hidden; background:#ede2cd; }
.rt-swiper { height:220rpx; }
.rt-banner { height:100%; box-sizing:border-box; display:flex; align-items:center; padding:24rpx; gap:12rpx; }
.rt-text { position:relative; z-index:2; flex:1; min-width:0; }.rt-kicker { font-size:17rpx; letter-spacing:1rpx; color:var(--primary); }.rt-title { font:30rpx/1.5 "Songti SC","STSong",serif; margin-top:12rpx; }.rt-sub { margin-top:8rpx; font-size:20rpx; color:var(--text-muted); line-height:1.5; }.rt-page { position:absolute; right:20rpx; bottom:10rpx; color:var(--text-muted); font-size:18rpx; }
.banner-art { width:118rpx; height:145rpx; position:relative; flex:none; }.art-sheet { position:absolute; width:94rpx; height:120rpx; border:1rpx solid #bead8d; border-radius:4rpx; background:#faf4e5; }.art-sheet.back { transform:rotate(12deg); top:10rpx; left:12rpx; background:#daceb5; }.art-sheet.front { transform:rotate(-7deg); display:flex; align-items:center; justify-content:center; color:#998057; font:44rpx "Songti SC",serif; }
.tut-scroll { white-space:nowrap; width:100%; }.tut-card { display:inline-block; width:270rpx; margin-right:16rpx; border:1rpx solid var(--line); border-radius:12rpx; overflow:hidden; background:var(--surface); vertical-align:top; }.tut-cover { position:relative; height:230rpx; background:#e1d7c3; }.cover-1 { background:#dfe3d5; }.cover-2 { background:#e7d9cb; }.tut-number { position:absolute; left:20rpx; top:16rpx; font-size:20rpx; color:#8a795a; }.tut-symbol { display:flex; height:100%; align-items:center; justify-content:center; font:78rpx "Songti SC",serif; color:#968261; }.tut-edition { position:absolute; bottom:16rpx; left:20rpx; color:#8b7b60; font-size:13rpx; letter-spacing:2rpx; }.tut-name { padding:18rpx; font-size:22rpx; }
.build-version { margin:38rpx 0 0; text-align:center; color:var(--text-muted); font-size:20rpx; }.version-label { margin-top:10rpx; font-size:16rpx; opacity:.7; }.bottom-safe { height:calc(150rpx + env(safe-area-inset-bottom)); }
.ip12-prompt-mask { position:fixed; inset:0; z-index:100; background:rgba(44,39,30,.45); display:flex; align-items:center; justify-content:center; padding:34rpx; }
.ip12-prompt { position:relative; padding:54rpx 32rpx 30rpx; border:1rpx solid var(--line); border-radius:24rpx; background:#f7efdf; box-shadow:0 16rpx 60rpx rgba(92,70,37,.15); }
.ip12-prompt-skip { position:absolute; top:12rpx; right:18rpx; background:transparent; color:var(--text-muted); font-size:22rpx; }.ip12-prompt-kicker { color:var(--primary); font-size:21rpx; }.ip12-prompt-title { margin:16rpx 0; font:36rpx/1.4 "Songti SC",serif; }.ip12-prompt-copy { color:var(--text-muted); font-size:25rpx; line-height:1.8; margin-bottom:28rpx; }.ip12-prompt .ip12-prompt-primary,.ip12-prompt .ip12-prompt-secondary { width:100%; margin-top:14rpx; font-size:27rpx; border-radius:12rpx; }.ip12-prompt-primary { background:var(--grad); color:#fff8e8; }.ip12-prompt-secondary { background:var(--surface-muted); color:var(--primary-ink); }
