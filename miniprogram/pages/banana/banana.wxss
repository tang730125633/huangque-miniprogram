.small { font-size: 22rpx; }
.ph { color: #6f6980; }

.points-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 28rpx; margin-bottom: 24rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  border-radius: 18rpx;
}
.points-num { font-size: 40rpx; font-weight: 500; color: var(--secondary); }
.pb-left { display: flex; align-items: center; }
.ic-up { width: 52rpx; height: 52rpx; }

.prompt {
  width: 100%; box-sizing: border-box; min-height: 150rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  border-radius: 14rpx; padding: 22rpx; color: var(--text); font-size: 28rpx;
}

/* 模板即出图 */
.prompt-helper { overflow: hidden; }
.prompt-helper-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.helper-title { margin-bottom: 4rpx; }
.helper-sub { line-height: 1.45; }
.prompt-undo { flex: none; color: var(--primary); font-size: 23rpx; padding: 8rpx 16rpx; border: 1rpx solid var(--primary); border-radius: 30rpx; }
.prompt-template-scroll { width: 100%; margin: 20rpx 0 16rpx; white-space: nowrap; }
.prompt-template-row { display: inline-flex; gap: 12rpx; padding-right: 18rpx; }
.prompt-template-chip { display: inline-block; padding: 14rpx 22rpx; border-radius: 30rpx; background: var(--surface-muted); border: 1rpx solid var(--line); color: var(--text-muted); font-size: 23rpx; }
.prompt-template-chip.on { background: var(--primary-soft); border-color: var(--primary); color: var(--primary-ink); }
.prompt-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.prompt-field { box-sizing: border-box; width: 100%; height: 76rpx; padding: 0 18rpx; border-radius: 12rpx; background: var(--surface-muted); border: 1rpx solid var(--line); color: var(--text); font-size: 24rpx; }
.prompt-apply { margin-top: 16rpx; padding: 19rpx 20rpx; border-radius: 14rpx; text-align: center; color: #fff; font-size: 26rpx; font-weight: 600; background: linear-gradient(100deg, #d83bcc, #7b46ff); }

.draft-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: -8rpx 8rpx 24rpx; color: var(--text-muted); font-size: 22rpx; }
.draft-row.error { color: #c2413a; }
.draft-age { opacity: .75; }
.draft-clear { flex: none; color: var(--primary); padding: 8rpx 0 8rpx 18rpx; }

.upbox {
  height: 180rpx; border: 2rpx dashed var(--line); border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  background: var(--surface-muted);
}
.up-plus { font-size: 46rpx; color: var(--text-muted); }
.ref-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ref-clear-all { color: var(--primary); font-size: 22rpx; padding: 8rpx 0 8rpx 16rpx; }
.ref-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.ref-grid.single { grid-template-columns: 1fr; }
.ref-cell { position: relative; min-height: 220rpx; border-radius: 16rpx; overflow: hidden; background: var(--surface-muted); border: 1rpx solid var(--line); }
.ref-img { width: 100%; height: 220rpx; display: block; }
.ref-index { position: absolute; left: 10rpx; bottom: 10rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: rgba(25,28,26,.68); color: #fff; font-size: 20rpx; }
.ref-del { position: absolute; top: 10rpx; right: 10rpx; width: 44rpx; height: 44rpx; line-height: 42rpx; text-align: center; border-radius: 50%; background: rgba(25,28,26,.68); color: #fff; font-size: 23rpx; }
.ref-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; border-style: dashed; }
.ref-saving { padding: 24rpx; text-align: center; border-radius: 14rpx; background: var(--surface-muted); }
.ref-help { margin-top: 12rpx; line-height: 1.5; }
.mention-menu { margin-top: 10rpx; padding: 8rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface-muted); }
.mention-item { display: grid; grid-template-columns: 54rpx 1fr auto; align-items: center; gap: 14rpx; padding: 10rpx; border-radius: 10rpx; color: var(--text); font-size: 24rpx; }
.mention-item image { width: 54rpx; height: 54rpx; border-radius: 8rpx; }
.mention-token { color: var(--primary); font-size: 21rpx; }

.engine-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.engine {
  padding: 20rpx 14rpx; border-radius: 16rpx; text-align: center;
  color: var(--text-muted); background: var(--surface-muted); border: 1rpx solid var(--line);
}
.engine.active { color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary); }
.engine-name { font-weight: 600; font-size: 26rpx; }
.engine-desc { font-size: 21rpx; margin-top: 6rpx; opacity: 0.85; }

.ratio-grid { grid-template-columns: repeat(4, 1fr); }
.q-grid { grid-template-columns: 1fr 1fr; }

.row2 { display: flex; gap: 26rpx; }
.col { flex: 1; }
.count-row { display: flex; align-items: center; gap: 16rpx; }
.count-btn {
  width: 76rpx; height: 76rpx; line-height: 72rpx; text-align: center;
  border-radius: 14rpx; border: 1rpx solid var(--line);
  background: var(--surface-muted); color: var(--text-muted); font-size: 36rpx;
}
.count-val {
  flex: 1; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: 14rpx; border: 1rpx solid var(--primary);
  background: var(--primary-soft); color: var(--primary-ink); font-weight: 600; font-size: 30rpx;
}

.note { text-align: center; font-size: 24rpx; margin: 18rpx 0 30rpx; }

.result-img { width: 100%; border-radius: 16rpx; }
.thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 16rpx; }
.thumb { width: 100%; height: 130rpx; border-radius: 12rpx; border: 3rpx solid transparent; }
.thumb.active { border-color: var(--primary); }
.result-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ghost-btn {
  flex: 1; text-align: center; padding: 20rpx; border-radius: 14rpx;
  border: 1rpx solid var(--primary); color: var(--primary); font-size: 26rpx;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
}

.history-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.history-img { width: 100%; height: 220rpx; border-radius: 12rpx; }

.empty-state { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 60rpx 0; }

.ai-disclosure { margin: 12rpx 8rpx 4rpx; text-align: center; color: var(--text-muted); font-size: 21rpx; line-height: 1.6; }
.ai-badge { margin-left: 10rpx; padding: 3rpx 10rpx; border-radius: 999rpx; background: rgba(226,75,160,.16); color: #ff8dca; font-size: 19rpx; font-weight: 500; }
