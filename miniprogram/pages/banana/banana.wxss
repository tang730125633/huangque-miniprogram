.small { font-size: 22rpx; }
.ph { color: #6f6980; }

.points-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 28rpx; margin-bottom: 24rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  border-radius: 18rpx;
}
.points-num { font-size: 40rpx; font-weight: 500; color: var(--secondary); }
.pb-left { display: flex; align-items: center; }
.ic-up { width: 52rpx; height: 52rpx; }

.prompt {
  width: 100%; box-sizing: border-box; min-height: 150rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  border-radius: 14rpx; padding: 22rpx; color: var(--text); font-size: 28rpx;
}

.upbox {
  height: 180rpx; border: 2rpx dashed var(--line); border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  background: var(--surface-muted);
}
.up-plus { font-size: 46rpx; color: var(--text-muted); }
.up-preview { position: relative; }
.up-img { width: 100%; height: 300rpx; border-radius: 16rpx; }
.up-clear {
  position: absolute; top: 14rpx; right: 14rpx;
  background: rgba(25,28,26,0.6); color: #fff; font-size: 23rpx;
  padding: 6rpx 16rpx; border-radius: 10rpx;
}

.engine-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.engine {
  padding: 20rpx 14rpx; border-radius: 16rpx; text-align: center;
  color: var(--text-muted); background: var(--surface-muted); border: 1rpx solid var(--line);
}
.engine.active { color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary); }
.engine-name { font-weight: 600; font-size: 26rpx; }
.engine-desc { font-size: 21rpx; margin-top: 6rpx; opacity: 0.85; }

.ratio-grid { grid-template-columns: repeat(4, 1fr); }
.q-grid { grid-template-columns: 1fr 1fr; }

.row2 { display: flex; gap: 26rpx; }
.col { flex: 1; }
.count-row { display: flex; align-items: center; gap: 16rpx; }
.count-btn {
  width: 76rpx; height: 76rpx; line-height: 72rpx; text-align: center;
  border-radius: 14rpx; border: 1rpx solid var(--line);
  background: var(--surface-muted); color: var(--text-muted); font-size: 36rpx;
}
.count-val {
  flex: 1; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: 14rpx; border: 1rpx solid var(--primary);
  background: var(--primary-soft); color: var(--primary-ink); font-weight: 600; font-size: 30rpx;
}

.note { text-align: center; font-size: 24rpx; margin: 18rpx 0 30rpx; }

.result-img { width: 100%; border-radius: 16rpx; }
.thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 16rpx; }
.thumb { width: 100%; height: 130rpx; border-radius: 12rpx; border: 3rpx solid transparent; }
.thumb.active { border-color: var(--primary); }
.result-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ghost-btn {
  flex: 1; text-align: center; padding: 20rpx; border-radius: 14rpx;
  border: 1rpx solid var(--primary); color: var(--primary); font-size: 26rpx;
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
}

.history-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.history-img { width: 100%; height: 220rpx; border-radius: 12rpx; }

.empty-state { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 60rpx 0; }
