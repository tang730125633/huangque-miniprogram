<view class="container">

  <!-- 点数条 -->
  <view class="points-bar">
    <view class="pb-left">
      <image class="ic-coin" src="../../assets/icons/coin.svg"></image>
      <text class="muted">当前点数</text>
    </view>
    <text class="points-num">{{points === null ? '—' : points}}</text>
  </view>

  <!-- 模板即出图：仅回填可编辑提示词，不会自动生成或扣点 -->
  <view class="card prompt-helper">
    <view class="prompt-helper-head">
      <view>
        <view class="label helper-title">模板润色</view>
        <view class="muted small helper-sub">选模板，填字段，一键生成可编辑提示词 · 免费</view>
      </view>
      <view wx:if="{{canUndoPrompt}}" class="prompt-undo" bindtap="undoPromptTemplate">撤销</view>
    </view>
    <scroll-view class="prompt-template-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="prompt-template-row">
        <view wx:for="{{promptTemplates}}" wx:key="key" data-k="{{item.key}}" bindtap="selectPromptTemplate"
          class="prompt-template-chip {{promptTemplateKey===item.key?'on':''}}">{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="prompt-fields">
      <input class="prompt-field" value="{{tplBrand}}" data-key="tplBrand" bindinput="onTemplateField" maxlength="30" placeholder="品牌 / 门店" placeholder-class="ph" />
      <input class="prompt-field" value="{{tplColor}}" data-key="tplColor" bindinput="onTemplateField" maxlength="30" placeholder="主色调" placeholder-class="ph" />
      <input class="prompt-field" value="{{tplSelling}}" data-key="tplSelling" bindinput="onTemplateField" maxlength="60" placeholder="核心卖点" placeholder-class="ph" />
      <input class="prompt-field" value="{{tplPrice}}" data-key="tplPrice" bindinput="onTemplateField" maxlength="40" placeholder="价格 / 权益" placeholder-class="ph" />
    </view>
    <view class="prompt-apply" bindtap="applyPromptTemplate">套用并润色</view>
  </view>

  <!-- 提示词 -->
  <view class="card">
    <view class="label">提示词 <text class="muted small">（润色后仍可编辑）</text></view>
    <textarea class="prompt" placeholder="描述你想要的画面，例如：美业门店海报，暖光，高级感…"
      placeholder-class="ph" value="{{prompt}}" bindinput="onPrompt" maxlength="1000"
      cursor="{{promptCursor}}" auto-height show-confirm-bar="{{false}}"></textarea>
    <view wx:if="{{promptMentionOpen}}" class="mention-menu">
      <view wx:for="{{refPreviews}}" wx:key="*this" class="mention-item" data-i="{{index}}" bindtap="selectPromptMention">
        <image src="{{item}}" mode="aspectFill"></image><text>图片{{index + 1}}</text><text class="mention-token">@图片{{index + 1}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{draftStatus}}" class="draft-row {{draftStatusError?'error':''}}">
    <text>{{draftStatus}}<text wx:if="{{hasDraft}}" class="draft-age"> · 本机保留 7 天</text></text>
    <text wx:if="{{hasDraft}}" class="draft-clear" bindtap="clearDraft">清空草稿</text>
  </view>

  <!-- 参考图（图生图） -->
  <view class="card">
    <view class="ref-head">
      <view class="label">参考图 <text class="muted small">（最多 {{maxRefCount}} 张 · 点图片编号插入提示词）</text></view>
      <view wx:if="{{refPreviews.length && !refBusy}}" class="ref-clear-all" bindtap="clearRef">清空图片</view>
    </view>
    <view wx:if="{{!refPreviews.length && !refBusy}}" class="upbox" bindtap="chooseRef">
      <image class="ic-up" src="../../assets/icons/upload.svg"></image>
      <text class="muted small">上传参考图</text>
    </view>
    <view wx:if="{{refPreviews.length}}" class="ref-grid {{maxRefCount===1?'single':''}}">
      <view wx:for="{{refPreviews}}" wx:key="*this" class="ref-cell">
        <image class="ref-img" src="{{item}}" mode="aspectFill"></image>
        <view class="ref-index" data-i="{{index}}" catchtap="insertRefMention">图片{{index + 1}}</view>
        <view class="ref-del" data-i="{{index}}" catchtap="removeRef">✕</view>
      </view>
      <view wx:if="{{refPreviews.length < maxRefCount && !refBusy}}" class="ref-cell ref-add" bindtap="chooseRef">
        <image class="ic-up" src="../../assets/icons/upload.svg"></image>
        <text class="muted small">继续添加</text>
      </view>
    </view>
    <view wx:if="{{refBusy}}" class="ref-saving muted small">正在保存参考图…</view>
    <view class="muted small ref-help">单次最多选择 9 张，可继续添加；参考图仅保存在本机草稿中</view>
  </view>

  <!-- 引擎 -->
  <view class="card">
    <view class="label">引擎</view>
    <view class="engine-grid">
      <view wx:for="{{engines}}" wx:key="key" data-k="{{item.key}}" bindtap="selectEngine"
        class="engine {{engine===item.key?'active':''}}">
        <view class="engine-name">{{item.name}}</view>
        <view class="engine-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 比例 -->
  <view class="card">
    <view class="label">比例</view>
    <view class="grid ratio-grid">
      <view wx:for="{{ratios}}" wx:key="*this" data-v="{{item}}" bindtap="selectRatio"
        class="chip {{ratio===item?'active':''}}">{{item}}</view>
    </view>
  </view>

  <!-- 清晰度 + 数量 -->
  <view class="card row2">
    <view class="col">
      <view class="label">清晰度</view>
      <view class="grid q-grid">
        <view class="chip {{quality==='std'?'active':''}}" data-v="std" bindtap="selectQuality">标准</view>
        <view class="chip {{quality==='hd'?'active':''}}" data-v="hd" bindtap="selectQuality">高清</view>
      </view>
    </view>
    <view class="col">
      <view class="label">数量 <text class="muted small">（≤{{maxCount}}）</text></view>
      <view class="count-row">
        <view class="count-btn" bindtap="dec">－</view>
        <view class="count-val">{{count}}</view>
        <view class="count-btn" bindtap="inc">＋</view>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="btn-primary {{busy || pricingChecking || !pricingReady ? 'disabled' : ''}}" bindtap="generate">
    {{busy ? '生成中…' : (pricingChecking ? '正在确认价格…' : (pricingReady ? '立即生成（' + cost + ' 点）' : '实时价格加载中…'))}}
  </view>
  <view class="ai-disclosure">内容由人工智能生成，请遵守法律法规并自行核验后使用</view>
  <view class="note" style="color:{{noteColor}}">{{note || (pricingReady ? '本次预计消耗 ' + cost + ' 点 · 失败自动退点' : '实时价格加载失败，请稍后重试')}}</view>

  <!-- 结果 -->
  <view wx:if="{{resultUrl}}" class="card">
    <view class="label">生成结果 <text class="ai-badge">AI 生成</text></view>
    <image class="result-img" src="{{resultUrl}}" mode="widthFix" bindtap="previewResult"></image>
    <view wx:if="{{thumbs.length}}" class="thumbs">
      <image wx:for="{{thumbs}}" wx:key="*this" src="{{item}}" data-u="{{item}}" bindtap="pickThumb"
        class="thumb {{resultUrl===item?'active':''}}" mode="aspectFill"></image>
    </view>
    <view class="result-actions">
      <view class="ghost-btn" bindtap="saveResult"><image class="ic" src="../../assets/icons/download.svg"></image>保存到相册</view>
      <view class="ghost-btn" bindtap="previewResult"><image class="ic" src="../../assets/icons/eye.svg"></image>查看大图</view>
    </view>
  </view>

  <!-- 最近作品 -->
  <view class="card">
    <view class="label">最近作品</view>
    <view wx:if="{{history.length}}" class="history-grid">
      <image wx:for="{{history}}" wx:key="*this" src="{{item}}" data-u="{{item}}" bindtap="previewHistory"
        class="history-img" mode="aspectFill"></image>
    </view>
    <view wx:else class="empty-state">还没有作品，快生成第一张吧</view>
  </view>

</view>
