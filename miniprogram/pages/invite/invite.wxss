.invite-page { padding-bottom: 70rpx; }
.loading-state, .error-state, .empty-state {
  margin-top: 24rpx; text-align: center; color: var(--text-muted);
}
.error-state { color: var(--error); }
.section-label { color: var(--text-muted); font-size: 23rpx; }
.invite-code-card { margin-top: 20rpx; text-align: center; }
.invite-code {
  margin: 18rpx 0 24rpx; color: var(--secondary);
  font-size: 62rpx; font-weight: 600; letter-spacing: 12rpx;
}
.invite-actions { display: flex; flex-direction: column; gap: 16rpx; }
.action-button {
  width: 100%; min-width: 0; min-height: 84rpx; margin: 0; padding: 18rpx 20rpx;
  box-sizing: border-box; display: flex; align-items: center; justify-content: center;
  white-space: normal; border-radius: 12rpx;
  border: 1rpx solid var(--line); color: var(--text); background: var(--surface-muted);
  font-size: 24rpx; line-height: 1.2;
}
.action-button::after { border: 0; }
.action-button.primary { color: #fff; background: var(--grad); border-color: transparent; }
.share-guide { margin-top: 18rpx; color: var(--text-muted); font-size: 21rpx; line-height: 1.65; text-align: left; }
.preview-link { margin-top: 16rpx; color: var(--primary); font-size: 23rpx; text-align: center; }
.stats-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 24rpx;
}
.stat-item {
  min-height: 132rpx; padding: 20rpx; box-sizing: border-box;
  display: flex; flex-direction: column; justify-content: center;
  border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface);
}
.stat-value { color: var(--text); font-size: 38rpx; font-weight: 600; }
.stat-label { margin-top: 7rpx; color: var(--text-muted); font-size: 22rpx; }
.stat-item.reward .stat-value { color: var(--secondary); }
.referrer-card { padding: 24rpx 28rpx; }
.referrer-name { margin-top: 12rpx; color: var(--text); font-size: 28rpx; }
.section-title { margin: 34rpx 0 16rpx; color: var(--text); font-size: 29rpx; font-weight: 600; }
.reward-row {
  min-height: 106rpx; padding: 22rpx 24rpx; margin-bottom: 14rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface);
}
.reward-info { min-width: 0; }
.reward-title { color: var(--text); font-size: 25rpx; overflow-wrap: anywhere; }
.reward-meta { margin-top: 7rpx; color: var(--text-muted); font-size: 20rpx; }
.reward-points { flex: none; color: var(--secondary); font-size: 27rpx; font-weight: 600; }
