.edit-page { padding-bottom: 70rpx; }
.steps { display: flex; justify-content: center; gap: 14rpx; margin: 28rpx 0 18rpx; color: var(--text-muted); font-size: 23rpx; }
.steps .active { color: var(--secondary); font-weight: 700; }
.loading, .error { margin: 14rpx 0; text-align: center; color: var(--text-muted); font-size: 23rpx; }
.error { color: var(--error); }
.media-row, .switch-field { display: flex; align-items: center; gap: 18rpx; }
.avatar { width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--surface-muted); }
.placeholder { display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 21rpx; }
.media-button { padding: 15rpx 20rpx; border: 1rpx solid var(--primary); border-radius: 999rpx; color: var(--primary); font-size: 23rpx; }
.field { margin-top: 26rpx; color: var(--text-muted); font-size: 23rpx; }
.field input, .field textarea {
  display: block; width: 100%; margin-top: 11rpx; box-sizing: border-box;
  border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--text);
  font-size: 27rpx; background: var(--surface-muted);
}
.field input { height: 84rpx; padding: 0 20rpx; line-height: 84rpx; }
.field textarea { height: 220rpx; min-height: 220rpx; padding: 18rpx 20rpx; line-height: 1.6; }
.switch-field input { flex: 1; width: auto; min-width: 0; margin-top: 0; }
.switch-field .media-button { margin-left: auto; }
.privacy-tip { margin-top: 12rpx; color: var(--secondary); font-size: 22rpx; }
.agreement, .agreement-link { color: var(--text-muted); font-size: 22rpx; }
.agreement-link { margin-left: 12rpx; color: var(--primary); text-decoration: underline; }
.button, .unpublish { margin-top: 30rpx; padding: 23rpx; border-radius: 999rpx; text-align: center; color: #fff; background: var(--grad); font-size: 28rpx; }
.actions { display: flex; gap: 16rpx; }
.actions .button { flex: 1; }
.secondary { color: var(--primary); background: transparent; border: 1rpx solid var(--primary); }
.unpublish { color: var(--error); background: transparent; border: 1rpx solid rgba(194,65,58,.6); }
