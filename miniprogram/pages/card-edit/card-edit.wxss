.edit-page { padding-bottom: 90rpx; }
.intro { margin: 20rpx 2rpx 30rpx; }
.eyebrow { color: var(--secondary); font-size: 20rpx; letter-spacing: 3rpx; }
.title { margin-top: 10rpx; color: var(--text); font-size: 40rpx; font-weight: 700; }
.subtitle, .section-tip, .media-hint { margin-top: 10rpx; color: var(--text-muted); font-size: 22rpx; line-height: 1.65; }
.loading, .error { margin: 18rpx 0; color: var(--text-muted); text-align: center; font-size: 23rpx; }
.error { color: var(--error); }
.form-section { margin-bottom: 24rpx; padding: 30rpx 26rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); }
.section-title { color: var(--text); font-size: 31rpx; font-weight: 700; }
.media-row { display: flex; align-items: center; gap: 24rpx; margin-top: 28rpx; }
.avatar { width: 112rpx; height: 112rpx; border: 2rpx dashed rgba(240,165,75,.65); border-radius: 50%; background: var(--surface-muted); }
.placeholder { display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 22rpx; }
.media-label { color: var(--text); font-size: 25rpx; font-weight: 600; }
.small-button { display: inline-block; margin-top: 12rpx; padding: 13rpx 20rpx; border: 1rpx solid rgba(240,165,75,.55); border-radius: 999rpx; color: var(--secondary); font-size: 22rpx; }
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.field { min-width: 0; margin-top: 25rpx; color: var(--text-muted); font-size: 23rpx; }
.field input, .field textarea { display: block; width: 100%; margin-top: 11rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 18rpx; color: var(--text); font-size: 27rpx; background: var(--surface-muted); }
.field input { height: 84rpx; padding: 0 20rpx; line-height: 84rpx; }
.field textarea { height: 200rpx; min-height: 200rpx; padding: 18rpx 20rpx; line-height: 1.6; }
.switch-line, .qr-line, .credential { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 22rpx; color: var(--text); font-size: 23rpx; }
.qr-line { align-items: flex-end; padding-top: 8rpx; border-top: 1rpx solid var(--line); }
.image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 24rpx; }
.media-title-item { min-width: 0; }
.upload-slot { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx dashed rgba(148,141,168,.45); border-radius: 20rpx; color: var(--text-muted); background: rgba(255,255,255,.015); font-size: 22rpx; }
.image-slot { height: 156rpx; }
.media-title-input { width: 100%; height: 68rpx; margin-top: 12rpx; padding: 0 14rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 14rpx; color: var(--text); background: var(--surface-muted); font-size: 21rpx; }
.video-list { display: flex; flex-direction: column; gap: 22rpx; margin-top: 20rpx; }
.video-slot { height: 170rpx; }
.ai-section { border-color: rgba(240,165,75,.34); background: linear-gradient(160deg, rgba(240,165,75,.07), var(--surface) 45%); }
.credential { padding-bottom: 18rpx; border-bottom: 1rpx solid var(--line); }
.credential text:first-child { color: var(--text-muted); }
.credential-note { margin-top: 20rpx; padding: 20rpx; border-radius: 18rpx; color: #f6d6a6; background: rgba(240,165,75,.09); font-size: 22rpx; line-height: 1.65; }
.password-button { margin-top: 22rpx; }
.password-form { margin-top: 8rpx; }
.agreement { display: inline-flex; align-items: center; margin-top: 24rpx; color: var(--text-muted); font-size: 22rpx; }
.agreement-link { display: inline; margin-left: 10rpx; color: var(--primary-ink); font-size: 22rpx; text-decoration: underline; }
.save-button, .secondary-action { width: 100%; margin-top: 24rpx; padding: 24rpx; box-sizing: border-box; border-radius: 999rpx; color: #fff; background: var(--grad); font-size: 29rpx; line-height: 1.2; }
.secondary-action { border: 1rpx solid rgba(226,75,160,.55); color: var(--primary-ink); background: transparent; font-size: 25rpx; }
button::after { border: 0; }
.unpublish, .existing { margin-top: 24rpx; color: var(--text-muted); text-align: center; font-size: 23rpx; text-decoration: underline; }
.unpublish { color: var(--error); }
