<view class="container edit-page">
  <view class="steps"><text class="{{step===1?'active':''}}">1 基本名片</text><text>—</text><text class="{{step===2?'active':''}}">2 联系方式{{anonymous ? '与账号' : ''}}</text></view>
  <view wx:if="{{loading}}" class="loading">正在处理…</view>
  <view class="card">
    <block wx:if="{{step===1}}">
      <view class="media-row"><image wx:if="{{card.avatar}}" class="avatar" src="{{card.avatar}}" mode="aspectFill"/><view wx:else class="avatar placeholder">头像</view><view class="media-button" data-field="avatar" bindtap="chooseMedia">上传头像</view></view>
      <view class="field"><text>姓名 *</text><input value="{{card.name}}" data-field="name" bindinput="input" placeholder="你的姓名"/></view>
      <view class="field"><text>职称 *</text><input value="{{card.title}}" data-field="title" bindinput="input" placeholder="例如：品牌主理人"/></view>
      <view class="field"><text>公司 *</text><input value="{{card.company}}" data-field="company" bindinput="input" placeholder="所在公司或机构"/></view>
      <view class="field"><text>简介 / 做过的事</text><textarea value="{{card.bio}}" data-field="bio" bindinput="input" placeholder="介绍你正在做什么、做过什么" maxlength="300"/></view>
      <view class="field"><text>标签</text><input value="{{card.tags}}" data-field="tags" bindinput="input" placeholder="例如：AI、品牌、摄影（逗号分隔）"/></view>
      <view class="field"><text>链接</text><input value="{{card.links}}" data-field="links" bindinput="input" placeholder="官网、作品集或社媒链接"/></view>
      <view wx:if="{{error}}" class="error">{{error}}</view><view class="button" bindtap="next">下一步</view>
    </block>
    <block wx:else>
      <view class="privacy-tip">以下四项默认不公开，由你分别选择。</view>
      <view class="field switch-field"><text>电话</text><input value="{{card.phone}}" data-field="phone" bindinput="input" placeholder="可选"/><switch checked="{{card.privacy.phone}}" data-field="phone" bindchange="setPrivacy"/></view>
      <view class="field switch-field"><text>邮箱</text><input value="{{card.email}}" data-field="email" bindinput="input" placeholder="可选"/><switch checked="{{card.privacy.email}}" data-field="email" bindchange="setPrivacy"/></view>
      <view class="field switch-field"><text>详细地址</text><input value="{{card.address}}" data-field="address" bindinput="input" placeholder="可选"/><switch checked="{{card.privacy.address}}" data-field="address" bindchange="setPrivacy"/></view>
      <view class="field switch-field"><text>微信二维码</text><view class="media-button" data-field="wechat_qr" bindtap="chooseMedia">{{card.wechat_qr ? '已上传，重新选择' : '上传图片'}}</view><switch checked="{{card.privacy.wechat_qr}}" data-field="wechat_qr" bindchange="setPrivacy"/></view>
      <block wx:if="{{anonymous}}"><view class="field"><text>账号 *</text><input value="{{username}}" data-field="username" bindinput="accountInput" placeholder="设置登录账号"/></view><view class="field"><text>密码 *</text><input password="true" value="{{password}}" data-field="password" bindinput="accountInput" placeholder="设置登录密码"/></view><checkbox-group bindchange="agreement"><label class="agreement"><checkbox value="yes" checked="{{agreed}}" color="#b048c8"/>我已阅读并同意用户协议和隐私指引</label></checkbox-group></block>
      <view wx:if="{{error}}" class="error">{{error}}</view><view class="actions"><view class="button secondary" bindtap="previous">上一步</view><view class="button" bindtap="save">{{anonymous ? '注册并保存名片' : '保存名片'}}</view></view><view wx:if="{{!anonymous}}" class="publish" bindtap="publish">完成后公开并分享</view>
    </block>
  </view>
</view>
