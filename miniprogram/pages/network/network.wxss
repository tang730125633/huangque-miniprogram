.network-page {
  position: relative; min-height: 100vh; padding: 34rpx 24rpx 90rpx; overflow: hidden; box-sizing: border-box; color: #fbf9ff;
  background: radial-gradient(circle at 50% -8%, rgba(91,52,162,.32), transparent 32%), radial-gradient(circle at 8% 64%, rgba(22,78,131,.18), transparent 28%), linear-gradient(180deg, #03040b 0%, #090513 50%, #020307 100%);
}
.page-space { position: absolute; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
.page-starfield { position: absolute; inset: -8%; background-repeat: repeat; }
