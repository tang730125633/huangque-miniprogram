.graph-viewport { position: relative; width: 680rpx; height: 820rpx; margin: 0 auto; overflow: hidden; border: 1rpx solid rgba(207,181,255,.13); border-radius: 38rpx; background: #040209; box-shadow: inset 0 0 140rpx rgba(81,41,143,.25), 0 34rpx 80rpx rgba(0,0,0,.34); }
