.network-page { position:relative; min-height:100vh; padding:28rpx 24rpx 90rpx; overflow:hidden; box-sizing:border-box; color:var(--text); }
.network-hero { padding:24rpx 12rpx; text-align:center; }
.eyebrow { color:var(--primary); font-size:19rpx; letter-spacing:3rpx; }.hero-title { margin-top:16rpx; font:44rpx "Songti SC","STSong",serif; }.hero-subtitle { margin-top:14rpx; color:var(--text-muted); font-size:23rpx; }
.stats-row { display:flex; gap:14rpx; margin-top:30rpx; }.stat { flex:1; padding:22rpx 8rpx; border:1rpx solid var(--line); border-radius:16rpx; background:var(--surface); }.stat-number { display:block; color:var(--primary-ink); font-size:40rpx; }.stat-label { display:block; margin-top:8rpx; color:var(--text-muted); font-size:21rpx; }
.state-card,.empty-card { margin:24rpx 0; padding:36rpx 24rpx; text-align:center; border:1rpx dashed var(--line); border-radius:18rpx; color:var(--text-muted); background:var(--surface); }.state-card.error { color:var(--error); }.loading-star { margin-bottom:20rpx; color:var(--primary); font-size:40rpx; }.retry { padding:20rpx; color:var(--primary); }
.view-switch { display:flex; padding:6rpx; gap:8rpx; margin:10rpx 0 22rpx; border:1rpx solid var(--line); border-radius:14rpx; background:var(--surface-muted); }.switch-item { flex:1; padding:18rpx; text-align:center; color:var(--text-muted); font-size:25rpx; border-radius:10rpx; }.switch-item.active { background:var(--grad); color:#fff8e8; }
.graph-shell { position:relative; }.focus-banner { display:flex; align-items:center; justify-content:space-between; gap:18rpx; padding:18rpx; margin-bottom:20rpx; background:var(--primary-soft); border:1rpx solid var(--line); border-radius:14rpx; }.focus-kicker { display:block; color:var(--text-muted); font-size:20rpx; }.focus-name { display:block; margin-top:8rpx; font-size:25rpx; }.focus-back { flex:none; color:var(--primary); font-size:22rpx; }
.plane-head { display:flex; align-items:center; justify-content:space-between; gap:8rpx; margin:0 6rpx 16rpx; }.graph-legend { display:flex; gap:16rpx; font-size:19rpx; color:var(--text-muted); }.legend-item { display:flex; align-items:center; gap:6rpx; }.legend-dot { width:12rpx; height:12rpx; border-radius:50%; }.legend-dot.up { background:#a66d4e; }.legend-dot.me { background:#876b3f; }.legend-dot.down { background:#64795d; }.load-state { color:var(--text-muted); font-size:18rpx; }
.graph-viewport { position:relative; width:680rpx; height:820rpx; max-width:100%; margin:0 auto; overflow:hidden; border:1rpx solid var(--line); border-radius:22rpx; background:rgba(255,253,247,.5); }
.move-area { width:100%; height:100%; overflow:hidden; }.orbit { position:relative; overflow:visible; transform-origin:0 0; contain:layout paint style; will-change:transform; backface-visibility:hidden; }
/* Preserve the same projection for the visible graph and its touch targets. */
.orbit-scene { position:relative; width:100%; height:100%; transform-origin:50% 50%; transform:rotate(-6deg) scaleY(.72); }
.relationship-orbit { position:absolute; border:1rpx solid #ded1b8; border-radius:50%; pointer-events:none; }.plane-grid { position:absolute; inset:0; pointer-events:none; background-image:radial-gradient(#cdbf9f 1rpx,transparent 1rpx); background-size:36rpx 36rpx; opacity:.35; }
.star-link { position:absolute; z-index:2; height:2rpx; transform-origin:left center; }.link-core { position:absolute; inset:0; height:2rpx; background:#bdac8c; }.star-link.active .link-core { height:3rpx; background:var(--primary); }.link-arrow { position:absolute; right:-6rpx; top:-13rpx; color:var(--primary); font-size:24rpx; }.link-pulse { display:none; }
.star-node { position:absolute; z-index:5; display:flex; align-items:center; justify-content:center; transform:scaleY(1.3889) rotate(6deg); transition:transform .2s ease; }.star-node.selected { z-index:12; transform:scaleY(1.3889) rotate(6deg) scale(1.08); }.graph-interacting .star-node { transition:none; }
.planet-body { position:relative; width:100%; height:100%; overflow:hidden; box-sizing:border-box; border:2rpx solid #ad9d80; border-radius:50%; background:#eee5d2; box-shadow:0 6rpx 14rpx rgba(92,70,37,.10); }.identity-initiator .planet-body { border-color:#94763e; background:#eee0bc; }.identity-partner .planet-body { border-color:#a87862; background:#edddd1; }.identity-experience .planet-body { border-color:#748168; background:#e3e6d5; }.identity-nonmember .planet-body { border-color:#a39b89; background:#ece7db; }.self .planet-body { border-width:4rpx; border-color:#876b3f; }
.planet-avatar { position:absolute; inset:0; width:100%; height:100%; border-radius:50%; }.planet-avatar.fallback { box-sizing:border-box; display:flex; align-items:center; justify-content:center; padding:10rpx; text-align:center; color:#51432d; font-size:20rpx; line-height:1.08; word-break:break-all; white-space:normal; }.planet-avatar.fallback.name-small { font-size:16rpx; }.planet-avatar.fallback.name-tiny { font-size:13rpx; padding:8rpx; }
.planet-caption { position:absolute; z-index:8; top:calc(100% + 9rpx); left:50%; min-width:102rpx; max-width:176rpx; padding:5rpx 9rpx; transform:translateX(-50%); border:1rpx solid var(--line); border-radius:8rpx; background:#f8f1e3; text-align:center; }.planet-name { color:var(--text); font-size:21rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.self .planet-caption { display:none; }
.star-hit-plane { position:absolute; z-index:21; inset:0; transform-origin:50% 50%; transform:rotate(-6deg) scaleY(.72); pointer-events:auto; }.star-hit-target { position:absolute; border-radius:50%; transform:scaleY(1.3889) rotate(6deg); }
.plane-controls { position:absolute; z-index:30; right:14rpx; bottom:14rpx; display:flex; gap:6rpx; padding:6rpx; border:1rpx solid var(--line); border-radius:14rpx; background:#f7efdf; pointer-events:none; }.control-button { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:9rpx; color:var(--text); background:var(--surface-muted); font-size:28rpx; pointer-events:auto; }.control-button.home { color:#fff8e8; background:var(--primary); }.control-button.fit { width:76rpx; font-size:22rpx; }.zoom-indicator { position:absolute; left:18rpx; bottom:22rpx; padding:10rpx; color:var(--text-muted); background:#f7efdf; border:1rpx solid var(--line); border-radius:10rpx; font-size:20rpx; pointer-events:none; }.graph-note { margin:20rpx 8rpx; font-size:21rpx; line-height:1.7; color:var(--text-muted); }
.node-sheet { position:absolute; z-index:45; left:14rpx; right:14rpx; bottom:30rpx; padding:26rpx; border:1rpx solid var(--line); border-radius:20rpx; background:#f8f1e3; box-shadow:0 12rpx 40rpx rgba(92,70,37,.13); }.sheet-head { display:flex; justify-content:space-between; align-items:center; }.sheet-relation { color:var(--primary); font-size:21rpx; }.sheet-name { margin-top:10rpx; font-size:34rpx; }.sheet-close { padding:12rpx; color:var(--text-muted); font-size:40rpx; }.relation-path { margin:20rpx 0; padding:16rpx; font-size:23rpx; color:var(--primary-ink); background:var(--surface-muted); border-radius:10rpx; }.sheet-meta { display:flex; flex-wrap:wrap; gap:14rpx; color:var(--text-muted); font-size:22rpx; }.permission-note { margin-top:20rpx; color:var(--warning); font-size:23rpx; }.node-sheet .focus-button,.node-sheet .card-button { width:100%; margin:18rpx 0 0; border-radius:12rpx; font-size:25rpx; }.focus-button { background:var(--grad); color:#fff8e8; }.card-button { border:1rpx solid var(--line); color:var(--primary-ink); background:var(--surface-muted); }
.section-title { display:flex; justify-content:space-between; margin:30rpx 0 18rpx; font-size:28rpx; }.section-count { color:var(--primary); }.person-card { display:flex; align-items:center; gap:20rpx; margin-bottom:14rpx; padding:22rpx; border:1rpx solid var(--line); border-radius:16rpx; background:var(--surface); }.person-avatar { width:80rpx; height:80rpx; border-radius:50%; flex:none; background:var(--surface-muted); }.person-avatar.fallback { display:flex; align-items:center; justify-content:center; text-align:center; font-size:20rpx; color:var(--primary); overflow:hidden; }.person-copy { min-width:0; }.person-name { font-size:26rpx; word-break:break-all; }.more-button { padding:24rpx; text-align:center; color:var(--primary); border:1rpx solid var(--line); border-radius:14rpx; }
