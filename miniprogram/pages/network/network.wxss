  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transform-origin: 50% 50%;
  transform: rotateX(48deg) rotateZ(-6deg) translateZ(-18rpx);
}
.orbit-scene::after {
  position: absolute;
  z-index: 0;
  left: 14%;
  top: 17%;
  width: 72%;
  height: 66%;
  content: '';
  pointer-events: none;
  transform: translateZ(-52rpx);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(44,91,142,.12), rgba(10,18,35,.08) 48%, transparent 72%);
  box-shadow: 0 42rpx 90rpx rgba(0,0,0,.48);
}
.orbit-scene > .plane-grid {
  transform: translateZ(-10rpx);
}
.relationship-orbit {
  transform: translateZ(1rpx);
  border-color: rgba(188,207,231,.16);
  box-shadow: inset 0 0 13rpx rgba(92,140,192,.07), 0 0 11rpx rgba(144,180,219,.05);
}
.star-link {
  transform-style: preserve-3d;
}
.link-core,
.dense-network .link-core {
  opacity: .3;
  transform: translateZ(4rpx);
  background: linear-gradient(90deg, rgba(224,199,133,.7), rgba(123,172,220,.34));
  box-shadow: 0 0 7rpx rgba(128,170,215,.18);
}
.link-pulse,
.dense-network .link-pulse {
  filter: none;
  will-change: transform, opacity;
}
.star-node {
  transform-style: preserve-3d;
  transform-origin: 50% 50%;
  backface-visibility: hidden;
  transition: transform .28s ease, filter .28s ease;
}
.star-node.layer-0 { transform: translateZ(76rpx) rotateZ(6deg) rotateX(-48deg); }
.star-node.layer-1 { transform: translateZ(50rpx) rotateZ(6deg) rotateX(-48deg); }
.star-node.layer-2 { transform: translateZ(40rpx) rotateZ(6deg) rotateX(-48deg); }
.star-node.layer-3 { transform: translateZ(31rpx) rotateZ(6deg) rotateX(-48deg); }
.star-node.layer-4 { transform: translateZ(23rpx) rotateZ(6deg) rotateX(-48deg); }
.star-node.layer-5 { transform: translateZ(16rpx) rotateZ(6deg) rotateX(-48deg); }
.star-node.selected {
  z-index: 12;
  transform: translateZ(86rpx) rotateZ(6deg) rotateX(-48deg) scale(1.08);
  filter: brightness(1.13);
}
.star-node .planet-body,
.star-node.self .planet-body,
.star-node.ancestor .planet-body,
.star-node.layer-2 .planet-body,
.star-node.layer-3 .planet-body,
.star-node.layer-4 .planet-body,
.dense-network .star-node .planet-body,
.dense-network .star-node.self .planet-body,
.dense-network .star-node.ancestor .planet-body,
.dense-network .star-node.layer-2 .planet-body,
.dense-network .star-node.layer-3 .planet-body,
.dense-network .star-node.layer-4 .planet-body {
  background: radial-gradient(circle at 27% 22%, rgba(237,244,251,.25) 0%, rgba(122,139,160,.09) 22%, transparent 47%), linear-gradient(145deg, #202732 0%, #0d121a 58%, #030609 100%);
  box-shadow: inset -10rpx -13rpx 18rpx rgba(0,0,0,.58), inset 6rpx 6rpx 12rpx rgba(235,243,251,.13), 0 8rpx 0 rgba(2,5,9,.75), 0 13rpx 22rpx rgba(0,0,0,.5);
}
.star-node.identity-initiator .planet-body,
.dense-network .star-node.identity-initiator .planet-body {
  background: radial-gradient(circle at 27% 22%, rgba(255,241,190,.42) 0%, rgba(218,174,70,.16) 23%, transparent 48%), linear-gradient(145deg, #3a2e17 0%, #181207 58%, #050302 100%);
  box-shadow: inset -10rpx -13rpx 18rpx rgba(0,0,0,.58), inset 6rpx 6rpx 12rpx rgba(255,232,159,.18), 0 8rpx 0 #080603, 0 14rpx 24rpx rgba(0,0,0,.5), 0 0 12rpx rgba(222,184,86,.24);
}
.star-node.identity-partner .planet-body,
.dense-network .star-node.identity-partner .planet-body {
  background: radial-gradient(circle at 27% 22%, rgba(255,218,243,.38) 0%, rgba(222,85,168,.14) 23%, transparent 48%), linear-gradient(145deg, #3a1d31 0%, #170a14 58%, #050204 100%);
  box-shadow: inset -10rpx -13rpx 18rpx rgba(0,0,0,.6), inset 6rpx 6rpx 12rpx rgba(255,215,241,.16), 0 8rpx 0 #080305, 0 14rpx 24rpx rgba(0,0,0,.5), 0 0 12rpx rgba(225,81,166,.22);
}
.star-node.identity-experience .planet-body,
.dense-network .star-node.identity-experience .planet-body {
  background: radial-gradient(circle at 27% 22%, rgba(216,239,255,.4) 0%, rgba(72,146,219,.15) 23%, transparent 48%), linear-gradient(145deg, #18314a 0%, #091724 58%, #020509 100%);
  box-shadow: inset -10rpx -13rpx 18rpx rgba(0,0,0,.6), inset 6rpx 6rpx 12rpx rgba(212,238,255,.16), 0 8rpx 0 #02070c, 0 14rpx 24rpx rgba(0,0,0,.5), 0 0 12rpx rgba(72,148,227,.22);
}
.planet-night,
.planet-shine,
.dense-network .planet-night,
.dense-network .planet-shine {
  display: block;
  filter: none;
  pointer-events: none;
}
.planet-night,
.dense-network .planet-night {
  background: linear-gradient(118deg, transparent 24%, rgba(0,0,0,.08) 46%, rgba(0,0,0,.52) 84%, rgba(0,0,0,.68));
}
.planet-shine,
.dense-network .planet-shine {
  opacity: .58;
  background: radial-gradient(ellipse, rgba(255,255,255,.52), rgba(255,255,255,.08) 55%, transparent 74%);
}
.graph-interacting .orbit-scene {
  transform: rotateX(48deg) rotateZ(-6deg) translateZ(-18rpx);
}
.graph-interacting .planet-night,
.graph-interacting .planet-shine {
  display: none;
}
.graph-interacting .star-node .planet-body,
.graph-interacting.dense-network .star-node .planet-body {
  box-shadow: none;
}

/* Let the 3D constellation dissolve into the page-wide galaxy. */
.graph-viewport {
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.move-area,
.orbit {
  background: transparent;
}
.space-depth {
  background: radial-gradient(circle at 50% 50%, rgba(25,47,75,.08) 0%, rgba(5,13,25,.035) 54%, transparent 100%);
}
.space-depth,
.milky-way,
.stars,
.cosmic-dust,
.plane-grid,
.nebula,
.galaxy-core,
.relationship-orbit,
.star-link,
.gravity-halo,
.planet-ring,
.planet-night,
.planet-shine,
.planet-atmosphere,
.child-count {
  pointer-events: none;
}
.star-hit-target {
  position: absolute;
  z-index: 20;
  box-sizing: border-box;
  border-radius: 50%;
  background: transparent;
  pointer-events: auto;
  transform-origin: 50% 50%;
  will-change: transform;
}
.star-hit-target.layer-0 { transform: translateZ(76rpx) scaleY(1.48); }
.star-hit-target.layer-1 { transform: translateZ(50rpx) scaleY(1.48); }
.star-hit-target.layer-2 { transform: translateZ(40rpx) scaleY(1.48); }
.star-hit-target.layer-3 { transform: translateZ(31rpx) scaleY(1.48); }
.star-hit-target.layer-4 { transform: translateZ(23rpx) scaleY(1.48); }
.star-hit-target.layer-5 { transform: translateZ(16rpx) scaleY(1.48); }
.star-hit-plane {
  position: absolute;
  z-index: 21;
  inset: 0;
  transform-style: flat;
  transform-origin: 50% 50%;
  transform: rotateX(48deg) rotateZ(-6deg) translateZ(-18rpx);
  pointer-events: auto;
}
.star-hit-plane .star-hit-target {
  transform: scaleY(1.48);
}

/* Hit-safe 2.5D projection: same tilted look without Chromium's back-plane hit loss. */
.graph-viewport {
  perspective: none;
}
.orbit-scene,
.star-hit-plane,
.graph-interacting .orbit-scene {
  transform-style: flat;
  transform: rotate(-6deg) scaleY(.72);
}
.star-node.layer-0,
.star-node.layer-1,
.star-node.layer-2,
.star-node.layer-3,
.star-node.layer-4,
.star-node.layer-5 {
  transform: scaleY(1.3889) rotate(6deg);
}
.star-node.selected {
  transform: scaleY(1.3889) rotate(6deg) scale(1.08);
}
.star-hit-plane .star-hit-target {
  transform: scaleY(1.3889) rotate(6deg);
}
.plane-controls,
.zoom-indicator {
  pointer-events: none;
}
.plane-controls .control-button {
  pointer-events: auto;
}

/* Let the galaxy remain visible behind the relationship totals. */
.network-hero .stats-row,
.network-hero .stats-row .stat {
  background: transparent !important;
  box-shadow: none !important;
  backdrop-filter: none;
}
.focus-button.permission-required {
  border-color: rgba(214, 185, 107, .28);
  color: #d9c58b;
}

/* Native Mini Program background: local WXSS urls are unreliable, so render the same galaxy through <image>. */
.page-space {
  background-image: none !important;
}
.galaxy-background,
.galaxy-vignette {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.galaxy-background {
  display: block;
}
.galaxy-vignette {
  z-index: 1;
  background: linear-gradient(180deg, rgba(1,4,12,.08), rgba(1,4,12,.22) 48%, rgba(1,3,8,.58) 100%);
}
.page-space .page-starfield {
  z-index: 2;
}
.page-space .page-nebula {
  z-index: 3;
}

/* Stable identity legend and planet mapping. */
.graph-legend .legend-item,
.identity-legend .identity-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}
.identity-legend .identity-dot {
  display: block;
  flex: none;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  border: 1rpx solid rgba(255,255,255,.58);
  border-radius: 50%;
}
.identity-legend .identity-dot.initiator {
  color: #f2c45f !important;
  background: #f2c45f !important;
  box-shadow: 0 0 12rpx rgba(242,196,95,.86) !important;
}
.identity-legend .identity-dot.partner {
  color: #ed5eae !important;
  background: #ed5eae !important;
  box-shadow: 0 0 12rpx rgba(237,94,174,.82) !important;
}
.identity-legend .identity-dot.experience {
  color: #5d9cff !important;
  background: #5d9cff !important;
  box-shadow: 0 0 12rpx rgba(93,156,255,.82) !important;
}
.identity-legend .identity-dot.nonmember {
  color: #8791a3 !important;
  background: #8791a3 !important;
  box-shadow: 0 0 10rpx rgba(135,145,163,.62) !important;
}
.star-node.identity-initiator .planet-body,
.dense-network .star-node.identity-initiator .planet-body {
  border-color: #f2c45f !important;
}
.star-node.identity-partner .planet-body,
.dense-network .star-node.identity-partner .planet-body {
  border-color: #ed5eae !important;
}
.star-node.identity-experience .planet-body,
.dense-network .star-node.identity-experience .planet-body {
  border-color: #5d9cff !important;
}
.star-node.identity-nonmember .planet-body,
.dense-network .star-node.identity-nonmember .planet-body {
  border-color: #8791a3 !important;
}

/* Show the complete customer name when no avatar is available. */
.planet-avatar.fallback,
.self .planet-avatar.fallback {
  box-sizing: border-box;
  padding: 10rpx;
  color: #f7f5ef;
  text-align: center;
  white-space: normal;
  word-break: break-all;
  line-height: 1.08;
  font-size: 20rpx;
}
.planet-avatar.fallback.name-small,
.self .planet-avatar.fallback.name-small {
  font-size: 16rpx;
}
.planet-avatar.fallback.name-tiny,
.self .planet-avatar.fallback.name-tiny {
  padding: 8rpx;
  font-size: 13rpx;
}
.planet-name,
.self .planet-name {
  overflow: visible;
  max-width: 190rpx;
  white-space: normal;
  text-overflow: clip;
  word-break: break-all;
  line-height: 1.2;
}
.person-avatar.fallback {
  box-sizing: border-box;
  padding: 6rpx;
  text-align: center;
  white-space: normal;
  word-break: break-all;
  line-height: 1.05;
  font-size: 13rpx;
}
