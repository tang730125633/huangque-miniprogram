.starfield-near { opacity: .7; background-image: radial-gradient(circle, #fff 0 1.5rpx, transparent 3rpx), radial-gradient(circle, #ffe4a4 0 1rpx, transparent 2.5rpx), radial-gradient(circle, #acd7ff 0 1.2rpx, transparent 2.7rpx); background-position: 31rpx 19rpx, 87rpx 143rpx, 169rpx 58rpx; background-size: 257rpx 257rpx, 311rpx 311rpx, 373rpx 373rpx; animation: skyTwinkle 6s ease-in-out infinite alternate; }
.page-nebula { position: absolute; left: -22%; top: 24%; width: 145%; height: 38%; opacity: .22; transform: rotate(-14deg); filter: blur(55rpx); background: linear-gradient(100deg, transparent 6%, rgba(44,105,174,.5) 30%, rgba(105,57,170,.58) 52%, rgba(203,72,160,.24) 70%, transparent 92%); }
.network-hero, .stats-row, .state-card, .view-switch, .graph-shell, .list-view { position: relative; z-index: 1; }
.network-hero { position: relative; padding: 28rpx 12rpx 18rpx; text-align: center; }
