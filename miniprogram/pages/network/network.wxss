.network-page { padding-bottom: 70rpx; }.state { margin-top: 28rpx; text-align: center; color: var(--text-muted); }.error { color: var(--error); }.retry, .more { margin-top: 18rpx; color: var(--primary); }.orbit { position: relative; height: 420rpx; margin-top: 24rpx; overflow: hidden; background: radial-gradient(circle, rgba(226,75,160,.2), transparent 58%), var(--surface); }.ring { position: absolute; border: 1rpx solid rgba(226,75,160,.36); border-radius: 50%; left: 50%; top: 50%; transform: translate(-50%, -50%); }.outer { width: 570rpx; height: 570rpx; }.inner { width: 320rpx; height: 320rpx; }.self, .planet, .initial { display: flex; align-items: center; justify-content: center; border-radius: 50%; }.self { position: absolute; left: 50%; top: 50%; width: 92rpx; height: 92rpx; transform: translate(-50%, -50%); color: #fff; background: var(--grad); font-weight: 700; }.planet { position: absolute; width: 62rpx; height: 62rpx; color: var(--text); background: #31243b; border: 1rpx solid var(--secondary); }.ancestor:nth-of-type(3n) { left: 16%; top: 28%; }.ancestor:nth-of-type(3n + 1) { right: 16%; top: 22%; }.child:nth-of-type(3n) { left: 22%; bottom: 18%; }.child:nth-of-type(3n + 1) { right: 22%; bottom: 14%; }.hint { margin: 18rpx 12rpx; color: var(--text-muted); text-align: center; font-size: 21rpx; line-height: 1.7; }.section-title { margin: 30rpx 4rpx 15rpx; font-size: 29rpx; color: var(--text); font-weight: 650; }.empty { color: var(--text-muted); text-align: center; }.person { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; padding: 20rpx; color: var(--text); }.person > view:nth-child(2) { flex: 1; }.person .muted { margin-top: 5rpx; font-size: 21rpx; }.initial { width: 60rpx; height: 60rpx; color: var(--secondary); background: var(--surface-muted); }.branch { margin: -6rpx 0 14rpx 92rpx; color: var(--primary); font-size: 22rpx; }.child-person { margin-left: 40rpx; border-color: rgba(226,75,160,.3); }.more { padding: 22rpx; text-align: center; border: 1rpx solid var(--primary); border-radius: 999rpx; }
