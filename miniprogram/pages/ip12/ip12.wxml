<view class="ip12-page">
  <view class="topbar">
    <view><view class="eyebrow">你的 IP 成长档案</view><view class="module-title">模块 {{currentModule}} · {{currentModuleName}}</view></view>
    <view class="history-trigger" bindtap="toggleHistory">历史</view>
  </view>

  <scroll-view class="chat" scroll-y scroll-with-animation scroll-into-view="chat-end">
    <view class="chat-inner">
      <view wx:if="{{!conversationId}}" class="empty-card">
        <view class="empty-title">从你的真实经历开始</view>
        <view class="empty-copy">小黄雀会一次问一个问题，整理出你的 IP 定位与故事资产。</view>
        <view class="primary-action {{busy?'disabled':''}}" bindtap="createConversation">{{busy ? '正在开启…' : '开启 IP 诊断'}}</view>
      </view>

      <block wx:else>
        <view class="coach-head"><view class="bird">雀</view><view><view class="coach-title">小黄雀 · IP 成长教练</view><view class="coach-copy">一次只问一个问题，回答会同步到你的黄雀账号。</view></view></view>
        <view wx:for="{{messages}}" wx:key="index" class="turn-wrap {{item.role}}"><view class="turn {{item.role}}">{{item.content}}</view></view>
        <view wx:if="{{note}}" class="status-note">{{note}}</view>

        <view wx:if="{{awaitingReport}}" class="report-card">
          <view class="report-kicker">模块 1–4 已完成</view><view class="report-title">IP 人设定位初稿已生成</view>
          <view class="report-copy">先下载核对 PDF；确认后才会进入模块 5。</view>
          <view class="secondary-action {{pdfBusy?'disabled':''}}" bindtap="downloadReport">{{pdfBusy ? '正在打开…' : '查看 PDF'}}</view>
          <view class="primary-action {{busy?'disabled':''}}" bindtap="confirmReport">我已核对，确认初稿</view>
        </view>
        <view wx:if="{{reportConfirmed}}" class="status-note">模块 1–4 初稿已确认，已解锁后续模块。</view>
        <view wx:if="{{reportFailed}}" class="status-note">PDF 生成失败，请在网页端重试。</view>
      </block>
      <view id="chat-end"></view>
    </view>
  </scroll-view>

  <view wx:if="{{conversationId}}" class="composer">
    <view class="input-row"><textarea class="chat-input" value="{{input}}" bindinput="onInput" maxlength="1200" auto-height fixed="true" cursor-spacing="18" placeholder="像聊天一样回答…" placeholder-class="placeholder"></textarea><view class="send {{busy?'disabled':''}}" bindtap="sendInput">{{busy ? '…' : '发送'}}</view></view>
  </view>

  <view wx:if="{{historyOpen}}" class="drawer"><view class="drawer-mask" bindtap="closeHistory"></view><view class="drawer-panel"><view class="drawer-head"><view><view class="drawer-title">我的诊断</view><view class="drawer-copy">仅显示当前账号的记录</view></view><view class="drawer-close" bindtap="closeHistory">×</view></view><view wx:for="{{conversations}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseConversation" class="conversation-item {{item.id===conversationId?'active':''}}"><view class="conversation-title">{{item.title || '新诊断'}}</view><view class="conversation-time">{{item.updated}}</view></view></view></view>
</view>
