<view class="ip12-page">
  <view class="topbar">
    <view class="topbar-copy">
      <view class="eyebrow">模块 {{moduleId}} · {{modulePhase}}</view>
      <view class="module-title">{{moduleName}}</view>
      <view class="step-copy">{{stepTitle}} · {{currentStepText}}</view>
    </view>
    <view class="module-trigger" bindtap="toggleModules">全部模块</view>
  </view>

  <view class="progress-track"><view class="progress-fill" style="width:{{progressPercent}}%"></view></view>

  <scroll-view class="chat" scroll-y scroll-with-animation scroll-into-view="chat-end">
    <view class="chat-inner">
      <view class="welcome">
        <view class="bird">雀</view>
        <view>
          <view class="welcome-title">小黄雀 IP 教练</view>
          <view class="welcome-copy">一次只聊一个问题。你自然回答，我来整理并继续。</view>
        </view>
      </view>

      <view wx:for="{{guideTurns}}" wx:key="index" class="turn-wrap {{item.role}}">
        <view wx:if="{{item.stepLabel}}" class="turn-step">{{item.stepLabel}}</view>
        <view class="turn {{item.role}}">{{item.content}}</view>
      </view>

      <view wx:if="{{!currentStepHasTurns && !atFoundationGate && !flowComplete}}" class="turn-wrap assistant">
        <view class="turn-step">模块 {{moduleId}} · {{stepTitle}}</view>
        <view class="turn assistant">{{currentQuestion}}</view>
      </view>

      <view wx:if="{{note}}" class="status-note">{{note}}</view>

      <view wx:if="{{atFoundationGate}}" class="gate-card">
        <view class="gate-kicker">阶段完成</view>
        <view class="gate-title">模块 1–4 已聊完</view>
        <view class="gate-copy">先核对这份 IP 人设定位报告。明确确认后，系统才会进入模块 5。</view>

        <view wx:if="{{reportVisible}}" class="report-preview">
          <view class="report-title">{{reportTitle}}</view>
          <view class="report-meta">{{reportProgressText}}</view>
          <view wx:if="{{reportStale}}" class="warning">前四个模块的回答有更新，请重新生成报告。</view>
          <view class="report-summary">{{reportSummary}}</view>

          <view wx:for="{{reportModules}}" wx:key="id" class="report-module">
            <view class="report-module-title">模块 {{item.id}} · {{item.title}}</view>
            <view class="report-module-summary">{{item.summary}}</view>
            <view wx:for="{{item.findings}}" wx:for-item="finding" wx:key="title" class="finding">
              <text class="finding-kind">{{finding.kind}}</text>
              <text>{{finding.title}}：{{finding.detail}}</text>
            </view>
          </view>

          <view wx:if="{{reportPriorities.length}}" class="report-section-title">下一步优先级</view>
          <view wx:for="{{reportPriorities}}" wx:key="priority" class="report-line">
            <text class="report-tag">{{item.priority}}</text><text>{{item.task}} · {{item.output}}</text>
          </view>

          <view wx:if="{{reportConfirmations.length}}" class="report-section-title">待本人确认</view>
          <view wx:for="{{reportConfirmations}}" wx:key="item" class="report-line">
            <text class="report-tag">{{item.required ? '必须' : '建议'}}</text><text>{{item.item}}：{{item.reason}}</text>
          </view>

          <view wx:if="{{!reportFoundation}}" class="legacy-report">
            <view wx:for="{{reportPains}}" wx:key="painIndex" class="legacy-item">
              <view class="report-module-title">{{item.pain}}</view><view class="report-module-summary">{{item.why}}</view>
            </view>
            <view wx:for="{{reportExecution}}" wx:key="phase" class="legacy-item">
              <view class="report-module-title">{{item.phase}} · {{item.goal}}</view>
            </view>
            <view wx:for="{{reportMetrics}}" wx:key="name" class="legacy-item">
              <view class="report-module-title">{{item.name}}</view><view class="report-module-summary">{{item.definition}}</view>
            </view>
          </view>

          <view wx:if="{{reportGaps.length}}" class="report-section-title">资料缺口</view>
          <view wx:for="{{reportGaps}}" wx:key="gap" class="report-line">
            <text class="report-tag">{{item.blocking ? '阻塞' : '可后补'}}</text><text>{{item.gap}}</text>
          </view>
          <view class="report-boundary">{{reportDisclaimer}}</view>

          <view wx:if="{{reportPdfUrl}}" class="secondary-action {{pdfBusy?'disabled':''}}" bindtap="downloadReport">
            {{pdfBusy ? '正在准备 PDF…' : '预览并保存 PDF'}}
          </view>
          <view wx:if="{{reportCanConfirm}}" class="primary-action {{busy?'disabled':''}}" bindtap="confirmReport">
            {{busy ? '确认中…' : '我已核对，确认 IP 底座'}}
          </view>
        </view>

        <view wx:if="{{!reportVisible || reportStale || !reportFoundation}}" class="generate-box">
          <checkbox-group bindchange="onReportConsent">
            <label class="consent"><checkbox value="accepted" checked="{{reportConsent}}" color="#8b5cf6"/>我同意将模块 1–4 的已保存回答发送给 AI 生成报告</label>
          </checkbox-group>
          <view class="primary-action {{busy||!reportConsent?'disabled':''}}" bindtap="generateReport">
            {{busy ? '生成中…' : (reportVisible ? '重新生成阶段报告' : '生成阶段报告')}}
          </view>
        </view>
      </view>

      <view wx:if="{{flowComplete}}" class="gate-card complete-card">
        <view class="gate-kicker">本期完成</view>
        <view class="gate-title">六个模块已完成</view>
        <view class="gate-copy">本期流程到“文案口播”为止。模块 7–12 正在开发中，敬请期待。</view>
      </view>

      <view wx:if="{{reportVisible && !atFoundationGate}}" class="saved-report">
        <view>
          <view class="saved-report-title">{{reportTitle}}</view>
          <view class="saved-report-copy">{{reportProgressText}} · {{reportConfirmed ? '已确认' : '待确认'}}</view>
        </view>
        <view wx:if="{{reportPdfUrl}}" class="text-action" bindtap="downloadReport">查看 PDF</view>
      </view>

      <view id="chat-end" class="chat-end"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!atFoundationGate && !flowComplete}}" class="composer">
    <view class="composer-tools">
      <view class="text-action {{previousDisabled||busy?'disabled':''}}" bindtap="previousStep">上一题</view>
      <view class="question-index">本模块 {{currentStepText}}</view>
      <view class="text-action {{busy?'disabled':''}}" bindtap="skipCurrent">暂时跳过</view>
    </view>
    <view class="input-row">
      <textarea class="chat-input" value="{{guideInput}}" bindinput="onGuideInput" maxlength="1200"
        auto-height fixed="true" cursor-spacing="18" placeholder="回答当前问题…" placeholder-class="placeholder"></textarea>
      <view class="send {{busy||guideBusy?'disabled':''}}" bindtap="askGuide">{{guideBusy ? '…' : '发送'}}</view>
    </view>
    <checkbox-group bindchange="onGuideConsent">
      <label class="consent compact"><checkbox value="accepted" checked="{{guideConsent}}" color="#8b5cf6"/>同意将本次回答发送给 AI 进行整理</label>
    </checkbox-group>
  </view>

  <view wx:if="{{modulesOpen}}" class="drawer">
    <view class="drawer-mask" bindtap="closeModules"></view>
    <scroll-view class="drawer-panel" scroll-y>
      <view class="drawer-head">
        <view><view class="drawer-title">IP 孵化流程</view><view class="drawer-copy">开放至文案口播</view></view>
        <view class="drawer-close" bindtap="closeModules">×</view>
      </view>
      <view wx:for="{{modules}}" wx:key="id" data-index="{{item.index}}" bindtap="jumpModule"
        class="module-item {{item.active?'active':''}} {{item.done?'done':''}} {{item.locked?'locked':''}} {{item.comingSoon?'coming':''}}">
        <view class="module-number">{{item.id}}</view>
        <view class="module-body">
          <view class="module-name">{{item.name}}</view>
          <view wx:if="{{item.comingSoon}}" class="module-state">正在开发中，敬请期待</view>
          <view wx:elif="{{item.locked}}" class="module-state">确认模块 1–4 报告后解锁</view>
          <view wx:else class="module-state">{{item.done ? '已完成' : (item.progressed + ' / ' + item.steps)}}</view>
        </view>
        <view class="module-arrow">›</view>
      </view>
    </scroll-view>
  </view>
</view>
