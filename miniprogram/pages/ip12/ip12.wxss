.hero { background: linear-gradient(135deg, rgba(139,69,224,.28), rgba(226,75,160,.18)); }
.hero-title, .report-title { color: var(--text); font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.progress { height: 16rpx; overflow: hidden; margin-top: 24rpx; background: var(--surface-muted); border-radius: 20rpx; }
.progress-fill { height: 100%; min-width: 0; background: var(--grad); border-radius: inherit; transition: width .2s ease; }
.progress-copy, .note { margin-top: 12rpx; color: var(--text-muted); font-size: 23rpx; line-height: 1.6; }
.module-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.module { padding: 16rpx; border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--text-muted); font-size: 23rpx; background: var(--surface-muted); }
.module.active { color: var(--primary-ink); border-color: var(--primary); background: var(--primary-soft); }
.module.done { color: var(--success); border-color: rgba(43,213,118,.5); }
.module.coming-soon { opacity: .7; border-style: dashed; }
.module-name { font-weight: 600; line-height: 1.4; }
.module-state { margin-top: 7rpx; font-size: 20rpx; }
.step-kicker { color: var(--primary-ink); font-size: 21rpx; letter-spacing: 1rpx; }
.step-title { color: var(--text); font-size: 34rpx; font-weight: 700; margin: 14rpx 0; }
.why { margin-top: 18rpx; padding: 17rpx; border-radius: 12rpx; background: var(--surface-muted); color: var(--text-muted); font-size: 23rpx; line-height: 1.6; }
.state-note { margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 10rpx; font-size: 22rpx; }
.state-note.warning { color: var(--warning); background: rgba(240,184,75,.12); }
.state-note.success { color: var(--success); background: rgba(43,213,118,.1); }
.answer-label { display: block; margin-top: 22rpx; color: var(--text); font-size: 25rpx; font-weight: 600; line-height: 1.5; }
.answer { width: 100%; min-height: 180rpx; box-sizing: border-box; margin-top: 14rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface-muted); color: var(--text); font-size: 27rpx; }
.ph { color: #6f6980; }
.choice { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 13rpx; padding: 19rpx; border: 1rpx solid var(--line); border-radius: 13rpx; background: var(--surface-muted); color: var(--text-muted); font-size: 24rpx; line-height: 1.5; }
.choice.selected { border-color: var(--primary); background: var(--primary-soft); color: var(--text); }
.choice-dot { width: 18rpx; height: 18rpx; margin-top: 8rpx; border: 2rpx solid var(--text-muted); border-radius: 50%; flex: none; }
.choice.selected .choice-dot { border-color: var(--primary); background: var(--primary); box-shadow: inset 0 0 0 4rpx var(--surface); }
.review-item { display: flex; gap: 14rpx; margin-top: 13rpx; padding: 17rpx; border-radius: 12rpx; background: var(--surface-muted); color: var(--text-muted); font-size: 24rpx; line-height: 1.55; }
.review-no { color: var(--primary-ink); font-weight: 700; flex: none; }
.btn-link { display: inline-block; margin-top: 17rpx; color: var(--primary-ink); font-size: 23rpx; }
.step-actions { display: flex; align-items: stretch; gap: 12rpx; margin-top: 24rpx; }
.btn-secondary { display: inline-block; margin-top: 16rpx; padding: 15rpx 20rpx; color: var(--primary-ink); border: 1rpx solid var(--primary); border-radius: 12rpx; font-size: 24rpx; text-align: center; }
.btn-secondary.compact, .btn-primary.compact { margin-top: 0; padding: 18rpx 14rpx; font-size: 23rpx; }
.btn-secondary.danger { color: var(--warning); border-color: rgba(240,184,75,.6); }
.grow { flex: 1; }
.disabled { opacity: .48; }
.save-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; }
.upload { margin-top: 16rpx; padding: 28rpx 18rpx; border: 2rpx dashed var(--line); border-radius: 14rpx; text-align: center; color: var(--text-muted); font-size: 24rpx; }
.file { display: flex; justify-content: space-between; gap: 12rpx; padding: 12rpx 0; color: var(--text-muted); font-size: 22rpx; border-bottom: 1rpx solid var(--line); }
.file text:last-child { color: var(--primary); flex: none; }
.consent { display: flex; align-items: flex-start; gap: 8rpx; margin: 20rpx 0 12rpx; color: var(--text); font-size: 24rpx; line-height: 1.5; }
.sub-label { margin-top: 20rpx; color: var(--primary-ink); font-size: 25rpx; font-weight: 600; }
.bullet { margin-top: 10rpx; color: var(--text-muted); font-size: 24rpx; line-height: 1.6; }
.analysis-section { margin-top: 24rpx; border-top: 1rpx solid var(--line); padding-top: 6rpx; }
.analysis-note { margin-top: 18rpx; color: var(--text); line-height: 1.6; font-size: 24rpx; }
.candidate { margin-top: 18rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface-muted); }
.candidate.selected { border-color: var(--primary); background: var(--primary-soft); }
.candidate-title { color: var(--text); font-size: 27rpx; font-weight: 600; margin-bottom: 8rpx; }
.candidate-state { margin-top: 12rpx; color: var(--primary-ink); font-size: 22rpx; }
.resume-item { margin-top: 12rpx; padding: 15rpx; border-radius: 11rpx; color: var(--primary-ink); background: var(--surface-muted); font-size: 23rpx; line-height: 1.5; }
.action-boundary { margin-top: 20rpx; }
.guide-card { border-color: rgba(139,69,224,.35); }
.guide-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.guide-head .btn-link { margin-top: 0; flex: none; }
.guide-welcome, .guide-turn { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; color: var(--text-muted); background: var(--surface-muted); font-size: 24rpx; line-height: 1.6; }
.guide-turn.user { margin-left: 44rpx; color: var(--text); background: var(--primary-soft); }
.guide-turn.assistant { margin-right: 44rpx; }
.guide-draft { margin-top: 16rpx; padding: 16rpx; border: 1rpx solid var(--primary); border-radius: 12rpx; }
.guide-input { min-height: 120rpx; }
.guide-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.report-gate { border-color: rgba(226,75,160,.35); }
.report-wrap { margin-top: 8rpx; }
.report-hero { background: linear-gradient(145deg, rgba(77,141,255,.16), rgba(226,75,160,.14)); }
.report-meta { color: var(--primary-ink); font-size: 22rpx; }
.report-summary { margin-top: 20rpx; color: var(--text); font-size: 26rpx; line-height: 1.7; }
.report-download { margin-top: 22rpx; }
.report-download .small { margin-top: 10rpx; text-align: center; }
.report-item { margin-top: 18rpx; padding: 19rpx; border-radius: 14rpx; background: var(--surface-muted); }
.report-item-title { margin: 8rpx 0; color: var(--text); font-size: 27rpx; font-weight: 650; line-height: 1.5; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.tag { display: inline-block; margin-right: 8rpx; padding: 5rpx 10rpx; border-radius: 20rpx; color: var(--primary-ink); background: var(--primary-soft); font-size: 19rpx; }
.source, .metric-row { margin-top: 8rpx; color: var(--text-muted); font-size: 22rpx; line-height: 1.55; }
.product-match { margin-top: 16rpx; padding-top: 4rpx; border-top: 1rpx solid var(--line); }
.product-title-link { text-decoration: underline; text-underline-offset: 5rpx; }
