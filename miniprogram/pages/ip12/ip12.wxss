.ip12-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: var(--surface); color: var(--text); }
.topbar, .composer { flex: none; background: var(--surface); border-color: var(--line); }
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 25rpx 28rpx; border-bottom-width: 1rpx; border-bottom-style: solid; }
.eyebrow, .coach-copy, .conversation-time { color: var(--text-muted); font-size: 21rpx; }.module-title { margin-top: 5rpx; font-size: 31rpx; font-weight: 700; }.topbar-actions { display:flex; align-items:center; gap:10rpx; }.clone-trigger, .history-trigger { padding: 14rpx 18rpx; font-size: 22rpx; border: 1rpx solid var(--line); border-radius: 999rpx; }.clone-trigger { color:var(--primary-ink); }.history-trigger { color: var(--primary-ink); }
.chat { flex: 1; min-height: 0; }.chat-inner { padding: 28rpx 24rpx 36rpx; }.coach-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; }.bird { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; color:#fff8e8; font-weight:700; font-size:23rpx; border-radius:50%; background:linear-gradient(135deg,var(--grad),var(--grad)); }.coach-title { font-size: 25rpx; font-weight: 650; }
.turn-wrap { display:flex; margin-bottom:22rpx; }.turn-wrap.user { justify-content:flex-end; }.turn { max-width:84%; padding:21rpx 23rpx; border-radius:24rpx; font-size:27rpx; line-height:1.65; white-space:pre-wrap; word-break:break-word; }.turn.assistant { background:var(--surface); border:1rpx solid var(--line); border-top-left-radius:8rpx; }.turn.user { color:#fff8e8; background:var(--grad); border-top-right-radius:8rpx; }
.status-note { margin: 12rpx auto 26rpx; padding: 13rpx 18rpx; color:var(--text-muted); text-align:center; font-size:21rpx; line-height:1.5; background:rgba(255,253,247,.5); border-radius:999rpx; }.empty-card, .report-card { margin: 36rpx 4rpx; padding: 34rpx 28rpx; border:1rpx solid var(--line); border-radius:26rpx; background:var(--surface); }.empty-title, .report-title { font-size:33rpx; font-weight:700; }.empty-copy, .report-copy { margin-top:14rpx; color:var(--text-muted); font-size:24rpx; line-height:1.65; }.report-kicker { color:var(--primary-ink); font-size:20rpx; letter-spacing:2rpx; }
.primary-action, .secondary-action { margin-top:20rpx; padding:21rpx; border-radius:17rpx; text-align:center; font-size:25rpx; font-weight:650; }.primary-action { color:#fff8e8; background:linear-gradient(135deg,var(--grad),var(--grad)); }.secondary-action { color:var(--primary-ink); border:1rpx solid var(--line); }.disabled { opacity:.42; pointer-events:none; }
.composer { padding: 16rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); border-top-width:1rpx; border-top-style:solid; }.input-row { display:flex; align-items:flex-end; gap:12rpx; padding:10rpx 10rpx 10rpx 20rpx; border:1rpx solid var(--line); border-radius:24rpx; background:var(--surface); }.chat-input { flex:1; width:auto; min-height:52rpx; max-height:170rpx; padding:9rpx 0; color:var(--primary-ink); font-size:27rpx; line-height:1.5; }.placeholder { color:var(--text-muted); }.send { display:flex; align-items:center; justify-content:center; min-width:92rpx; height:70rpx; color:#fff8e8; font-size:23rpx; font-weight:650; border-radius:19rpx; background:linear-gradient(135deg,var(--grad),var(--grad)); }
.drawer { position:fixed; inset:0; z-index:30; }.drawer-mask { position:absolute; inset:0; background:rgba(44,39,30,0.58); }.drawer-panel { position:absolute; top:0; right:0; bottom:0; width:84%; padding:36rpx 24rpx; box-sizing:border-box; background:var(--surface); }.drawer-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:25rpx; }.drawer-title { font-size:31rpx; font-weight:700; }.drawer-copy { margin-top:5rpx; }.drawer-close { width:58rpx; text-align:center; color:var(--text-muted); font-size:39rpx; }.conversation-item { margin-bottom:10rpx; padding:20rpx 16rpx; border-radius:16rpx; background:rgba(255,253,247,.5); }.conversation-item.active { background:rgba(151,119,69,0.16); border:1rpx solid var(--line); }.conversation-title { font-size:25rpx; font-weight:600; }

.ip12-page { background:transparent; }
.turn.user { background:var(--grad); color:#fff8e8; }
