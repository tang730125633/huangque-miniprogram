.ip12-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #0b0b0e; color: #f7f5fb; }
.topbar, .composer { flex: none; background: #111116; border-color: rgba(255,255,255,.08); }
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 25rpx 28rpx; border-bottom-width: 1rpx; border-bottom-style: solid; }
.eyebrow, .coach-copy, .conversation-time { color: #8f889b; font-size: 21rpx; }.module-title { margin-top: 5rpx; font-size: 31rpx; font-weight: 700; }.history-trigger { padding: 14rpx 20rpx; color: #d9d0ed; font-size: 22rpx; border: 1rpx solid rgba(255,255,255,.14); border-radius: 999rpx; }
.chat { flex: 1; min-height: 0; }.chat-inner { padding: 28rpx 24rpx 36rpx; }.coach-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; }.bird { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; color:#fff; font-weight:700; font-size:23rpx; border-radius:50%; background:linear-gradient(135deg,#7657d8,#a758bd); }.coach-title { font-size: 25rpx; font-weight: 650; }
.turn-wrap { display:flex; margin-bottom:22rpx; }.turn-wrap.user { justify-content:flex-end; }.turn { max-width:84%; padding:21rpx 23rpx; border-radius:24rpx; font-size:27rpx; line-height:1.65; white-space:pre-wrap; word-break:break-word; }.turn.assistant { background:#1b1a20; border:1rpx solid rgba(255,255,255,.07); border-top-left-radius:8rpx; }.turn.user { color:#fff; background:#5f46b8; border-top-right-radius:8rpx; }
.status-note { margin: 12rpx auto 26rpx; padding: 13rpx 18rpx; color:#aaa3b5; text-align:center; font-size:21rpx; line-height:1.5; background:rgba(255,255,255,.04); border-radius:999rpx; }.empty-card, .report-card { margin: 36rpx 4rpx; padding: 34rpx 28rpx; border:1rpx solid rgba(139,92,246,.34); border-radius:26rpx; background:#17161b; }.empty-title, .report-title { font-size:33rpx; font-weight:700; }.empty-copy, .report-copy { margin-top:14rpx; color:#aaa3b5; font-size:24rpx; line-height:1.65; }.report-kicker { color:#b8a0f3; font-size:20rpx; letter-spacing:2rpx; }
.primary-action, .secondary-action { margin-top:20rpx; padding:21rpx; border-radius:17rpx; text-align:center; font-size:25rpx; font-weight:650; }.primary-action { color:#fff; background:linear-gradient(135deg,#7657d8,#a758bd); }.secondary-action { color:#c7b7ef; border:1rpx solid rgba(170,139,235,.45); }.disabled { opacity:.42; pointer-events:none; }
.composer { padding: 16rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); border-top-width:1rpx; border-top-style:solid; }.input-row { display:flex; align-items:flex-end; gap:12rpx; padding:10rpx 10rpx 10rpx 20rpx; border:1rpx solid rgba(255,255,255,.12); border-radius:24rpx; background:#1c1b21; }.chat-input { flex:1; width:auto; min-height:52rpx; max-height:170rpx; padding:9rpx 0; color:#f7f5fb; font-size:27rpx; line-height:1.5; }.placeholder { color:#6f6978; }.send { display:flex; align-items:center; justify-content:center; min-width:92rpx; height:70rpx; color:#fff; font-size:23rpx; font-weight:650; border-radius:19rpx; background:linear-gradient(135deg,#7657d8,#a758bd); }
.drawer { position:fixed; inset:0; z-index:30; }.drawer-mask { position:absolute; inset:0; background:rgba(0,0,0,.68); }.drawer-panel { position:absolute; top:0; right:0; bottom:0; width:84%; padding:36rpx 24rpx; box-sizing:border-box; background:#121116; }.drawer-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:25rpx; }.drawer-title { font-size:31rpx; font-weight:700; }.drawer-copy { margin-top:5rpx; }.drawer-close { width:58rpx; text-align:center; color:#aaa3b4; font-size:39rpx; }.conversation-item { margin-bottom:10rpx; padding:20rpx 16rpx; border-radius:16rpx; background:rgba(255,255,255,.035); }.conversation-item.active { background:rgba(139,92,246,.17); border:1rpx solid rgba(139,92,246,.42); }.conversation-title { font-size:25rpx; font-weight:600; }
