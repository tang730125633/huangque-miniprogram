<view class="container">
  <view class="card user-card">
    <view class="avatar-ring"><view class="avatar">{{initial}}</view></view>
    <view class="user-meta">
      <view class="user-name-line">
        <view class="user-name">{{user.name || user.display_name || user.username || '未登录'}}</view>
        <view class="membership-badge {{membership.tierClass}}">{{membership.name}}</view>
        <view wx:if="{{isAdmin}}" class="role-badge">管理员</view>
      </view>
      <view class="muted small">{{user.username}}</view>
    </view>
  </view>

  <view class="card membership-card {{membership.tierClass}}">
    <view class="membership-heading">
      <view>
        <view class="membership-eyebrow">会员账户</view>
        <view class="membership-name">{{membership.name}}</view>
      </view>
      <view class="membership-status {{membership.status}}">{{membership.statusText}}</view>
    </view>
    <view class="membership-details">
      <view class="membership-row">
        <text class="membership-label">有效期至</text>
        <text class="membership-value">{{membership.expiresText}}</text>
      </view>
      <view class="membership-row">
        <text class="membership-label">点数购买</text>
        <text class="membership-value">{{membership.discountText}}</text>
      </view>
    </view>
    <view wx:if="{{membership.status !== 'active'}}" class="membership-action" bindtap="goRecharge">
      <view>
        <view class="membership-action-title">开通一年体验官</view>
        <view class="muted small">¥499 · 赠 1000 点</view>
      </view>
      <view class="membership-action-button">立即开通</view>
    </view>
    <view wx:else class="membership-action" bindtap="goRecharge">
      <view>
        <view class="membership-action-title">会员专享点数充值</view>
        <view class="muted small">固定点数包或自定义充值</view>
      </view>
      <view class="membership-action-button">去充值</view>
    </view>
  </view>

  <view class="card points-card">
    <text class="muted">账户点数</text>
    <text class="points-num">{{user.points === undefined ? '—' : user.points}}</text>
    <view class="muted small tip">点数用于体验生成任务 · 失败自动返还</view>
  </view>

  <view class="card menu-card">
    <view class="menu-item bordered" bindtap="goCard">
      <view class="mi-left"><text>我的公开名片</text></view>
      <text class="muted">›</text>
    </view>
    <view class="menu-item bordered" bindtap="goNetwork">
      <view class="mi-left"><text>人脉星球</text></view>
      <text class="muted">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="menu-item bordered admin-entry" bindtap="goAdmin">
      <view class="mi-left"><image class="mi-ic" src="../../assets/icons/warn.svg"></image><text>管理中心</text></view>
      <text class="muted">›</text>
    </view>
    <view class="menu-item bordered" bindtap="goAssets">
      <view class="mi-left"><image class="mi-ic" src="../../assets/icons/folder.svg"></image><text>我的资产</text></view>
      <text class="muted">›</text>
    </view>
    <view class="menu-item bordered" bindtap="goClone">
      <view class="mi-left"><image class="mi-ic" src="../../assets/icons/mic.svg"></image><text>声音克隆</text></view>
      <text class="muted">›</text>
    </view>
    <view wx:if="{{membership.status==='active'}}" class="menu-item bordered" bindtap="goInvite">
      <view class="mi-left"><image class="mi-ic" src="../../assets/icons/gift.svg"></image><text>邀请中心</text></view>
      <text class="muted">›</text>
    </view>
    <view class="menu-item bordered" bindtap="goAudio">
      <view class="mi-left"><image class="mi-ic" src="../../assets/icons/em_wave.svg"></image><text>AI 配音</text></view>
      <text class="muted">›</text>
    </view>
    <view class="menu-item" bindtap="refresh">
      <view class="mi-left"><image class="mi-ic" src="../../assets/icons/refresh.svg"></image><text>刷新账户信息</text></view>
      <text class="muted">›</text>
    </view>
  </view>

  <view class="legal-links">
    <navigator class="legal-link" url="/pages/legal/legal?type=privacy">隐私保护指引</navigator>
    <text class="legal-dot">·</text>
    <navigator class="legal-link" url="/pages/legal/legal?type=terms">用户服务协议</navigator>
    <text class="legal-dot">·</text>
    <navigator class="legal-link" url="/pages/legal/legal?type=ai">AI 生成内容说明</navigator>
  </view>

  <view class="logout" bindtap="logout">退出登录</view>
</view>
