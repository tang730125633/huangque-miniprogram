.small { font-size: 22rpx; }
.user-card { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; }
.avatar-ring {
  width: 104rpx; height: 104rpx; border-radius: 50%; flex: none; padding: 4rpx;
  background: linear-gradient(135deg, #e24ba0, #4d8dff);
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--surface); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 600;
}
.user-name { font-size: 32rpx; font-weight: 600; color: var(--text); }
.user-name-line { display: flex; align-items: center; gap: 14rpx; }
.role-badge {
  padding: 5rpx 13rpx; border-radius: 999rpx;
  color: #ffd9ef; background: rgba(226,75,160,0.18);
  border: 1rpx solid rgba(226,75,160,0.5); font-size: 20rpx; font-weight: 600;
}

.points-card { text-align: center; padding: 40rpx 28rpx; }
.points-card .points-num { display: block; font-size: 72rpx; font-weight: 500; margin: 12rpx 0; color: var(--secondary); }
.tip { margin-top: 8rpx; }

.menu-card { padding: 8rpx 28rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; font-size: 29rpx; color: var(--text); }
.menu-item.bordered { border-bottom: 1rpx solid var(--line); }
.mi-left { display: flex; align-items: center; gap: 16rpx; }
.mi-ic { width: 36rpx; height: 36rpx; }
.admin-entry { color: var(--primary-ink); }

.logout {
  margin-top: 20rpx; text-align: center; padding: 26rpx;
  border-radius: 16rpx; border: 1rpx solid rgba(194,65,58,0.4);
  color: var(--error); font-size: 29rpx;
}
