.container { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.small { font-size: 22rpx; }
.user-card { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; }
.avatar-ring {
  width: 104rpx; height: 104rpx; border-radius: 50%; flex: none; padding: 4rpx;
  background: linear-gradient(135deg, #e24ba0, #4d8dff);
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--surface); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 600;
}
.user-name { font-size: 32rpx; font-weight: 600; color: var(--text); }
.user-meta { min-width: 0; flex: 1; }
.user-name { max-width: 100%; overflow-wrap: anywhere; }
.user-name-line { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.role-badge {
  padding: 5rpx 13rpx; border-radius: 999rpx;
  color: #ffd9ef; background: rgba(226,75,160,0.18);
  border: 1rpx solid rgba(226,75,160,0.5); font-size: 20rpx; font-weight: 600;
}
.membership-badge {
  padding: 5rpx 13rpx; border-radius: 999rpx; flex: none;
  color: #c6c1d1; background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.12); font-size: 20rpx; font-weight: 600;
}
.membership-badge.experience { color: #ffd7a1; border-color: rgba(240,165,75,0.45); background: rgba(240,165,75,0.12); }
.membership-badge.partner { color: #bcd4ff; border-color: rgba(77,141,255,0.48); background: rgba(77,141,255,0.13); }
.membership-badge.initiator { color: #ffd0e9; border-color: rgba(226,75,160,0.48); background: rgba(226,75,160,0.13); }
.membership-badge.expired { color: #c6c1d1; }

.membership-card {
  position: relative; overflow: hidden;
  border-color: rgba(255,255,255,0.12);
}
.membership-card.experience { border-color: rgba(240,165,75,0.34); }
.membership-card.partner { border-color: rgba(77,141,255,0.38); }
.membership-card.initiator { border-color: rgba(226,75,160,0.38); }
.membership-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.membership-eyebrow { color: var(--text-muted); font-size: 22rpx; }
.membership-name { margin-top: 8rpx; color: var(--text); font-size: 34rpx; font-weight: 600; }
.membership-status {
  min-width: 92rpx; padding: 8rpx 14rpx; box-sizing: border-box;
  border-radius: 10rpx; text-align: center; font-size: 21rpx;
  color: var(--text-muted); background: rgba(255,255,255,0.05);
}
.membership-status.active { color: #91efb7; background: rgba(43,213,118,0.12); }
.membership-status.expired { color: #ffc2d2; background: rgba(255,92,138,0.12); }
.membership-details { margin-top: 26rpx; border-top: 1rpx solid var(--line); }
.membership-row {
  min-height: 74rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.membership-row:last-child { border-bottom: 0; }
.membership-label { color: var(--text-muted); font-size: 24rpx; }
.membership-value { color: var(--text); font-size: 25rpx; font-weight: 500; text-align: right; }
.membership-action { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: rgba(255,255,255,0.035); }
.membership-action-title { color: var(--text); font-size: 24rpx; font-weight: 600; }
.membership-action-button { padding: 12rpx 18rpx; border-radius: 999rpx; color: #fff; background: var(--grad); font-size: 22rpx; white-space: nowrap; }

.points-card { text-align: center; padding: 40rpx 28rpx; }
.points-card .points-num { display: block; font-size: 72rpx; font-weight: 500; margin: 12rpx 0; color: var(--secondary); }
.tip { margin-top: 8rpx; }

.menu-card { padding: 8rpx 28rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 0; font-size: 29rpx; color: var(--text); }
.menu-item.bordered { border-bottom: 1rpx solid var(--line); }
.mi-left { display: flex; align-items: center; gap: 16rpx; }
.mi-ic { width: 36rpx; height: 36rpx; }
.admin-entry { color: var(--primary-ink); }

.logout {
  margin-top: 20rpx; text-align: center; padding: 26rpx;
  border-radius: 16rpx; border: 1rpx solid rgba(194,65,58,0.4);
  color: var(--error); font-size: 29rpx;
}
.legal-links {
  padding: 10rpx 12rpx 4rpx; display: flex; flex-wrap: wrap;
  align-items: center; justify-content: center; gap: 10rpx;
  color: var(--text-muted); font-size: 22rpx; line-height: 1.8;
}
.legal-dot { opacity: .55; }
.legal-link { color: inherit; display: inline; }
