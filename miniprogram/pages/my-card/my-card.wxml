<view class="container owner-page">
  <canvas canvas-id="cardShareCover" class="share-canvas" />

  <view wx:if="{{state === 'loading'}}" class="state-card">正在加载名片…</view>

  <view wx:elif="{{state === 'missing'}}" class="welcome">
    <view class="eyebrow">BUSINESS CARD</view>
    <view class="welcome-title">创建你的黄雀名片</view>
    <view class="welcome-copy">名片是可选功能。创建后可展示个人信息与作品，并分享给好友。</view>
    <button class="primary" bindtap="createCard">创建我的名片</button>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-card error">
    <view>{{error}}</view>
    <button class="secondary compact" bindtap="retry">重新加载</button>
  </view>

  <block wx:else>
    <view class="topline">
      <view class="header-copy">
        <view class="page-title">我的名片</view>
        <view class="public-state {{published ? 'online' : ''}}">● {{published ? '公开中' : '仅自己可见'}}</view>
      </view>
      <view class="header-actions">
        <view class="header-action header-edit" bindtap="editCard">✎ 编辑</view>
        <button wx:if="{{shareReady}}" class="header-action header-share" open-type="share">↗ 分享</button>
        <button wx:else class="header-action header-share disabled" bindtap="promptShare">↗ 分享</button>
      </view>
    </view>

    <view class="business-card">
      <view class="card-mark">雀</view>
      <view class="card-profile">
        <view class="avatar-shell">
          <image wx:if="{{card.avatar}}" class="avatar" src="{{card.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar initial">{{initial}}</view>
          <view class="brand-badge">雀</view>
        </view>
        <view class="profile-copy">
          <view class="name">{{card.name || '待填写姓名'}}</view>
          <view class="role">{{card.title || '待填写身份 / 职称'}}<text wx:if="{{card.company}}"> · {{card.company}}</text></view>
          <view wx:if="{{card.bio}}" class="bio">{{card.bio}}</view>
          <view wx:if="{{tagsList.length}}" class="tags"><text class="tag" wx:for="{{tagsList}}" wx:key="*this">{{item}}</text></view>
        </view>
      </view>
      <view class="contact-grid">
        <view class="contact-item" bindtap="callPhone"><text class="contact-icon">☎</text><text class="contact-value">{{card.phone || '待补充'}}</text></view>
        <view class="contact-item"><text class="contact-icon">⌖</text><text class="contact-value">{{card.address || '待补充'}}</text></view>
        <view class="contact-item" bindtap="openWechat"><text class="contact-icon">◎</text><text class="contact-value">{{card.wechat_qr ? '查看微信' : '待补充'}}</text></view>
      </view>
    </view>

    <view class="planet-entry" bindtap="openInvitePlanet">
      <view class="planet-entry-orb">✦</view>
      <view class="planet-entry-copy">
        <view class="planet-entry-title">邀请星球</view>
        <view class="planet-entry-subtitle">查看我的邀请关系与上下级</view>
      </view>
      <view class="planet-entry-arrow">›</view>
    </view>

    <view class="content-card work-card">
      <view class="section-head"><view class="section-heading">作品与经历</view><view class="manage-link" bindtap="editCard">管理内容</view></view>
      <view class="work-image-list">
        <view class="work-media image" wx:for="{{workImages}}" wx:key="slot">
          <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" />
          <view wx:else class="work-placeholder image-placeholder" bindtap="editCard">＋ 添加长图 {{item.slot}}</view>
          <view wx:if="{{item.title}}" class="work-caption">{{item.title}}</view>
        </view>
      </view>
    </view>

    <view class="content-card work-card">
      <view class="section-head"><view class="section-heading">我的视频</view><view class="manage-link" bindtap="editCard">管理内容</view></view>
      <view class="work-video-list">
        <view class="work-media video" wx:for="{{workVideos}}" wx:key="slot">
          <video wx:if="{{item.url}}" src="{{item.url}}" poster="{{item.poster || item.cover_url}}" controls="true" show-center-play-btn="true" object-fit="cover" binderror="videoError" />
          <view wx:else class="work-placeholder video-placeholder" bindtap="editCard">▷ 添加横版视频 {{item.slot}}</view>
          <view wx:if="{{item.url && item.title}}" class="work-caption">{{item.title}}</view>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="primary" bindtap="editCard">{{complete ? '编辑名片' : '填写名片'}}</button>
      <button wx:if="{{published}}" class="secondary" bindtap="openCard">预览公开页</button>
      <button wx:if="{{shareReady}}" class="secondary" open-type="share">分享我的名片</button>
    </view>
    <view wx:if="{{error}}" class="inline-error">{{error}}</view>
  </block>

</view>
