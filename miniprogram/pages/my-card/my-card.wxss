.owner-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.share-canvas { position: fixed; left: -600px; top: -500px; width: 500px; height: 400px; opacity: 0; pointer-events: none; }
.state-card, .welcome, .notice { margin-top: 28rpx; padding: 42rpx 32rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); color: var(--text-muted); text-align: center; }
.welcome { margin-top: 110rpx; text-align: left; background: radial-gradient(circle at 80% 5%, rgba(226,75,160,.22), transparent 42%), var(--surface); }
.eyebrow { color: var(--secondary); font-size: 21rpx; letter-spacing: 3rpx; }
.welcome-title, .page-title { margin-top: 18rpx; color: var(--text); font-size: 42rpx; line-height: 1.25; font-weight: 700; }
.welcome-copy, .notice-copy { margin: 22rpx 0 34rpx; color: var(--text-muted); font-size: 25rpx; line-height: 1.8; }
.topline { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; margin: 26rpx 2rpx 28rpx; }
.page-title { margin-top: 9rpx; font-size: 34rpx; }
.account-link { flex: none; color: var(--primary-ink); font-size: 22rpx; }
.notice { margin-top: 12rpx; text-align: left; border-color: rgba(240,165,75,.45); }
.notice-title { color: var(--text); font-size: 30rpx; font-weight: 700; }
.business-card { position: relative; overflow: hidden; padding: 54rpx 36rpx 40rpx; border: 1rpx solid rgba(240,165,75,.35); border-radius: 34rpx; background: linear-gradient(155deg, #211629, #10101a 70%); text-align: center; }
.card-glow { position: absolute; right: -80rpx; top: -100rpx; width: 340rpx; height: 340rpx; border-radius: 50%; background: rgba(226,75,160,.18); filter: blur(30rpx); }
.avatar { position: relative; width: 150rpx; height: 150rpx; margin: 0 auto 24rpx; border: 3rpx solid rgba(240,165,75,.6); border-radius: 50%; background: var(--surface-muted); }
.initial { display: flex; align-items: center; justify-content: center; color: var(--secondary); font-size: 58rpx; font-weight: 700; }
.name { position: relative; color: var(--text); font-size: 42rpx; font-weight: 700; }
.role, .bio { position: relative; margin-top: 12rpx; color: var(--text-muted); font-size: 25rpx; line-height: 1.7; }
.bio { color: var(--text); }
.tags { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-top: 20rpx; }
.tag { padding: 7rpx 15rpx; border-radius: 999rpx; color: var(--secondary); background: rgba(240,165,75,.1); font-size: 20rpx; }
.status-row { position: relative; display: flex; justify-content: center; gap: 12rpx; margin-top: 28rpx; }
.status { padding: 7rpx 16rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--text-muted); font-size: 20rpx; }
.status.online { border-color: rgba(43,213,118,.5); color: var(--success); }
.content-card { margin-top: 20rpx; padding: 30rpx 28rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); }
.section-heading { margin-bottom: 18rpx; color: var(--text); font-size: 29rpx; font-weight: 700; }
.detail-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); color: var(--text); font-size: 23rpx; overflow-wrap: anywhere; }
.detail-row:last-child { border-bottom: 0; }
.detail-row text:first-child { flex: none; color: var(--text-muted); }
.work-image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.work-video-list { display: flex; flex-direction: column; gap: 16rpx; }
.work-media { position: relative; min-width: 0; overflow: hidden; border-radius: 18rpx; background: var(--surface-muted); }
.work-media image { display: block; width: 100%; height: 190rpx; }
.work-media.video video { display: block; width: 100%; height: 330rpx; }
.work-caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 28rpx 12rpx 11rpx; overflow: hidden; color: #fff; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; background: linear-gradient(transparent, rgba(4,3,8,.84)); }
.actions { margin-top: 24rpx; }
.primary, .secondary { width: 100%; margin-top: 18rpx; padding: 23rpx; box-sizing: border-box; border-radius: 999rpx; color: #fff; background: var(--grad); font-size: 28rpx; line-height: 1.2; }
.secondary { border: 1rpx solid rgba(226,75,160,.55); color: var(--primary-ink); background: transparent; }
.compact { width: auto; margin: 28rpx auto 0; padding: 18rpx 32rpx; }
button::after { border: 0; }
.error, .inline-error { color: var(--error); }
.inline-error { margin-top: 20rpx; text-align: center; font-size: 23rpx; }
