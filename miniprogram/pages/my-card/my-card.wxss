.owner-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(150rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.share-canvas { position: fixed; left: -600px; top: -500px; width: 500px; height: 400px; opacity: 0; pointer-events: none; }
.state-card, .welcome, .notice { margin-top: 28rpx; padding: 42rpx 32rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: var(--surface); color: var(--text-muted); text-align: center; }
.welcome { margin-top: 110rpx; text-align: left; background: radial-gradient(circle at 80% 5%, rgba(226,75,160,.22), transparent 42%), var(--surface); }
.eyebrow { color: var(--secondary); font-size: 21rpx; letter-spacing: 3rpx; }
.welcome-title, .page-title { margin-top: 18rpx; color: var(--text); font-size: 42rpx; line-height: 1.25; font-weight: 700; }
.welcome-copy, .notice-copy { margin: 22rpx 0 34rpx; color: var(--text-muted); font-size: 25rpx; line-height: 1.8; }
.topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; margin: 24rpx 4rpx 26rpx; }
.header-copy { min-width: 0; }
.page-title { margin: 0; color: #fff; font-size: 40rpx; line-height: 1.2; }
.public-state { margin-top: 9rpx; color: #9b8f9f; font-size: 21rpx; }
.public-state.online { color: #eeb442; }
.header-edit, .account-link { flex: none; display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 72rpx; margin-top: -8rpx; padding: 0 10rpx; box-sizing: border-box; color: #eeb442; font-size: 25rpx; font-weight: 600; }
.account-link { color: var(--primary-ink); font-size: 22rpx; font-weight: 400; }
.notice { margin-top: 12rpx; text-align: left; border-color: rgba(240,165,75,.45); }
.notice-title { color: var(--text); font-size: 30rpx; font-weight: 700; }
.business-card { position: relative; overflow: hidden; padding: 34rpx 28rpx 24rpx; border-radius: 34rpx; color: #332620; background: linear-gradient(135deg, #fff5ef 0%, #f1ded8 58%, #e7d2c9 100%); box-shadow: 0 18rpx 42rpx rgba(0,0,0,.2); }
.card-mark { position: absolute; right: -4rpx; bottom: 46rpx; color: rgba(157,111,79,.1); font-size: 210rpx; font-weight: 700; line-height: 1; }
.card-profile { position: relative; display: flex; align-items: flex-start; gap: 24rpx; min-height: 164rpx; }
.avatar-shell { position: relative; flex: none; width: 142rpx; height: 142rpx; padding: 7rpx; border: 4rpx solid #ecaa53; border-radius: 50%; background: linear-gradient(145deg, #f6bd61, #de6a94); box-shadow: 0 0 0 4rpx rgba(255,255,255,.72); }
.avatar { display: block; width: 142rpx; height: 142rpx; border-radius: 50%; background: #d9c8c0; }
.initial { display: flex; align-items: center; justify-content: center; color: #8f6040; font-size: 54rpx; font-weight: 700; }
.brand-badge { position: absolute; right: -5rpx; bottom: -4rpx; display: flex; align-items: center; justify-content: center; width: 39rpx; height: 39rpx; border: 3rpx solid #fff1df; border-radius: 50%; color: #6d431d; background: #efb13f; font-size: 19rpx; font-weight: 700; }
.profile-copy { min-width: 0; padding-top: 3rpx; }
.name { overflow: hidden; color: #30221e; font-size: 42rpx; font-weight: 700; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.role, .bio { margin-top: 10rpx; color: #624e45; font-size: 23rpx; line-height: 1.55; }
.bio { display: -webkit-box; overflow: hidden; color: #80665a; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 13rpx; }
.tag { padding: 5rpx 11rpx; border-radius: 999rpx; color: #856139; background: rgba(147,97,48,.11); font-size: 19rpx; }
.contact-grid { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 26rpx; border: 1rpx solid rgba(93,67,48,.15); border-radius: 20rpx; background: rgba(255,255,255,.36); }
.contact-item { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; min-height: 94rpx; padding: 11rpx 6rpx; border-right: 1rpx solid rgba(93,67,48,.12); }
.contact-item:last-child { border-right: 0; }
.contact-icon { color: #a66b24; font-size: 25rpx; line-height: 1; }
.contact-value { width: 100%; margin-top: 8rpx; overflow: hidden; color: #624b3e; font-size: 18rpx; line-height: 1.2; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.planet-entry { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 24rpx 26rpx; border: 1rpx solid rgba(238,180,66,.34); border-radius: 26rpx; background: linear-gradient(135deg, rgba(238,180,66,.13), rgba(176,72,200,.13)); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.08), 0 14rpx 32rpx rgba(0,0,0,.12); }
.planet-entry-orb { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border: 1rpx solid rgba(238,180,66,.62); border-radius: 50%; color: #ffe2a6; background: radial-gradient(circle at 35% 28%, #6f5530, #17100d 72%); box-shadow: 0 0 24rpx rgba(238,180,66,.2); font-size: 30rpx; }
.planet-entry-copy { min-width: 0; flex: 1; }
.planet-entry-title { color: #fff; font-size: 29rpx; font-weight: 700; }
.planet-entry-subtitle { margin-top: 6rpx; color: var(--text-muted); font-size: 22rpx; }
.planet-entry-arrow { color: #eeb442; font-size: 40rpx; line-height: 1; }
.content-card { margin-top: 32rpx; padding: 0; border: 0; background: transparent; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-bottom: 18rpx; }
.section-heading { position: relative; padding-bottom: 10rpx; color: #fff; font-size: 31rpx; font-weight: 700; }
.section-heading::after { position: absolute; bottom: 0; left: 0; width: 36rpx; height: 4rpx; border-radius: 999rpx; background: #eeb442; content: ''; }
.manage-link { flex: none; display: flex; align-items: center; min-height: 72rpx; padding: 0 4rpx 0 20rpx; color: #eeb442; font-size: 21rpx; }
.work-image-list { display: flex; flex-direction: column; gap: 18rpx; }
.work-video-list { display: flex; flex-direction: column; gap: 16rpx; }
.work-media { position: relative; min-width: 0; overflow: hidden; border-radius: 18rpx; background: var(--surface-muted); }
.work-media.image image { display: block; width: 100%; height: 760rpx; }
.work-media.video video { display: block; width: 100%; height: 350rpx; }
.work-placeholder { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx dashed rgba(255,255,255,.22); border-radius: 18rpx; color: var(--text-muted); background: rgba(255,255,255,.02); font-size: 24rpx; }
.image-placeholder { height: 760rpx; }
.video-placeholder { height: 350rpx; }
.work-caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 28rpx 12rpx 11rpx; overflow: hidden; color: #fff; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; background: linear-gradient(transparent, rgba(4,3,8,.84)); }
.actions { margin-top: 24rpx; }
.primary, .secondary { width: 100%; margin-top: 18rpx; padding: 23rpx; box-sizing: border-box; border-radius: 999rpx; color: #fff; background: var(--grad); font-size: 28rpx; line-height: 1.2; }
.secondary { border: 1rpx solid rgba(226,75,160,.55); color: var(--primary-ink); background: transparent; }
.compact { width: auto; margin: 28rpx auto 0; padding: 18rpx 32rpx; }
button::after { border: 0; }
.error, .inline-error { color: var(--error); }
.inline-error { margin-top: 20rpx; text-align: center; font-size: 23rpx; }
