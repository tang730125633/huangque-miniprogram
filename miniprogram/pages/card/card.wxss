.card-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(184rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(184rpx + env(safe-area-inset-bottom)); }
.share-canvas { position: fixed; left: -600px; top: -500px; width: 500px; height: 400px; opacity: 0; pointer-events: none; }
.state-card { margin-top: 90rpx; padding: 48rpx 32rpx; border: 1rpx solid var(--line); border-radius: 30rpx; color: var(--text-muted); background: var(--surface); text-align: center; }
.error { color: var(--error); }
.state-action { margin-top: 28rpx; padding: 22rpx; border-radius: 999rpx; color: #fff; background: var(--grad); }
.state-link { margin-top: 24rpx; color: var(--primary-ink); }
.state-link.disabled, .dock-button.disabled { opacity: .55; pointer-events: none; }

.identity-hero { position: relative; overflow: hidden; margin-top: 24rpx; padding: 28rpx 28rpx 30rpx; border: 1rpx solid rgba(240,165,75,.35); border-radius: 36rpx; background: linear-gradient(155deg, #2a1832, #101019 72%); box-shadow: 0 24rpx 70rpx rgba(0,0,0,.28); }
.hero-cover { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 300rpx; opacity: .24; filter: blur(10rpx); transform: scale(1.08); }
.hero-shade { position: absolute; left: 0; right: 0; top: 0; height: 360rpx; background: linear-gradient(rgba(8,6,14,.18), #15101e 92%); }
.hero-glow { position: absolute; border-radius: 50%; filter: blur(34rpx); }
.glow-one { right: -80rpx; top: -90rpx; width: 330rpx; height: 330rpx; background: rgba(226,75,160,.25); }
.glow-two { left: -90rpx; bottom: 20rpx; width: 260rpx; height: 260rpx; background: rgba(100,76,255,.16); }
.hero-kicker { position: relative; display: flex; justify-content: space-between; color: rgba(255,255,255,.65); font-size: 18rpx; letter-spacing: 2rpx; }
.hero-kicker text:last-child { color: var(--secondary); letter-spacing: 0; }
.identity-body { position: relative; padding: 54rpx 8rpx 14rpx; text-align: center; }
.avatar { width: 178rpx; height: 178rpx; margin: 0 auto 24rpx; border: 4rpx solid rgba(240,165,75,.72); border-radius: 50%; background: var(--surface-muted); box-shadow: 0 14rpx 38rpx rgba(0,0,0,.38); }
.initials { display: flex; align-items: center; justify-content: center; color: var(--secondary); font-size: 64rpx; font-weight: 700; }
.invite-context { margin-bottom: 12rpx; color: var(--secondary); font-size: 21rpx; }
.name { color: var(--text); font-size: 46rpx; font-weight: 750; letter-spacing: 1rpx; }
.role { margin-top: 12rpx; color: var(--text-muted); font-size: 25rpx; }
.bio { max-width: 580rpx; margin: 20rpx auto 0; color: var(--text); font-size: 25rpx; line-height: 1.75; white-space: pre-wrap; }
.tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-top: 22rpx; }
.tag { padding: 8rpx 16rpx; border: 1rpx solid rgba(240,165,75,.22); border-radius: 999rpx; color: var(--secondary); background: rgba(240,165,75,.1); font-size: 20rpx; }
.quick-actions { position: relative; display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.quick-action { flex: 1; min-width: 150rpx; display: flex; align-items: center; justify-content: center; gap: 9rpx; padding: 20rpx 12rpx; border: 1rpx solid rgba(255,255,255,.1); border-radius: 20rpx; color: var(--text); background: rgba(255,255,255,.045); font-size: 22rpx; }
.quick-icon { color: var(--secondary); font-size: 27rpx; }
.quick-value { max-width: 190rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.content-card { margin-top: 20rpx; padding: 30rpx 28rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: var(--surface); }
.section-heading { color: var(--text); font-size: 30rpx; font-weight: 700; }
.section-rule { width: 54rpx; height: 5rpx; margin: 14rpx 0 24rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--secondary), var(--primary)); }
.contact-row { display: grid; grid-template-columns: 150rpx minmax(0,1fr) auto; align-items: center; gap: 12rpx; padding: 21rpx 0; border-bottom: 1rpx solid var(--line); color: var(--text-muted); font-size: 23rpx; }
.contact-value { overflow: hidden; color: var(--text); text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.copy-mark { color: var(--primary-ink); font-size: 20rpx; }
.qr-card { display: flex; align-items: center; gap: 24rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 22rpx; color: var(--text); background: var(--surface-muted); font-size: 25rpx; }
.qr { width: 132rpx; height: 132rpx; border-radius: 16rpx; background: #fff; }
.qr-tip { margin-top: 9rpx; color: var(--text-muted); font-size: 21rpx; }
.work-image-list { display: flex; flex-direction: column; gap: 18rpx; }
.work-video-list { display: flex; flex-direction: column; gap: 18rpx; }
.work-media { position: relative; min-width: 0; overflow: hidden; border-radius: 20rpx; background: var(--surface-muted); }
.work-media.image image { display: block; width: 100%; height: 760rpx; }
.work-media.video video { display: block; width: 100%; height: 350rpx; }
.work-placeholder { display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx dashed rgba(255,255,255,.22); border-radius: 20rpx; color: var(--text-muted); background: rgba(255,255,255,.02); font-size: 24rpx; }
.image-placeholder { height: 760rpx; }
.video-placeholder { height: 350rpx; }
.work-caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 36rpx 13rpx 13rpx; overflow: hidden; color: #fff; font-size: 21rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; background: linear-gradient(transparent, rgba(4,3,8,.9)); }
.video-meta { display: flex; justify-content: space-between; gap: 18rpx; padding: 16rpx 18rpx; color: var(--text); font-size: 22rpx; }
.video-meta text:last-child { color: var(--text-muted); }

.action-dock { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; display: flex; gap: 14rpx; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(255,255,255,.08); background: rgba(11,9,18,.96); box-shadow: 0 -20rpx 50rpx rgba(0,0,0,.3); }
.dock-button { flex: 1; display: flex; align-items: center; justify-content: center; min-width: 0; margin: 0; padding: 23rpx 18rpx; box-sizing: border-box; border-radius: 999rpx; color: #fff; font-size: 27rpx; line-height: 1.2; text-align: center; }
.dock-button.primary { background: var(--grad); }
.dock-button.secondary { border: 1rpx solid rgba(226,75,160,.7); color: var(--primary-ink); background: #100c18; }
.join-button { width: 100%; }
.view-only-note { margin: 22rpx 24rpx 0; padding: 20rpx; border: 1rpx solid rgba(255,255,255,.12); border-radius: 18rpx; color: var(--text-muted); background: rgba(255,255,255,.04); text-align: center; font-size: 24rpx; }
button.dock-button::after { border: 0; }
