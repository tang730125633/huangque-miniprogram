.small { font-size: 22rpx; }
.ph { color: #6f6980; }

/* 头部 */
.vhead { padding: 8rpx 0 20rpx; }
.vhead-top { display: flex; align-items: center; justify-content: space-between; }
.vhead-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.pts {
  display: flex; align-items: center; gap: 6rpx;
  background: rgba(255,255,255,0.06); border: 1rpx solid var(--line);
  padding: 10rpx 22rpx; border-radius: 40rpx; color: var(--secondary); font-size: 24rpx; font-weight: 600;
}
.pts-ic { width: 30rpx; height: 30rpx; }
.vhead-mode { font-size: 23rpx; margin-top: 12rpx; }

/* 模式选择器 */
.mode-bar { white-space: nowrap; margin-bottom: 24rpx; }
.mode-card {
  position: relative; display: inline-block; width: 240rpx; vertical-align: top; margin-right: 16rpx;
  padding: 22rpx 20rpx; border-radius: 18rpx; box-sizing: border-box;
  background: var(--surface-muted); border: 1rpx solid var(--line);
}
.mode-card.on { background: var(--primary-soft); border-color: var(--primary); }
.mode-name { font-size: 27rpx; font-weight: 600; color: var(--text); white-space: normal; }
.mode-card.on .mode-name { color: var(--primary-ink); }
.mode-desc { font-size: 21rpx; color: var(--text-muted); margin-top: 8rpx; white-space: normal; line-height: 1.4; }
.mode-soon {
  position: absolute; right: 12rpx; top: 12rpx; font-size: 18rpx; color: #fff;
  background: rgba(148,141,168,0.6); padding: 2rpx 12rpx; border-radius: 20rpx;
}

/* 视频生成表单 */
.eng-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.eng { padding: 20rpx 10rpx; text-align: center; border-radius: 14rpx; color: var(--text-muted); background: var(--surface-muted); border: 1rpx solid var(--line); }
.eng.active { color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary); }
.eng-name { font-size: 25rpx; font-weight: 600; }
.eng-desc { font-size: 19rpx; margin-top: 6rpx; opacity: 0.85; }

.prompt {
  width: 100%; box-sizing: border-box; min-height: 150rpx;
  background: var(--surface); border: 1rpx solid var(--line);
  border-radius: 14rpx; padding: 22rpx; color: var(--text); font-size: 28rpx;
}

.upbox {
  height: 180rpx; border: 2rpx dashed var(--line); border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx;
  background: var(--surface-muted);
}
.ic-up { width: 52rpx; height: 52rpx; }
.up-preview { position: relative; }
.up-img { width: 100%; height: 300rpx; border-radius: 16rpx; }
.up-clear { position: absolute; top: 14rpx; right: 14rpx; background: rgba(0,0,0,0.55); color: #fff; font-size: 23rpx; padding: 6rpx 16rpx; border-radius: 10rpx; }

.ratio-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }
.chip { padding: 18rpx 4rpx; text-align: center; border-radius: 14rpx; color: var(--text-muted); background: var(--surface-muted); border: 1rpx solid var(--line); font-size: 23rpx; }
.chip.active { color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary); }

.note { text-align: center; font-size: 24rpx; margin: 18rpx 0 30rpx; line-height: 1.5; }

.result-video { width: 100%; height: 520rpx; border-radius: 16rpx; background: #000; }
.result-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ghost-btn { flex: 1; text-align: center; padding: 20rpx; border-radius: 14rpx; border: 1rpx solid var(--primary); color: var(--primary); font-size: 26rpx; }

/* 接入中模式 */
.soon-card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; padding: 34rpx 30rpx; }
.soon-title { font-size: 34rpx; font-weight: 700; color: var(--text); }
.soon-desc { font-size: 24rpx; margin-top: 14rpx; line-height: 1.6; }
.scaffold { margin: 28rpx 0; }
.sf-row {
  font-size: 26rpx; color: var(--text); padding: 22rpx 24rpx; margin-bottom: 14rpx;
  background: var(--surface-muted); border: 1rpx solid var(--line); border-radius: 14rpx;
}

/* 分段选择器（口播来源 / 换装类型） */
.seg { display: flex; gap: 10rpx; }
.seg-item {
  flex: 1; text-align: center; padding: 20rpx 8rpx; border-radius: 14rpx;
  font-size: 24rpx; color: var(--text-muted);
  background: var(--surface-muted); border: 1rpx solid var(--line);
}
.seg-item.on { color: var(--primary-ink); background: var(--primary-soft); border-color: var(--primary); font-weight: 600; }

/* 音色选择 */
.voice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.voice-card {
  position: relative; padding: 22rpx 18rpx; border-radius: 16rpx;
  background: var(--surface-muted); border: 1rpx solid var(--line);
}
.voice-card.on { background: var(--primary-soft); border-color: var(--primary); }
.voice-name { font-size: 26rpx; font-weight: 600; color: var(--text); }
.voice-card.on .voice-name { color: var(--primary-ink); }
.voice-sub { font-size: 21rpx; color: var(--text-muted); margin-top: 6rpx; }
.voice-play {
  position: absolute; right: 16rpx; top: 16rpx; width: 48rpx; height: 48rpx;
  border-radius: 50%; border: 1rpx solid var(--line); background: var(--surface);
  display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 22rpx;
}
.ic-pp-xs { width: 22rpx; height: 22rpx; }

/* ===== 电影化身：形象网格 ===== */
.avatar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.avatar-cell { text-align: center; border-radius: 14rpx; padding: 10rpx 6rpx; border: 2rpx solid transparent; }
.avatar-cell.on { border-color: var(--primary); background: var(--primary-soft); }
.avatar-img { width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--surface-muted); }
.avatar-ph { display: inline-block; }
.avatar-name { font-size: 21rpx; color: var(--text-muted); margin-top: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.avatar-cell.on .avatar-name { color: var(--primary); }
.avatar-add-ico {
  width: 108rpx; height: 108rpx; border-radius: 50%; margin: 0 auto;
  border: 2rpx dashed var(--line); color: var(--text-muted); font-size: 44rpx;
  display: flex; align-items: center; justify-content: center;
}
.avatar-add.disabled { opacity: 0.5; }

/* ===== 果肉参考图多选网格（最多7张）===== */
.ref-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.ref-cell { position: relative; }
.ref-img { width: 100%; height: 140rpx; border-radius: 12rpx; background: var(--surface-muted); }
.ref-del {
  position: absolute; top: -8rpx; right: -8rpx; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(0,0,0,0.65); color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
}
.ref-add {
  height: 140rpx; border-radius: 12rpx; border: 2rpx dashed var(--line);
  display: flex; align-items: center; justify-content: center;
}
.empty { text-align: center; padding: 30rpx 0 10rpx; font-size: 24rpx; }

/* 文件已选 chip（音频 / 视频） */
.file-chip {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 24rpx; border-radius: 16rpx;
  background: var(--surface-muted); border: 1rpx solid var(--line);
}
.file-name { flex: 1; font-size: 25rpx; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.up-clear-inline { flex: none; font-size: 23rpx; color: var(--primary); padding: 8rpx 20rpx; border: 1rpx solid var(--primary); border-radius: 10rpx; }

/* open 玩法：多个参考视频 chip 之间与上传框留距 */
.file-chip + .file-chip { margin-top: 12rpx; }
.file-chip + .upbox { margin-top: 12rpx; }

/* ===== 口播批量 ===== */
.batch-sel { margin-top: 16rpx; display: flex; flex-direction: column; gap: 10rpx; }
.batch-sel-item {
  display: flex; align-items: center; gap: 14rpx;
  padding: 12rpx 16rpx; border-radius: 12rpx;
  background: var(--surface-muted); border: 1rpx solid var(--line);
}
.batch-sel-img { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--surface); flex: none; }
.batch-sel-name { flex: 1; font-size: 24rpx; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.batch-job { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.batch-job:last-child { border-bottom: none; }
.batch-job-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 8rpx; }
.batch-job-name { font-size: 25rpx; font-weight: 600; color: var(--text); }
.batch-job-status { font-size: 22rpx; color: var(--text-muted); }
.batch-job-status.ok { color: #2bd576; }
.batch-job-status.err { color: #ff5c8a; }

.bottom-safe { height: calc(40rpx + constant(safe-area-inset-bottom)); height: calc(40rpx + env(safe-area-inset-bottom)); }
