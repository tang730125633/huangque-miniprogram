<view class="container">

  <!-- 头部：标题 + 点数 + 当前模式 -->
  <view class="vhead">
    <view class="vhead-top">
      <text class="vhead-title">视频创作</text>
      <view class="pts"><image class="pts-ic" src="../../assets/icons/coin.svg"></image><text>{{points === null ? '—' : points + ' 点'}}</text></view>
    </view>
    <view class="vhead-mode muted">当前模式 · {{modeName}}</view>
  </view>

  <!-- 模式选择器（横向卡片）-->
  <scroll-view class="mode-bar" scroll-x enable-flex show-scrollbar="{{false}}">
    <view wx:for="{{modes}}" wx:key="key" class="mode-card {{mode===item.key?'on':''}}"
      data-k="{{item.key}}" bindtap="selectMode">
      <view class="mode-name">{{item.name}}</view>
      <view class="mode-desc">{{item.desc}}</view>
    </view>
  </scroll-view>

  <view class="draft-bar">
    <text>{{draftStatus || '未提交内容自动保存在本机'}}</text>
    <view class="draft-clear" bindtap="clearCurrentDraft">清空当前草稿</view>
  </view>

  <!-- ===== 模式：电影化身（motion 单人 / duo 双人 / open 开放式）===== -->
  <block wx:if="{{mode==='cinematic'}}">
    <view class="card">
      <view class="label">玩法</view>
      <view class="eng-grid">
        <view wx:for="{{cineModes}}" wx:key="k" class="eng {{cineMode===item.k?'active':''}}"
          data-k="{{item.k}}" bindtap="selectCineMode">
          <view class="eng-name">{{item.name}}</view>
          <view class="eng-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="label">我的形象
        <text class="muted small">{{cineMode==='motion' ? '（选 1 个）' : (cineMode==='duo' ? '（正好选 2 个）' : '（选 1~3 个）')}}</text>
      </view>
      <view class="avatar-grid">
        <view wx:for="{{avatars}}" wx:key="id" class="avatar-cell {{avatarSelMap[item.id]?'on':''}}"
          data-id="{{item.id}}" bindtap="selectAvatar">
          <image wx:if="{{item.image}}" class="avatar-img" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:else class="avatar-img avatar-ph"></view>
          <view class="avatar-name">{{item.name}}</view>
          <view class="avatar-manage" data-id="{{item.id}}" catchtap="manageAvatar">管理</view>
        </view>
        <view class="avatar-cell avatar-add {{avatarBusy || pricingChecking || !pricingReady ? 'disabled' : ''}}" bindtap="createAvatar">
          <view class="avatar-add-ico">＋</view>
          <view class="avatar-name">{{avatarBusy ? '创建中…' : (avatarCost ? '建形象 · ' + avatarCost + '点' : '价格加载中')}}</view>
        </view>
      </view>
      <view wx:if="{{avatarNote}}" class="muted small tip">{{avatarNote}}</view>
      <view wx:if="{{!avatars.length && !avatarBusy}}" class="muted small tip">还没有形象：点「建形象」上传一张清晰正脸照，约 25 秒建好</view>
    </view>

    <!-- motion/duo：正好 1 个参考动作视频，提示词后端写死 -->
    <view wx:if="{{cineMode!=='open'}}" class="card">
      <view class="label">参考动作视频 <text class="muted small">（≤120 秒 · 形象将照着它演）</text></view>
      <view wx:if="{{!cineVideoName}}" class="upbox" bindtap="chooseCineVideo">
        <image class="ic-up" src="../../assets/icons/upload.svg"></image>
        <text class="muted small">上传参考动作视频（mp4/mov）</text>
      </view>
      <view wx:else class="file-chip">
        <text class="file-name">{{cineVideoName}}</text>
        <view class="up-clear-inline" bindtap="clearCineVideo">✕ 清除</view>
      </view>
    </view>

    <!-- open：自写提示词 + 可选参考视频/参考图 -->
    <block wx:if="{{cineMode==='open'}}">
      <view class="card">
        <view class="label">画面描述 <text class="muted small">（≤2000 字 · 说清每个形象/素材怎么用）</text></view>
        <textarea class="prompt" placeholder="例如：两人在咖啡馆对坐聊天，镜头缓慢环绕，暖色调"
          placeholder-class="ph" value="{{cinePrompt}}" bindinput="onCinePrompt" maxlength="2000" auto-height show-confirm-bar="{{false}}"></textarea>
      </view>
      <view class="card">
        <view class="label">参考视频 <text class="muted small">（可选 · 最多 3 个 · ≤120 秒）</text></view>
        <view wx:for="{{cineRefVideos}}" wx:key="index" class="file-chip">
          <text class="file-name">{{item.name}}</text>
          <view class="up-clear-inline" data-i="{{index}}" catchtap="removeCineRefVideo">✕ 清除</view>
        </view>
        <view wx:if="{{cineRefVideos.length < 3}}" class="upbox" bindtap="chooseCineRefVideo">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          <text class="muted small">上传参考视频（mp4/mov）</text>
        </view>
      </view>
      <view class="card">
        <view class="label">参考图 <text class="muted small">（最多 {{9-avatarIds.length}} 张 · 点图片编号插入）</text></view>
        <view class="ref-grid">
          <view wx:for="{{cineRefPreviews}}" wx:key="*this" class="ref-cell">
            <image class="ref-img" src="{{item}}" mode="aspectFill"></image>
            <view class="ref-index" data-i="{{index}}" catchtap="insertCineRefMention">图片{{index + 1}}</view>
            <view class="ref-del" data-i="{{index}}" catchtap="removeCineRefImg">✕</view>
          </view>
          <view wx:if="{{cineRefPreviews.length + avatarIds.length < 9}}" class="ref-cell ref-add" bindtap="chooseCineRefImg">
            <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          </view>
        </view>
        <view class="muted small ref-help">点击图片编号可插入 @图片N；图片与形象合计最多 9 张</view>
      </view>
    </block>

    <view class="card">
      <view class="label">画面比例</view>
      <view class="ratio-grid">
        <view wx:for="{{ratios}}" wx:key="*this" class="chip {{ratio===item?'active':''}}" data-v="{{item}}" bindtap="selectRatio">{{item}}</view>
      </view>
    </view>
    <view wx:if="{{cineMode==='open'}}" class="card">
      <view class="label">分辨率</view>
      <view class="ratio-grid">
        <view wx:for="{{cineResList}}" wx:key="*this" class="chip {{cineRes===item?'active':''}}" data-v="{{item}}" bindtap="selectCineRes">{{item}}</view>
      </view>
    </view>
    <view wx:if="{{cineMode==='open'}}" class="card">
      <view class="label">时长
        <text class="muted small">（{{cineRate ? cineRate + ' 点/秒' : '实时计价'}} · 自适应跟随参考视频{{cineMode==='open' ? '，无参考视频按 10 秒' : ''}}）</text>
      </view>
      <view class="ratio-grid">
        <view wx:for="{{cineDurs}}" wx:key="v" class="chip {{cineDur===item.v?'active':''}}" data-v="{{item.v}}" bindtap="selectCineDur">{{item.name}}</view>
      </view>
    </view>
    <view wx:else class="card">
      <view class="label">输出参数</view>
      <view class="muted small">1080p · 自适应跟随参考视频时长</view>
    </view>

    <view class="btn-primary {{busy || pricingChecking || !pricingReady ? 'disabled' : ''}}" bindtap="submitCinematic">
      {{busy ? '生成中…' : (pricingChecking ? '正在确认价格…' : (pricingReady ? '生成电影化身视频（约 ' + cineEst + ' 点）' : '实时价格加载中…'))}}
    </view>
    <view class="note" style="color:{{noteColor}}">{{note || defaultHint}}</view>
  </block>

  <!-- ===== 模式 A：AI 视频生成 ===== -->
  <block wx:elif="{{mode==='generate'}}">
    <view class="card">
      <view class="label">视频引擎</view>
      <view class="eng-grid">
        <view wx:for="{{engines}}" wx:key="key" class="eng {{engine===item.key?'active':''}}"
          data-k="{{item.key}}" bindtap="selectEngine">
          <view class="eng-name">{{item.name}}</view>
          <view class="eng-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{engine==='grok'}}" class="card">
      <view class="label">操作方式</view>
      <view class="ratio-grid">
        <view class="chip {{grokOp==='generate'?'active':''}}" data-v="generate" bindtap="selectGrokOp">生成新视频</view>
        <view class="chip" data-v="edit" bindtap="selectGrokOp">编辑维护中</view>
      </view>
    </view>

    <!-- 果肉官方线（xAI）：模型 / 分辨率 / 时长，动态计价 -->
    <block wx:if="{{engine==='grok' && grokOp==='generate'}}">
      <view class="card">
        <view class="label">模型</view>
        <view class="seg">
          <view wx:for="{{grokModels}}" wx:key="k" class="seg-item {{grokModel===item.k?'on':''}}"
            data-k="{{item.k}}" bindtap="selectGrokModel">{{item.name}} · {{item.desc}}</view>
        </view>
      </view>
      <view class="card">
        <view class="label">分辨率 <text class="muted small">（参考图模式仅支持 720p）</text></view>
        <view class="ratio-grid">
          <view wx:for="{{grokResList}}" wx:key="*this" class="chip {{grokRes===item?'active':''}}" data-v="{{item}}" bindtap="selectGrokRes">{{item}}</view>
        </view>
      </view>
      <view class="card">
        <view class="label">时长 <text class="muted small">（最长 10 秒，按模型×分辨率×秒动态计价）</text></view>
        <view class="ratio-grid">
          <view wx:for="{{grokDurs}}" wx:key="*this" class="chip {{grokDur===item?'active':''}}" data-v="{{item}}" bindtap="selectGrokDur">{{item}} 秒</view>
        </view>
      </view>
    </block>

    <block wx:if="{{engine==='micro' || engine==='omni'}}">
      <view class="card">
        <view class="label">时长 <text class="muted small">（按后台实时单价计费）</text></view>
        <view class="ratio-grid">
          <view wx:for="{{officialDurations}}" wx:key="*this" class="chip {{officialDuration===item?'active':''}}"
            data-v="{{item}}" bindtap="selectOfficialDuration">{{item}} 秒</view>
        </view>
      </view>
      <view class="card">
        <view class="label">清晰度</view>
        <view class="ratio-grid">
          <view wx:for="{{officialResolutions}}" wx:key="*this" class="chip {{officialResolution===item?'active':''}}"
            data-v="{{item}}" bindtap="selectOfficialResolution">{{item}}</view>
        </view>
        <view class="muted small">{{engine==='micro' ? '黄豆视频官方标准模型 · 自动生成声音' : '欧米视频官方通道 · 720p 有声视频'}}</view>
      </view>
    </block>

    <block wx:if="{{engine==='sora'}}">
      <view class="card">
        <view class="label">模型</view>
        <view class="seg">
          <view wx:for="{{soraModels}}" wx:key="k" class="seg-item {{soraModel===item.k?'on':''}}"
            data-k="{{item.k}}" bindtap="selectSoraModel">{{item.name}} · {{item.desc}}</view>
        </view>
      </view>
      <view class="card">
        <view class="label">时长 <text class="muted small">（仅支持 4、8、12 秒）</text></view>
        <view class="ratio-grid">
          <view wx:for="{{soraDurations}}" wx:key="*this" class="chip {{soraDuration===item?'active':''}}"
            data-v="{{item}}" bindtap="selectSoraDuration">{{item}} 秒</view>
        </view>
      </view>
      <view class="card">
        <view class="label">清晰度 <text class="muted small">（Sora 2 仅 720p，Pro 最高 1080p）</text></view>
        <view class="ratio-grid">
          <view wx:for="{{soraResolutions}}" wx:key="*this" class="chip {{soraResolution===item?'active':''}}"
            data-v="{{item}}" bindtap="selectSoraResolution">{{item}}</view>
        </view>
        <view class="muted small">支持 1 张非真人参考图作为首帧；不得上传含真人脸的图片</view>
      </view>
    </block>

    <view wx:if="{{engine==='grok' && grokOp==='edit'}}" class="card">
      <view class="label">参考视频 <text class="muted small">（MP4 · 最长 8.7 秒 · 输出继承原时长和比例）</text></view>
      <view wx:if="{{!editVideoName}}" class="upbox" bindtap="chooseEditVideo">
        <image class="ic-up" src="../../assets/icons/upload.svg"></image>
        <text class="muted small">上传 MP4 参考视频</text>
      </view>
      <view wx:else class="up-preview">
        <text class="muted small">{{editVideoName}}</text>
        <view class="up-clear" bindtap="clearEditVideo">✕ 清除</view>
      </view>
    </view>

    <!-- 镜头模板：仅回填可编辑提示词，不会自动生成或扣点 -->
    <view wx:if="{{!(engine==='grok' && grokOp==='edit')}}" class="card prompt-helper">
      <view class="prompt-helper-head">
        <view>
          <view class="label helper-title">镜头模板润色</view>
          <view class="muted small helper-sub">选场景、填内容，自动补全镜头语言 · 免费</view>
        </view>
        <view wx:if="{{canUndoPrompt}}" class="prompt-undo" bindtap="undoVideoPromptTemplate">撤销</view>
      </view>
      <scroll-view class="prompt-template-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="prompt-template-row">
          <view wx:for="{{videoPromptTemplates}}" wx:key="key" data-k="{{item.key}}" bindtap="selectVideoPromptTemplate"
            class="prompt-template-chip {{videoPromptTemplateKey===item.key?'on':''}}">{{item.name}}</view>
        </view>
      </scroll-view>
      <view class="prompt-fields">
        <input class="prompt-field" value="{{videoTplSubject}}" data-key="videoTplSubject" bindinput="onVideoTemplateField" maxlength="50" placeholder="主体 / 产品" placeholder-class="ph" />
        <input class="prompt-field" value="{{videoTplScene}}" data-key="videoTplScene" bindinput="onVideoTemplateField" maxlength="60" placeholder="场景" placeholder-class="ph" />
        <input class="prompt-field" value="{{videoTplAction}}" data-key="videoTplAction" bindinput="onVideoTemplateField" maxlength="60" placeholder="动作 / 展示方式" placeholder-class="ph" />
        <input class="prompt-field" value="{{videoTplStyle}}" data-key="videoTplStyle" bindinput="onVideoTemplateField" maxlength="50" placeholder="视觉风格" placeholder-class="ph" />
      </view>
      <view class="prompt-apply" bindtap="applyVideoPromptTemplate">套用并润色</view>
    </view>

    <view class="card">
      <view class="label">画面描述 <text wx:if="{{!(engine==='grok' && grokOp==='edit')}}" class="muted small">（润色后仍可编辑）</text></view>
      <textarea class="prompt" placeholder="{{engine==='grok' && grokOp==='edit' ? '描述想怎么改这段视频，例如：把背景换成海边日落' : '描述你想要的视频画面，例如：秋天枫叶飘落，慢镜头，暖色调'}}"
        placeholder-class="ph" value="{{prompt}}" bindinput="onPrompt" maxlength="{{engine==='sora' ? 2000 : 1000}}" cursor="{{promptCursor}}" auto-height show-confirm-bar="{{false}}"></textarea>
      <view wx:if="{{promptMentionOpen}}" class="mention-menu">
        <view wx:for="{{refPreviews}}" wx:key="*this" class="mention-item" data-i="{{index}}" bindtap="selectPromptMention">
          <image src="{{item}}" mode="aspectFill"></image><text>图片{{index + 1}}</text><text class="mention-token">@图片{{index + 1}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{engineRef && !(engine==='grok' && grokOp==='edit')}}" class="card">
      <view class="label">参考图 <text class="muted small">{{engineRefHint}}</text></view>
      <view class="ref-grid">
        <view wx:for="{{refPreviews}}" wx:key="*this" class="ref-cell">
          <image class="ref-img" src="{{item}}" mode="aspectFill"></image>
          <view class="ref-index" data-i="{{index}}" catchtap="insertGenerateRefMention">图片{{index + 1}}</view>
          <view class="ref-del" data-i="{{index}}" catchtap="removeRef">✕</view>
        </view>
        <view wx:if="{{refPreviews.length < engineRefMax}}" class="ref-cell ref-add" bindtap="chooseRef">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
        </view>
      </view>
      <view class="muted small ref-help">输入 @ 可选择图片；点击图片编号也可插入 @图片N</view>
    </view>

    <view wx:if="{{!(engine==='grok' && grokOp==='edit')}}" class="card">
      <view class="label">画面比例</view>
      <view class="ratio-grid">
        <view wx:for="{{ratios}}" wx:key="*this" class="chip {{ratio===item?'active':''}}" data-v="{{item}}" bindtap="selectRatio">{{item}}</view>
      </view>
    </view>

    <view class="btn-primary {{busy || pricingChecking || !pricingReady || (engine==='grok' && grokOp==='edit') ? 'disabled' : ''}}" bindtap="submitGenerate">
      {{busy ? '生成中…' : (engine==='grok' && grokOp==='edit' ? '视频编辑维护中' : (pricingChecking ? '正在确认价格…' : (pricingReady ? '立即生成（' + cost + ' 点）' : '实时价格加载中…')))}}
    </view>
    <view class="note" style="color:{{noteColor}}">{{note || defaultHint}}</view>
    <view class="ai-disclosure">内容由人工智能生成，请遵守法律法规并自行核验后使用</view>
  </block>

  <!-- ===== 模式 B：数字化 IP ===== -->
  <block wx:elif="{{mode==='talking'}}">
    <!-- 单条：上传一张照片 -->
    <view wx:if="{{!talkBatch}}" class="card">
      <view class="label">人物形象 <text class="muted small">（上传一张正脸照片）</text></view>
      <view wx:if="{{!talkImgPreview}}" class="upbox" bindtap="chooseTalkImg">
        <image class="ic-up" src="../../assets/icons/upload.svg"></image>
        <text class="muted small">上传人物照片</text>
      </view>
      <view wx:else class="up-preview">
        <image class="up-img" src="{{talkImgPreview}}" mode="aspectFill"></image>
        <view class="up-clear" bindtap="clearTalkImg">✕ 清除</view>
      </view>
    </view>

    <!-- 批量：我的形象多选 + 上传照片，2~5 个，同一段文案各出一条 -->
    <view wx:if="{{talkBatch}}" class="card">
      <view class="label">批量形象 <text class="muted small">（已选 {{batchItems.length}}/5 · 至少 2 个）</text></view>
      <view wx:if="{{avatars.length}}" class="avatar-grid">
        <view wx:for="{{avatars}}" wx:key="id" class="avatar-cell {{batchSelMap[item.id]?'on':''}}"
          data-id="{{item.id}}" bindtap="toggleBatchAvatar">
          <image wx:if="{{item.image}}" class="avatar-img" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:else class="avatar-img avatar-ph"></view>
          <view class="avatar-name">{{item.name}}</view>
          <view class="avatar-manage" data-id="{{item.id}}" catchtap="manageAvatar">管理</view>
        </view>
        <view class="avatar-cell avatar-add" bindtap="addBatchImage">
          <view class="avatar-add-ico">＋</view>
          <view class="avatar-name">传照片</view>
        </view>
      </view>
      <view wx:else class="upbox" bindtap="addBatchImage">
        <image class="ic-up" src="../../assets/icons/upload.svg"></image>
        <text class="muted small">上传人物照片（可多张）</text>
      </view>
      <view wx:if="{{batchItems.length}}" class="batch-sel">
        <view wx:for="{{batchItems}}" wx:key="index" class="batch-sel-item">
          <image wx:if="{{item.preview}}" class="batch-sel-img" src="{{item.preview}}" mode="aspectFill"></image>
          <text class="batch-sel-name">{{item.label}}</text>
          <view class="up-clear-inline" data-i="{{index}}" catchtap="removeBatchItem">✕</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!talkBatch}}" class="card">
      <view class="label">口播来源</view>
      <view class="seg">
        <view class="seg-item {{talkMode==='text'?'on':''}}" data-k="text" bindtap="selectTalkMode">文案 + 音色</view>
        <view class="seg-item {{talkMode==='audio'?'on':''}}" data-k="audio" bindtap="selectTalkMode">上传音频</view>
      </view>
    </view>

    <block wx:if="{{talkMode==='text'}}">
      <view class="card">
        <view class="label">口播文案</view>
        <textarea class="prompt" placeholder="输入口播文案，将按所选音色朗读"
          placeholder-class="ph" value="{{talkText}}" bindinput="onTalkText" maxlength="1000" auto-height show-confirm-bar="{{false}}"></textarea>
      </view>
      <view class="card">
        <view class="label-row">
          <view class="label">音色 <text class="muted small">（公共 / 个人克隆）</text></view>
          <view class="clone-link" bindtap="goClone">去复刻音色</view>
        </view>
        <view wx:if="{{voices.length}}" class="voice-grid">
          <view wx:for="{{voices}}" wx:key="key" class="voice-card {{voiceKey===item.key?'on':''}}" data-k="{{item.key}}" bindtap="selectVoice">
            <view class="voice-name">{{item.name}}</view>
            <view class="voice-sub">{{item.scope==='personal' ? '个人克隆' : '公共音色'}}</view>
            <view class="voice-play" catchtap="playVoice" data-url="{{item.preview}}"><image class="ic-pp-xs" src="../../assets/icons/play_pink.svg"></image></view>
          </view>
        </view>
        <view wx:else class="empty muted">暂无可用音色，可在「声音克隆」创建个人音色</view>
      </view>
    </block>

    <block wx:else>
      <view class="card">
        <view class="label">口播音频 <text class="muted small">（mp3 / wav / m4a）</text></view>
        <view wx:if="{{!talkAudioName}}" class="upbox" bindtap="chooseTalkAudio">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          <text class="muted small">从聊天文件选择音频</text>
        </view>
        <view wx:else class="file-chip">
          <text class="file-name">{{talkAudioName}}</text>
          <view class="up-clear-inline" bindtap="chooseTalkAudio">重选</view>
        </view>
      </view>
    </block>

    <view class="card">
      <view class="label">分辨率</view>
      <view class="ratio-grid">
        <view wx:for="{{resList}}" wx:key="*this" class="chip {{talkRes===item?'active':''}}" data-v="{{item}}" bindtap="selectTalkRes">{{item}}</view>
      </view>
    </view>
    <view class="card">
      <view class="label">画面比例</view>
      <view class="ratio-grid">
        <view wx:for="{{ratios}}" wx:key="*this" class="chip {{ratio===item?'active':''}}" data-v="{{item}}" bindtap="selectRatio">{{item}}</view>
      </view>
    </view>

    <view class="btn-primary {{busy || pricingChecking || !pricingReady ? 'disabled' : ''}}" bindtap="submitTalking">
      {{busy ? '生成中…' : (pricingChecking ? '正在确认价格…' : (pricingReady ? (talkBatch ? '批量生成 ' + batchItems.length + ' 条（约 ' + batchItems.length * cost + ' 点）' : '生成口播视频（' + cost + ' 点）') : '实时价格加载中…'))}}
    </view>
    <view class="note" style="color:{{noteColor}}">{{note || defaultHint}}</view>

    <!-- 批量任务进度 -->
    <view wx:if="{{batchJobs.length}}" class="card">
      <view class="label">批量进度</view>
      <view wx:for="{{batchJobs}}" wx:key="jobId" class="batch-job">
        <view class="batch-job-head">
          <text class="batch-job-name">{{item.label}}</text>
          <text class="batch-job-status {{item.status==='done'?'ok':(item.status==='failed'?'err':'')}}">{{item.statusText}}</text>
        </view>
        <block wx:if="{{item.status==='done' && item.url}}">
          <video class="result-video" src="{{item.url}}" controls object-fit="contain" show-center-play-btn></video>
          <view class="result-actions">
            <view class="ghost-btn" data-url="{{item.url}}" bindtap="saveBatchVideo">保存到相册</view>
          </view>
        </block>
      </view>
    </view>
  </block>

  <!-- 老「动作模仿」已随后端 #620 下线，统一并入「电影化身」 -->

  <!-- ===== 模式 D：换装 / 换背景 ===== -->
  <block wx:elif="{{mode==='tryon'}}">
    <view class="card">
      <view class="label">换装类型</view>
      <view class="seg">
        <view wx:for="{{tryonTypes}}" wx:key="key" class="seg-item {{tryonType===item.key?'on':''}}" data-k="{{item.key}}" bindtap="selectTryonType">{{item.name}}</view>
      </view>
    </view>

    <!-- 视频换装：人物视频 + 衣服图 -->
    <block wx:if="{{tryonType==='video_clothes'}}">
      <view class="card">
        <view class="label">人物视频 <text class="muted small">（≤15 秒）</text></view>
        <view wx:if="{{!tryonPersonVideo}}" class="upbox" bindtap="chooseTryonPersonVideo">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          <text class="muted small">上传人物视频</text>
        </view>
        <view wx:else class="file-chip">
          <text class="file-name">{{tryonPersonVideoName}}</text>
          <view class="up-clear-inline" bindtap="clearTryonPersonVideo">✕ 清除</view>
        </view>
      </view>
      <view class="card">
        <view class="label">衣服图</view>
        <view wx:if="{{!tryonClothesPreview}}" class="upbox" bindtap="chooseTryonClothes">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          <text class="muted small">上传衣服图</text>
        </view>
        <view wx:else class="up-preview">
          <image class="up-img" src="{{tryonClothesPreview}}" mode="aspectFill"></image>
          <view class="up-clear" bindtap="clearTryonClothes">✕ 清除</view>
        </view>
      </view>
    </block>

    <!-- 视频换背景：人物视频 + 背景图 -->
    <block wx:else>
      <view class="card">
        <view class="label">人物视频 <text class="muted small">（≤15 秒）</text></view>
        <view wx:if="{{!tryonPersonVideo}}" class="upbox" bindtap="chooseTryonPersonVideo">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          <text class="muted small">上传人物视频</text>
        </view>
        <view wx:else class="file-chip">
          <text class="file-name">{{tryonPersonVideoName}}</text>
          <view class="up-clear-inline" bindtap="clearTryonPersonVideo">✕ 清除</view>
        </view>
      </view>
      <view class="card">
        <view class="label">背景图</view>
        <view wx:if="{{!tryonBgPreview}}" class="upbox" bindtap="chooseTryonBg">
          <image class="ic-up" src="../../assets/icons/upload.svg"></image>
          <text class="muted small">上传背景图</text>
        </view>
        <view wx:else class="up-preview">
          <image class="up-img" src="{{tryonBgPreview}}" mode="aspectFill"></image>
          <view class="up-clear" bindtap="clearTryonBg">✕ 清除</view>
        </view>
      </view>
    </block>

    <view class="btn-primary {{busy || pricingChecking || !pricingReady ? 'disabled' : ''}}" bindtap="submitTryon">
      {{busy ? '生成中…' : (pricingChecking ? '正在确认价格…' : (pricingReady ? '生成换装视频（' + cost + ' 点）' : '实时价格加载中…'))}}
    </view>
    <view class="note" style="color:{{noteColor}}">{{note || defaultHint}}</view>
  </block>

  <!-- 共享：生成结果 -->
  <view wx:if="{{videoUrl}}" class="card">
    <view class="label">生成结果 <text class="ai-badge">AI 生成</text></view>
    <video class="result-video" src="{{videoUrl}}" controls object-fit="contain" show-center-play-btn></video>
    <view class="result-actions">
      <view class="ghost-btn" bindtap="saveVideo">保存到相册</view>
      <view class="ghost-btn" bindtap="previewVideo">全屏播放</view>
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>

<view wx:if="{{talkAudioConsentVisible}}" class="audio-consent-mask">
  <view class="audio-consent-dialog" aria-role="dialog" aria-label="口播音频声纹授权申请">
    <view class="audio-consent-app">
      <view class="audio-consent-icon"><image src="../../assets/icons/mic.svg"></image></view>
      <text>黄雀智创 申请</text>
    </view>
    <view class="audio-consent-title">使用以下声音信息</view>
    <view class="audio-consent-scope">
      <text>口播音频与必要声音特征</text>
      <text class="audio-consent-scope-ok">✓</text>
    </view>
    <view class="audio-consent-copy">你选择的口播音频将被上传，用于分析必要的声音特征、驱动人物口型并生成数字化 IP 视频。拒绝授权不影响其他功能。</view>
    <navigator class="audio-consent-link" url="/pages/legal/legal?type=voiceprint">查看完整《声纹授权协议》</navigator>
    <checkbox-group bindchange="onTalkAudioConsentChange">
      <label class="audio-consent-check">
        <checkbox value="agreed" checked="{{talkAudioConsentChecked}}" color="#e24ba0"></checkbox>
        <text>我已阅读并单独同意《声纹授权协议》</text>
      </label>
    </checkbox-group>
    <view class="audio-consent-actions">
      <view class="audio-consent-cancel" bindtap="cancelTalkAudioConsent">不同意</view>
      <view class="audio-consent-confirm {{talkAudioConsentChecked?'':'disabled'}}" bindtap="confirmTalkAudioConsent">同意并选择音频</view>
    </view>
  </view>
</view>
