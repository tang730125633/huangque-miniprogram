.recharge-page { padding-bottom: 80rpx; }
.balance-card {
  margin-top: 18rpx; padding: 44rpx 36rpx; text-align: center; border-radius: 28rpx;
  background: radial-gradient(circle at 50% 10%, rgba(226,75,160,0.26), transparent 54%), linear-gradient(145deg, #211231, #15101f);
  border: 1rpx solid rgba(226,75,160,0.36); box-shadow: 0 20rpx 55rpx rgba(0,0,0,0.25);
}
.balance-label { color: var(--text-muted); font-size: 24rpx; }
.balance-value { margin: 10rpx 0 8rpx; color: var(--secondary); font-size: 76rpx; line-height: 1.15; font-weight: 700; }
.balance-note { color: #c9c2d8; font-size: 22rpx; }
.sandbox-tip, .status-tip { margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 14rpx; text-align: center; font-size: 22rpx; }
.sandbox-tip { color: #ffe2a4; background: rgba(240,165,75,0.13); border: 1rpx solid rgba(240,165,75,0.32); }
.status-tip { color: #ffd8ee; background: rgba(226,75,160,0.12); }
.section-heading { margin: 36rpx 2rpx 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.section-heading .section-title { margin: 0; }
.section-title { margin: 36rpx 2rpx 18rpx; font-size: 29rpx; font-weight: 650; }
.discount-chip { padding: 8rpx 16rpx; border-radius: 999rpx; color: #ffd7a0; background: rgba(240,165,75,0.13); border: 1rpx solid rgba(240,165,75,0.3); font-size: 20rpx; white-space: nowrap; }
.empty-state { padding: 50rpx 28rpx; text-align: center; }
.empty-title { margin-bottom: 12rpx; font-size: 30rpx; color: var(--text); }
.package-list { display: flex; flex-direction: column; gap: 18rpx; }
.package-card {
  position: relative; display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 26rpx; border-radius: 22rpx; background: var(--surface); border: 1rpx solid var(--line); overflow: hidden;
}
.package-card.recommended { border-color: rgba(226,75,160,0.72); background: linear-gradient(105deg, rgba(226,75,160,0.17), #17131f 48%); }
.recommend-badge { position: absolute; top: 0; right: 0; padding: 7rpx 18rpx; border-radius: 0 0 0 14rpx; color: #fff; background: var(--primary); font-size: 19rpx; }
.package-points { color: var(--secondary); font-size: 43rpx; font-weight: 700; }
.package-points text { font-size: 24rpx; font-weight: 500; }
.package-title { margin-top: 5rpx; color: var(--text-muted); font-size: 22rpx; }
.package-price { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.original-price { color: var(--text-muted); font-size: 20rpx; text-decoration: line-through; }
.pay-button { min-width: 146rpx; padding: 21rpx 22rpx; border-radius: 999rpx; text-align: center; color: #fff; background: var(--grad); font-size: 29rpx; font-weight: 650; }
.pay-button.disabled { opacity: 0.48; }
.custom-card {
  padding: 28rpx 26rpx; border-radius: 22rpx; background: var(--surface); border: 1rpx solid var(--line);
}
.custom-copy { margin-bottom: 22rpx; }
.custom-title { margin-bottom: 8rpx; font-size: 28rpx; font-weight: 600; }
.custom-row { display: flex; align-items: center; gap: 18rpx; }
.amount-input-wrap {
  flex: 1; min-width: 0; height: 76rpx; display: flex; align-items: center; padding: 0 22rpx;
  border-radius: 18rpx; background: var(--surface-muted); border: 1rpx solid var(--line);
}
.currency { margin-right: 10rpx; color: var(--secondary); font-size: 30rpx; font-weight: 700; }
.amount-input { flex: 1; min-width: 0; color: var(--text); font-size: 30rpx; }
.custom-pay-button { min-width: 170rpx; box-sizing: border-box; }
.custom-preview { margin-top: 18rpx; color: var(--text-muted); font-size: 21rpx; }
.custom-preview.active { color: var(--secondary); }
.safe-note { margin: 28rpx 8rpx 0; text-align: center; color: var(--text-muted); font-size: 20rpx; line-height: 1.75; }
.history-wrap { margin-top: 28rpx; }
.order-card { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 26rpx; margin-bottom: 14rpx; }
.order-points { font-size: 28rpx; font-weight: 600; }
.order-time { margin-top: 7rpx; font-size: 19rpx; }
.order-status { padding: 8rpx 15rpx; border-radius: 999rpx; font-size: 20rpx; color: var(--text-muted); background: var(--surface-muted); }
.order-status.credited { color: #9cf1bd; background: rgba(43,213,118,0.13); }
.order-status.failed { color: #ffb6cb; background: rgba(255,92,138,0.13); }
