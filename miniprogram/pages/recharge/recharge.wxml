<view class="container recharge-page">
  <view class="balance-card">
    <view class="balance-label">当前点数</view>
    <view class="balance-value">{{points === null ? '—' : points}}</view>
    <view class="balance-note">微信官方虚拟支付 · 到账后可用于所有生成任务</view>
  </view>

  <view wx:if="{{statusText}}" class="status-tip">{{statusText}}</view>

  <view class="section-heading">
    <view class="section-title">{{membershipActive ? '选择充值档位' : '开通会员'}}</view>
    <view wx:if="{{membershipActive}}" class="discount-chip">{{membershipName}} · {{discountLabel}}</view>
  </view>
  <view wx:if="{{contactAdmin}}" class="status-tip">合伙人、发起人续费请联系管理员。</view>
  <view wx:if="{{loading}}" class="card empty-state">正在加载充值配置…</view>
  <view wx:elif="{{!configured}}" class="card empty-state">
    <view class="empty-title">充值功能配置中</view>
    <view class="muted small">微信支付配置完成后即可使用</view>
  </view>
  <view wx:else class="package-list">
    <view wx:for="{{packages}}" wx:key="id" class="package-card {{item.recommended ? 'recommended' : ''}}">
      <view wx:if="{{item.recommended}}" class="recommend-badge">推荐</view>
      <view class="package-main">
        <view class="package-points">{{item.membership_renewal ? '会员续费' : item.points}}<text wx:if="{{!item.membership_renewal}}"> 点</text></view>
        <view class="package-title">{{item.title}}{{item.benefit ? (' · ' + item.benefit) : ''}}</view>
      </view>
      <view class="package-price">
        <view wx:if="{{item.show_discount}}" class="original-price">原价 ¥{{item.list_price_yuan}}</view>
        <view class="pay-button {{payingId ? 'disabled' : ''}}" data-id="{{item.id}}" data-amount="{{item.amount}}" bindtap="startPay">
          <text wx:if="{{payingId === item.id}}">处理中…</text>
          <text wx:else>实付 ¥{{item.price_yuan}}</text>
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{configured && membershipActive && custom}}">
    <view class="section-title">自定义充值</view>
    <view class="custom-card">
      <view class="custom-copy">
        <view class="custom-title">按实际需要充值</view>
        <view class="muted small">输入原价额度，按{{discountLabel}}结算 · 1 元额度 = {{custom.points_per_yuan}} 点</view>
      </view>
      <view class="custom-row">
        <view class="amount-input-wrap">
          <text class="currency">¥</text>
          <input
            class="amount-input"
            type="number"
            maxlength="4"
            value="{{customAmount}}"
            placeholder="输入金额"
            bindinput="onCustomAmountInput"
          />
        </view>
        <view
          class="pay-button custom-pay-button {{(!customValid || payingId) ? 'disabled' : ''}}"
          bindtap="startCustomPay"
        >
          <text wx:if="{{payingId === custom.package_id}}">处理中…</text>
          <text wx:else>立即充值</text>
        </view>
      </view>
      <view class="custom-preview {{customValid ? 'active' : ''}}">
        <block wx:if="{{customValid}}">
          预计到账 {{customPoints}} 点 · <text wx:if="{{hasDiscount}}">原价 ¥{{customAmount}} · </text>实付 ¥{{customPayAmount}}
        </block>
        <block wx:else>输入额度后自动计算折后实付金额</block>
      </view>
    </view>
  </block>

  <view class="safe-note">
    <view>点数充值由微信官方虚拟支付提供</view>
    <view>支付完成后由服务器核验订单并自动发放点数</view>
  </view>

  <view wx:if="{{orders.length}}" class="history-wrap">
    <view class="section-title">充值记录</view>
    <view class="card order-card" wx:for="{{orders}}" wx:key="order_id">
      <view>
        <view class="order-points">{{item.points}} 点</view>
        <view class="muted order-time">{{item.time_label}} · ¥{{item.amount_yuan}}</view>
      </view>
      <view class="order-status {{item.status}}">{{item.status_label}}</view>
    </view>
  </view>
</view>
